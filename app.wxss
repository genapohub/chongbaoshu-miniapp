/**
 * 宠宝树V1.0 全局样式
 * 设计规范：主色#E94560, 页面底色#F8F9FA, 卡片#FFF圆角8px
 */

/* 全局 */
page {
  background-color: #F8F9FA;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  font-size: 28rpx;
  color: #333333;
  line-height: 1.6;
}

/* 容器 */
.container {
  padding: 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

/* 卡片 */
.card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

/* 主按钮 */
.btn-primary {
  background-color: #E94560;
  color: #FFFFFF;
  border-radius: 12rpx;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  padding: 24rpx 0;
  border: none;
}

.btn-primary::after {
  border: none;
}

.btn-primary:active {
  opacity: 0.85;
}

/* 次要按钮 */
.btn-secondary {
  background-color: #FFFFFF;
  color: #E94560;
  border: 2rpx solid #E94560;
  border-radius: 12rpx;
  font-size: 28rpx;
  text-align: center;
  padding: 20rpx 0;
}

.btn-secondary::after {
  border: none;
}

/* 危险按钮 */
.btn-danger {
  background-color: #FF6B6B;
  color: #FFFFFF;
  border-radius: 12rpx;
  font-size: 28rpx;
  text-align: center;
  padding: 20rpx 0;
  border: none;
}

.btn-danger::after {
  border: none;
}

/* 输入框 */
.input-field {
  background: #F8F9FA;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  border: 2rpx solid transparent;
  transition: border-color 0.2s;
}

.input-field:focus {
  border-color: #E94560;
}

/* 标签 */
.tag {
  display: inline-block;
  background: #FFF0F3;
  color: #E94560;
  border-radius: 8rpx;
  padding: 6rpx 16rpx;
  font-size: 24rpx;
  margin-right: 12rpx;
  margin-bottom: 12rpx;
}

/* 状态标签 */
.status-active {
  background: #E8F8F0;
  color: #00B894;
}

.status-breeding {
  background: #FFF8E1;
  color: #FDCB6E;
}

.status-pregnant {
  background: #FFF0F3;
  color: #E94560;
}

.status-retired {
  background: #F0F0F0;
  color: #999999;
}

/* 分割线 */
.divider {
  height: 1rpx;
  background: #EEEEEE;
  margin: 24rpx 0;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-state .empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}

.empty-state .empty-text {
  font-size: 28rpx;
  color: #999999;
  margin-bottom: 32rpx;
}

/* FAB 浮动按钮 */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: 140rpx;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #E94560;
  color: #FFFFFF;
  font-size: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(233, 69, 96, 0.4);
  z-index: 100;
}

.fab:active {
  transform: scale(0.95);
}

/* 通用 flex */
.flex-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.flex-between {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 文字省略 */
.ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ellipsis-2 {
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

/* 安全区域 */
.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}
