/* ══════════════════════════════════════════════
   宠宝树 — 暖森林色系 · 简约品牌风格
   ══════════════════════════════════════════════ */

page {
  --green:      #4A8C5C;
  --green-light:#6F9E7C;
  --amber:      #D4914A;
  --red:        #D4534A;
  --bg:         #F6F4F0;
  --surface:    #FFFFFF;
  --text:       #2D2A26;
  --text2:      #5E5953;
  --text3:      #948F89;
  --line:       #E8E5E0;
  --radius:     12rpx;
  --shadow:     0 2rpx 12rpx rgba(0,0,0,0.05);

  background: var(--bg);
  font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', sans-serif;
  font-size: 28rpx;
  color: var(--text);
  line-height: 1.6;
}

/* ── 容器 ── */
.container {
  padding: 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  min-height: 100vh;
  background: var(--bg);
}

/* ── 卡片 ── */
.card {
  background: var(--surface);
  border-radius: var(--radius);
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow);
}
.card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 20rpx;
}
.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

/* ── 按钮 ── */
.btn-primary {
  background: var(--green);
  color: #fff;
  border-radius: var(--radius);
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  padding: 24rpx 0;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
}
.btn-primary::after { border: none; }
.btn-primary:active { opacity: 0.85; }
.btn-primary.disabled,
.btn-primary[disabled] { opacity: 0.4; pointer-events: none; }

.btn-secondary {
  background: var(--bg);
  color: var(--text2);
  border-radius: var(--radius);
  font-size: 28rpx;
  text-align: center;
  padding: 20rpx 0;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}
.btn-secondary::after { border: none; }

.btn-danger {
  background: var(--red);
  color: #fff;
  border-radius: var(--radius);
  font-size: 28rpx;
  text-align: center;
  padding: 20rpx 0;
  border: none;
}
.btn-danger::after { border: none; }
.btn-danger:active { opacity: 0.85; }

/* ── 表单 ── */
.form-item {
  margin-bottom: 24rpx;
}
.form-item:last-child { margin-bottom: 0; }

.form-label {
  display: block;
  font-size: 26rpx;
  color: var(--text2);
  margin-bottom: 10rpx;
}

.input-field {
  background: var(--bg);
  border-radius: var(--radius);
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  border: 2rpx solid transparent;
  color: var(--text);
  width: 100%;
  box-sizing: border-box;
}
.input-field:focus { border-color: var(--green); background: var(--surface); }
.input-field::placeholder { color: var(--text3); }

.picker-wrap {
  display: flex; align-items: center; justify-content: space-between;
  background: var(--bg); border-radius: var(--radius);
  padding: 20rpx 24rpx; font-size: 28rpx;
  border: 2rpx solid transparent;
}
.picker-wrap:active { border-color: var(--green); }
.picker-value { color: var(--text); flex: 1; }
.picker-value.placeholder { color: var(--text3); }

/* ── 列表/菜单 ── */
.menu-list {
  background: var(--surface);
  border-radius: var(--radius);
  overflow: hidden;
  margin-bottom: 20rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  background: var(--surface);
  transition: background 0.15s;
}
.menu-item:active { background: var(--bg); }

.menu-item + .menu-item::before {
  content: ''; position: absolute; top: 0; left: 96rpx; right: 24rpx;
  height: 1rpx; background: var(--line);
}

.menu-text { flex: 1; font-size: 30rpx; color: var(--text); margin-left: 24rpx; }
.menu-tag  { font-size: 22rpx; color: var(--amber); }

/* ── 标签 ── */
.tag {
  display: inline-flex; align-items: center;
  padding: 6rpx 16rpx; border-radius: 6rpx;
  font-size: 22rpx; font-weight: 500;
  margin-right: 10rpx; margin-bottom: 10rpx;
}
.tag--success { background: #EDF4EF; color: var(--green); }
.tag--warning { background: #FFF4E5; color: var(--amber); }
.tag--danger  { background: #FDEDEC; color: var(--red); }
.tag--gray    { background: var(--bg);  color: var(--text3); }

/* ── FAB 浮动按钮 ── */
.fab {
  position: fixed;
  right: 32rpx; bottom: 120rpx;
  width: 96rpx; height: 96rpx;
  border-radius: 50%;
  background: var(--green);
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(74,140,92,0.35);
}

/* ── 空状态 ── */
.empty-state {
  display: flex; flex-direction: column; align-items: center;
  padding-top: 180rpx;
}
.empty-text { font-size: 30rpx; color: var(--text3); margin-top: 20rpx; }
.empty-desc { font-size: 26rpx; color: #C0C4CC; margin-top: 8rpx; }

/* ── 加载状态 ── */
.loading-state {
  display: flex; align-items: center; justify-content: center;
  padding: 100rpx 0;
  color: var(--text3); font-size: 26rpx;
}

/* ── 简单淡入动画 ── */
@keyframes fadeIn {
  from { opacity: 0; }
  to   { opacity: 1; }
}
