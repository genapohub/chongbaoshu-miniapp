/* ══════════════════════════════════════════════
   宠宝树 — 暖森林 · 毛玻璃 · 比例系统
   ══════════════════════════════════════════════ */

page {
  /* 主色 */
  --green:      #4A8C5C;
  --green-dark: #3D7A4D;
  --green-deep: #2A5E38;
  --green-light:#EDF4EF;
  --amber:      #D4914A;
  --red:        #D4534A;
  --red-light:  #FDEDEC;

  /* 中性 */
  --bg:         #F6F4F0;
  --surface:    rgba(255,255,255,0.82);
  --surface-solid: #FFFFFF;
  --text:       #2D2A26;
  --text2:      #5E5953;
  --text3:      #948F89;
  --line:       rgba(0,0,0,0.06);

  /* 形状 */
  --radius-sm:  10rpx;
  --radius:     16rpx;
  --radius-lg:  24rpx;
  --radius-full: 9999rpx;

  /* 阴影 — 三层 */
  --shadow-sm:  0 1rpx 4rpx rgba(0,0,0,0.04);
  --shadow:     0 2rpx 16rpx rgba(0,0,0,0.06);
  --shadow-lg:  0 8rpx 32rpx rgba(0,0,0,0.10);
  --shadow-brand: 0 4rpx 20rpx rgba(74,140,92,0.22);

  /* 间距比例 */
  --sp-xs: 8rpx;
  --sp-sm: 16rpx;
  --sp-md: 24rpx;
  --sp-lg: 32rpx;
  --sp-xl: 48rpx;

  --glass: saturate(180%) blur(20px);
  -webkit-backdrop-filter: var(--glass);
  backdrop-filter: var(--glass);

  background: var(--bg);
  font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', sans-serif;
  font-size: 28rpx;
  color: var(--text);
  line-height: 1.7;
}

/* ── 容器 ── */
.container {
  padding: var(--sp-lg);
  padding-bottom: calc(var(--sp-lg) + env(safe-area-inset-bottom));
  min-height: 100vh;
  background: var(--bg);
}

/* ── 卡片 ── */
.card {
  background: var(--surface);
  border-radius: var(--radius);
  padding: var(--sp-lg);
  margin-bottom: var(--sp-md);
  box-shadow: var(--shadow);
  -webkit-backdrop-filter: var(--glass);
  backdrop-filter: var(--glass);
}
.card--compact { padding: var(--sp-md); }
.card--airy    { padding: 36rpx; margin-bottom: var(--sp-lg); }
.card--elevated { box-shadow: var(--shadow-lg); }

.card-title {
  font-size: 28rpx; font-weight: 600;
  color: var(--text); margin-bottom: var(--sp-md);
  letter-spacing: 0.3rpx;
}
.card-header {
  display: flex; align-items: center; justify-content: space-between;
  margin-bottom: var(--sp-md);
}

/* ── 标题层级 ── */
.h1 { font-size: 36rpx; font-weight: 700; color: var(--text); }
.h2 { font-size: 30rpx; font-weight: 600; color: var(--text); }
.h3 { font-size: 28rpx; font-weight: 600; color: var(--text); }
.caption { font-size: 24rpx; color: var(--text3); }
.small  { font-size: 22rpx; color: var(--text3); }

/* ── 按钮 ── */
.btn-primary {
  background: var(--green); color: #fff;
  border-radius: var(--radius-full); font-size: 30rpx; font-weight: 600;
  text-align: center; padding: 26rpx 0; border: none;
  display: flex; align-items: center; justify-content: center; gap: 10rpx;
  box-shadow: var(--shadow-brand);
}
.btn-primary::after { border: none; }
.btn-primary:active { opacity: 0.88; transform: scale(0.98); }
.btn-primary.disabled,
.btn-primary[disabled] { opacity: 0.4; pointer-events: none; box-shadow: none; }

.btn-secondary {
  background: rgba(0,0,0,0.04); color: var(--text2);
  border-radius: var(--radius-full); font-size: 28rpx;
  text-align: center; padding: 22rpx 0; border: none;
  display: flex; align-items: center; justify-content: center; gap: 8rpx;
}
.btn-secondary::after { border: none; }

.btn-danger {
  background: var(--red); color: #fff;
  border-radius: var(--radius-full); font-size: 28rpx;
  text-align: center; padding: 22rpx 0; border: none;
}
.btn-danger::after { border: none; }

/* ── 表单 ── */
.form-item { margin-bottom: 28rpx; }
.form-item:last-child { margin-bottom: 0; }
.form-label { display: block; font-size: 26rpx; color: var(--text2); margin-bottom: 12rpx; font-weight: 500; }
.input-field {
  background: rgba(0,0,0,0.03); border-radius: var(--radius-sm);
  padding: 22rpx 24rpx; font-size: 28rpx; border: 2rpx solid transparent;
  color: var(--text); width: 100%; box-sizing: border-box;
}
.input-field:focus { border-color: var(--green); background: rgba(74,140,92,0.04); }
.input-field::placeholder { color: var(--text3); }

.picker-wrap {
  display: flex; align-items: center; justify-content: space-between;
  background: rgba(0,0,0,0.03); border-radius: var(--radius-sm);
  padding: 22rpx 24rpx; font-size: 28rpx; border: 2rpx solid transparent;
}
.picker-wrap:active { border-color: var(--green); }
.picker-value { color: var(--text); flex: 1; }
.picker-value.placeholder { color: var(--text3); }

/* ── 菜单 ── */
.menu-list {
  background: var(--surface); border-radius: var(--radius);
  overflow: hidden; margin-bottom: var(--sp-md);
  box-shadow: var(--shadow);
  -webkit-backdrop-filter: var(--glass); backdrop-filter: var(--glass);
}
.menu-item {
  display: flex; align-items: center; padding: var(--sp-lg) 28rpx;
  background: transparent; transition: background 0.15s; position: relative;
}
.menu-item:active { background: rgba(0,0,0,0.03); }
.menu-item + .menu-item::before {
  content: ''; position: absolute; top: 0; left: 100rpx; right: 28rpx;
  height: 1rpx; background: var(--line);
}
.menu-text { flex: 1; font-size: 30rpx; color: var(--text); margin-left: var(--sp-md); }
.menu-tag  { font-size: 22rpx; color: var(--amber); font-weight: 600; }

/* ── 标签 ── */
.tag {
  display: inline-flex; align-items: center;
  padding: 6rpx 16rpx; border-radius: 6rpx;
  font-size: 22rpx; font-weight: 500;
  margin-right: 10rpx; margin-bottom: 10rpx;
}
.tag--success { background: var(--green-light); color: var(--green); }
.tag--warning { background: rgba(212,145,74,0.1); color: var(--amber); }
.tag--danger  { background: var(--red-light);  color: var(--red); }
.tag--gray    { background: rgba(0,0,0,0.04);  color: var(--text3); }

/* ── FAB ── */
.fab {
  position: fixed; right: var(--sp-lg); bottom: 140rpx;
  width: 104rpx; height: 104rpx; border-radius: 50%;
  background: var(--green); box-shadow: var(--shadow-brand);
  display: flex; align-items: center; justify-content: center;
  transition: transform 0.15s;
}
.fab:active { transform: scale(0.92); }

/* ── 空状态 ── */
.empty-state {
  display: flex; flex-direction: column; align-items: center;
  padding-top: 200rpx;
}
.empty-text { font-size: 30rpx; color: var(--text3); margin-top: var(--sp-md); }
.empty-desc { font-size: 26rpx; color: rgba(0,0,0,0.18); margin-top: var(--sp-xs); }

/* ── 加载 ── */
.loading-state {
  display: flex; align-items: center; justify-content: center;
  padding: 120rpx 0; color: var(--text3); font-size: 26rpx;
}

@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
