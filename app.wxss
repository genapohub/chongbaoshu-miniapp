/* ══════════════════════════════════════════════
   宠宝树 V1.3 — 设计稿一比一还原
   设计源: 03-UI设计/设计稿原型.html
   ══════════════════════════════════════════════ */

page {
  --green:       #4A8C5C;
  --green-dark:  #3D7A4D;
  --green-deep:  #2A5E38;
  --amber:       #D4914A;
  --red:         #D4534A;
  --teal:        #3D8B37;

  --bg:          #F6F4F0;
  --surface:     rgba(255,255,255,0.85);
  --surface-solid: #FFFFFF;
  --text:        #2D2A26;
  --text2:       #5E5953;
  --text3:       #948F89;
  --line:        rgba(0,0,0,0.06);

  --radius-sm:   20rpx;
  --radius:      32rpx;
  --radius-lg:   48rpx;
  --radius-full: 9999rpx;

  --shadow:      0 4rpx 32rpx rgba(0,0,0,0.06);
  --shadow-lg:   0 8rpx 32rpx rgba(74,140,92,0.25);
  --shadow-fab:  0 16rpx 48rpx rgba(74,140,92,0.35);

  --sp-xs: 16rpx;
  --sp-sm: 24rpx;
  --sp-md: 32rpx;
  --sp-lg: 40rpx;
  --sp-xl: 56rpx;

  --glass: saturate(180%) blur(40px);
  -webkit-backdrop-filter: var(--glass);
  backdrop-filter: var(--glass);

  background: var(--bg);
  font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', sans-serif;
  font-size: 28rpx;
  color: var(--text);
  line-height: 1.7;
  -webkit-font-smoothing: antialiased;
}

/* ── 容器 ── */
.container {
  padding: var(--sp-lg);
  padding-bottom: calc(var(--sp-lg) + env(safe-area-inset-bottom));
  min-height: 100vh;
  background: var(--bg);
}

/* ── 卡片（设计稿风格） ── */
.card {
  background: var(--surface);
  border-radius: var(--radius);
  padding: var(--sp-xl);
  margin: var(--sp-md) var(--sp-lg) 0;
  box-shadow: var(--shadow);
  -webkit-backdrop-filter: var(--glass);
  backdrop-filter: var(--glass);
}
.card-sm {
  padding: var(--sp-lg);
}
.card-green {
  background: var(--green);
  color: #fff;
}
.card--mint    { background: #EDF4EF; }
.card--sky     { background: #E3F2FD; }
.card--rose    { background: #FFEBEE; }
.card--amber   { background: #FFF3E0; }
.card--lavender { background: #F3E5F5; }

.card-title {
  font-size: 32rpx; font-weight: 600;
  color: var(--text); margin-bottom: var(--sp-md);
}

/* ── 标题层级（Apple editorial） ── */
.h1 { font-size: 38rpx; font-weight: 700; line-height: 1.3; letter-spacing: -0.5rpx; }
.h2 { font-size: 32rpx; font-weight: 600; line-height: 1.35; }
.h3 { font-size: 28rpx; font-weight: 600; }
.caption { font-size: 24rpx; color: var(--text3); line-height: 1.5; }
.small   { font-size: 22rpx; color: var(--text3); }

/* ── 按钮（设计稿风格） ── */
.btn {
  display: block; width: 100%; padding: 36rpx;
  border-radius: var(--radius-full); font-size: 32rpx;
  font-weight: 600; text-align: center; border: none;
}
.btn::after { border: none; }

.btn-green {
  background: var(--green); color: #fff;
  box-shadow: 0 8rpx 32rpx rgba(74,140,92,0.25);
}
.btn-green:active { opacity: 0.9; }

.btn-white {
  background: rgba(255,255,255,0.9); color: var(--green);
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.12);
}

.btn-ghost {
  background: rgba(255,255,255,0.1); color: #fff;
  border: 2rpx solid rgba(255,255,255,0.2);
}

.btn-outline {
  background: transparent; color: var(--green);
  border: 2rpx solid var(--green);
}

.btn-primary {
  background: var(--green); color: #fff;
  border-radius: var(--radius-full); font-size: 32rpx; font-weight: 600;
  text-align: center; padding: 32rpx 0; border: none;
  display: flex; align-items: center; justify-content: center; gap: 10rpx;
  box-shadow: 0 8rpx 32rpx rgba(74,140,92,0.25);
}
.btn-primary::after { border: none; }

.btn-secondary {
  background: rgba(0,0,0,0.04); color: var(--green);
  border-radius: var(--radius-full); font-size: 28rpx;
  text-align: center; padding: 24rpx 0; border: none;
  display: flex; align-items: center; justify-content: center; gap: 8rpx;
}
.btn-secondary::after { border: none; }

.btn-danger {
  background: var(--red); color: #fff;
  border-radius: var(--radius-full); font-size: 28rpx;
  text-align: center; padding: 24rpx 0; border: none;
}
.btn-danger::after { border: none; }

/* ── 表单 ── */
.form-item { margin-bottom: 30rpx; }
.form-item:last-child { margin-bottom: 0; }
.form-label { display: block; font-size: 26rpx; color: var(--text2); margin-bottom: 14rpx; font-weight: 500; }
.input-field {
  background: rgba(0,0,0,0.03); border-radius: var(--radius-sm);
  padding: 24rpx 26rpx; font-size: 28rpx; border: 2rpx solid transparent;
  color: var(--text); width: 100%; box-sizing: border-box;
  min-height: 80rpx;
}
.input-field:focus { border-color: var(--green); background: rgba(74,140,92,0.04); }
.input-field::placeholder { color: var(--text3); }

.picker-wrap {
  display: flex; align-items: center; justify-content: space-between;
  background: rgba(0,0,0,0.03); border-radius: var(--radius-sm);
  padding: 24rpx 26rpx; font-size: 28rpx; border: 2rpx solid transparent;
}
.picker-wrap:active { border-color: var(--green); }
.picker-value { color: var(--text); flex: 1; }
.picker-value.placeholder { color: var(--text3); }

/* ── 菜单列表（设计稿风格） ── */
.menu-list-bg {
  background: var(--surface); border-radius: var(--radius);
  margin: var(--sp-lg); padding: 0;
  box-shadow: var(--shadow); overflow: hidden;
  -webkit-backdrop-filter: var(--glass); backdrop-filter: var(--glass);
}
.menu-row {
  display: flex; align-items: center; padding: var(--sp-lg) var(--sp-xl);
  border-bottom: 1rpx solid var(--line); font-size: 30rpx;
}
.menu-row:last-child { border-bottom: none; }
.menu-row:active { background: rgba(0,0,0,0.03); }
.menu-icon { width: 48rpx; text-align: center; margin-right: var(--sp-lg); font-size: 36rpx; }
.menu-label { flex: 1; color: var(--text); }
.menu-arrow { color: var(--text3); font-size: 32rpx; }
.menu-tag {
  background: var(--amber); color: #fff; font-size: 22rpx;
  padding: 4rpx 16rpx; border-radius: 8rpx; font-weight: 700; margin-left: 12rpx;
}

/* ── 标签（设计稿风格） ── */
.badge {
  font-size: 20rpx; padding: 6rpx 20rpx; border-radius: 8rpx;
  font-weight: 600; margin-left: 16rpx;
}
.badge-red { background: #FDEDEC; color: var(--red); }
.badge-orange { background: #FFF4E5; color: var(--amber); }
.badge-green { background: var(--green); color: #fff; }

.badge-amber {
  background: var(--amber); color: #fff; font-size: 20rpx;
  padding: 4rpx 16rpx; border-radius: 16rpx; font-weight: 700;
  position: absolute; top: -8rpx; right: -8rpx;
}

.tag {
  display: inline-flex; align-items: center;
  padding: 6rpx 16rpx; border-radius: 6rpx;
  font-size: 22rpx; font-weight: 500;
  margin-right: 10rpx; margin-bottom: 10rpx;
}
.tag--success { background: #EDF4EF; color: var(--green); }
.tag--warning { background: #FFF3E0; color: var(--amber); }
.tag--danger  { background: #FFEBEE; color: var(--red); }

/* ── FAB（设计稿风格） ── */
.fab {
  position: fixed; right: var(--sp-lg); bottom: 200rpx;
  width: 112rpx; height: 112rpx; border-radius: 50%;
  background: var(--green); box-shadow: var(--shadow-fab);
  display: flex; align-items: center; justify-content: center;
  font-size: 48rpx; color: #fff;
  z-index: 100;
}
.fab-btn {
  position: fixed; right: var(--sp-lg); bottom: 200rpx;
  width: 112rpx; height: 112rpx; border-radius: 50%;
  background: var(--green); box-shadow: 0 16rpx 48rpx rgba(74,140,92,0.35);
  display: flex; align-items: center; justify-content: center;
  font-size: 48rpx; color: #fff;
  z-index: 100;
}

/* ── 空状态 ── */
.empty-state {
  display: flex; flex-direction: column; align-items: center;
  padding-top: 220rpx;
}
.empty-text { font-size: 30rpx; color: var(--text3); margin-top: var(--sp-md); }
.empty-desc { font-size: 26rpx; color: rgba(0,0,0,0.15); margin-top: var(--sp-xs); }

/* ── 错误 ── */
.error-state { display: flex; flex-direction: column; align-items: center; padding: 200rpx var(--sp-lg); }
.error-text  { font-size: 28rpx; color: var(--text3); margin-top: var(--sp-md); display: block; }
.error-retry { margin-top: var(--sp-lg); padding: 18rpx 60rpx; background: var(--green); color: #fff; border-radius: var(--radius-full); font-size: 28rpx; display: inline-block; }

@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
