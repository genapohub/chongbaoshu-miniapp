/* ══════════════════════════════════════════════
   宠宝树 — 暖森林 · 毛玻璃 · 呼吸感
   ══════════════════════════════════════════════ */

page {
  --green:      #4A8C5C;
  --green-light:#6F9E7C;
  --amber:      #D4914A;
  --red:        #D4534A;
  --bg:         #F6F4F0;
  --surface:    rgba(255,255,255,0.82);
  --surface-solid: #FFFFFF;
  --text:       #2D2A26;
  --text2:      #5E5953;
  --text3:      #948F89;
  --line:       rgba(0,0,0,0.06);
  --radius:     16rpx;
  --radius-sm:  10rpx;
  --shadow-sm:  0 1rpx 4rpx rgba(0,0,0,0.04);
  --shadow:     0 2rpx 16rpx rgba(0,0,0,0.06);
  --shadow-lg:  0 8rpx 32rpx rgba(0,0,0,0.08);
  --glass:      saturate(180%) blur(20px);
  -webkit-backdrop-filter: var(--glass);
  backdrop-filter: var(--glass);

  background: var(--bg);
  font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', sans-serif;
  font-size: 28rpx;
  color: var(--text);
  line-height: 1.7;
}

/* ── 容器 ── */
.container {
  padding: 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  min-height: 100vh;
  background: var(--bg);
}

/* ── 卡片（毛玻璃） ── */
.card {
  background: var(--surface);
  border-radius: var(--radius);
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow);
  -webkit-backdrop-filter: var(--glass);
  backdrop-filter: var(--glass);
}
.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 24rpx;
  letter-spacing: 0.5rpx;
}
.card-header {
  display: flex; align-items: center; justify-content: space-between;
  margin-bottom: 24rpx;
}

/* ── 按钮 ── */
.btn-primary {
  background: var(--green);
  color: #fff;
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  padding: 26rpx 0;
  border: none;
  display: flex; align-items: center; justify-content: center;
  gap: 10rpx;
  letter-spacing: 0.5rpx;
}
.btn-primary::after { border: none; }
.btn-primary:active { opacity: 0.88; transform: scale(0.98); }
.btn-primary.disabled,
.btn-primary[disabled] { opacity: 0.4; pointer-events: none; }

.btn-secondary {
  background: rgba(0,0,0,0.04);
  color: var(--text2);
  border-radius: 48rpx;
  font-size: 28rpx;
  text-align: center;
  padding: 22rpx 0;
  border: none;
  display: flex; align-items: center; justify-content: center;
  gap: 8rpx;
}
.btn-secondary::after { border: none; }

.btn-danger {
  background: var(--red);
  color: #fff;
  border-radius: 48rpx;
  font-size: 28rpx;
  text-align: center;
  padding: 22rpx 0;
  border: none;
}
.btn-danger::after { border: none; }

/* ── 表单 ── */
.form-item {
  margin-bottom: 28rpx;
}
.form-item:last-child { margin-bottom: 0; }

.form-label {
  display: block;
  font-size: 26rpx;
  color: var(--text2);
  margin-bottom: 12rpx;
  font-weight: 500;
}

.input-field {
  background: rgba(0,0,0,0.03);
  border-radius: var(--radius-sm);
  padding: 22rpx 24rpx;
  font-size: 28rpx;
  border: 2rpx solid transparent;
  color: var(--text);
  width: 100%;
  box-sizing: border-box;
}
.input-field:focus { border-color: var(--green); background: rgba(74,140,92,0.04); }
.input-field::placeholder { color: var(--text3); }

.picker-wrap {
  display: flex; align-items: center; justify-content: space-between;
  background: rgba(0,0,0,0.03); border-radius: var(--radius-sm);
  padding: 22rpx 24rpx; font-size: 28rpx;
  border: 2rpx solid transparent;
}
.picker-wrap:active { border-color: var(--green); }
.picker-value { color: var(--text); flex: 1; }
.picker-value.placeholder { color: var(--text3); }

/* ── 列表/菜单 ── */
.menu-list {
  background: var(--surface);
  border-radius: var(--radius);
  overflow: hidden;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow);
  -webkit-backdrop-filter: var(--glass);
  backdrop-filter: var(--glass);
}

.menu-item {
  display: flex; align-items: center;
  padding: 32rpx 28rpx;
  background: transparent;
  transition: background 0.15s;
  position: relative;
}
.menu-item:active { background: rgba(0,0,0,0.03); }

.menu-item + .menu-item::before {
  content: ''; position: absolute; top: 0; left: 100rpx; right: 28rpx;
  height: 1rpx; background: var(--line);
}

.menu-text { flex: 1; font-size: 30rpx; color: var(--text); margin-left: 24rpx; }
.menu-tag  { font-size: 22rpx; color: var(--amber); font-weight: 600; }

/* ── 标签 ── */
.tag {
  display: inline-flex; align-items: center;
  padding: 6rpx 16rpx; border-radius: 6rpx;
  font-size: 22rpx; font-weight: 500;
  margin-right: 10rpx; margin-bottom: 10rpx;
}
.tag--success { background: rgba(74,140,92,0.1); color: var(--green); }
.tag--warning { background: rgba(212,145,74,0.1); color: var(--amber); }
.tag--danger  { background: rgba(212,83,74,0.08); color: var(--red); }
.tag--gray    { background: rgba(0,0,0,0.04);  color: var(--text3); }

/* ── 毛玻璃导航条 ── */
.nav-glass {
  position: sticky; top: 0; z-index: 100;
  background: rgba(246,244,240,0.78);
  -webkit-backdrop-filter: saturate(180%) blur(20px);
  backdrop-filter: saturate(180%) blur(20px);
  padding: 20rpx 32rpx;
  border-bottom: 1rpx solid rgba(0,0,0,0.04);
}

/* ── FAB ── */
.fab {
  position: fixed;
  right: 32rpx; bottom: 140rpx;
  width: 104rpx; height: 104rpx;
  border-radius: 50%;
  background: var(--green);
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 12rpx 32rpx rgba(74,140,92,0.3);
  transition: transform 0.15s;
}
.fab:active { transform: scale(0.92); }

/* ── 空状态 ── */
.empty-state {
  display: flex; flex-direction: column; align-items: center;
  padding-top: 200rpx;
}
.empty-text { font-size: 30rpx; color: var(--text3); margin-top: 24rpx; }
.empty-desc { font-size: 26rpx; color: rgba(0,0,0,0.2); margin-top: 8rpx; }

/* ── 加载状态 ── */
.loading-state {
  display: flex; align-items: center; justify-content: center;
  padding: 120rpx 0;
  color: var(--text3); font-size: 26rpx;
}

/* ── 淡入 ── */
@keyframes fadeIn {
  from { opacity: 0; }
  to   { opacity: 1; }
}
