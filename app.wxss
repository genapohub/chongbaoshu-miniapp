/* ══════════════════════════════════════════════
   宠宝树 — 暖森林 · Notion卡色 · Apple呼吸
   设计参考: Apple Human Interface + Notion Card Tints
   ══════════════════════════════════════════════ */

page {
  --green:       #4A8C5C;
  --green-dark:  #3D7A4D;
  --green-deep:  #2A5E38;
  --amber:       #D4914A;
  --red:         #D4534A;

  /* Notion-inspired card tints */
  --tint-mint:   #EDF7F0;
  --tint-cream:  #F9F6EF;
  --tint-sky:    #EDF2F7;
  --tint-rose:   #FDF0ED;
  --tint-lavender:#F3EEF8;

  --bg:          #F6F4F0;
  --surface:     rgba(255,255,255,0.85);
  --surface-solid: #FFFFFF;
  --text:        #2D2A26;
  --text2:       #5E5953;
  --text3:       #948F89;
  --line:        rgba(0,0,0,0.06);

  --radius-sm:   10rpx;
  --radius:      18rpx;
  --radius-lg:   24rpx;
  --radius-full: 9999rpx;

  --shadow:      0 2rpx 20rpx rgba(0,0,0,0.05);
  --shadow-lg:   0 8rpx 40rpx rgba(0,0,0,0.08);
  --shadow-brand: 0 6rpx 24rpx rgba(74,140,92,0.18);

  --sp-xs: 10rpx;
  --sp-sm: 18rpx;
  --sp-md: 28rpx;
  --sp-lg: 36rpx;
  --sp-xl: 52rpx;

  --glass: saturate(180%) blur(24px);
  -webkit-backdrop-filter: var(--glass);
  backdrop-filter: var(--glass);

  background: var(--bg);
  font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', sans-serif;
  font-size: 28rpx;
  color: var(--text);
  line-height: 1.7;
  -webkit-font-smoothing: antialiased;
}

/* ── 容器 ── */
.container {
  padding: var(--sp-lg);
  padding-bottom: calc(var(--sp-lg) + env(safe-area-inset-bottom));
  min-height: 100vh;
  background: var(--bg);
}

/* ── 卡片（Notion多彩+Apple呼吸） ── */
.card {
  background: var(--surface);
  border-radius: var(--radius);
  padding: var(--sp-lg);
  margin-bottom: var(--sp-md);
  box-shadow: var(--shadow);
  -webkit-backdrop-filter: var(--glass);
  backdrop-filter: var(--glass);
}
.card--mint    { background: var(--tint-mint);    box-shadow: none; }
.card--cream   { background: var(--tint-cream);   box-shadow: none; }
.card--sky     { background: var(--tint-sky);     box-shadow: none; }
.card--rose    { background: var(--tint-rose);    box-shadow: none; }
.card--elevated { box-shadow: var(--shadow-lg); }

.card-title {
  font-size: 28rpx; font-weight: 600;
  color: var(--text); margin-bottom: var(--sp-md);
  letter-spacing: 0.3rpx;
}

/* ── 标题层级（Apple editorial） ── */
.h1 { font-size: 38rpx; font-weight: 700; line-height: 1.3; letter-spacing: -0.5rpx; }
.h2 { font-size: 32rpx; font-weight: 600; line-height: 1.35; }
.h3 { font-size: 28rpx; font-weight: 600; }
.caption { font-size: 24rpx; color: var(--text3); line-height: 1.5; }
.small   { font-size: 22rpx; color: var(--text3); }

/* ── 按钮 ── */
.btn-primary {
  background: var(--green); color: #fff;
  border-radius: var(--radius-full); font-size: 30rpx; font-weight: 600;
  text-align: center; padding: 28rpx 0; border: none;
  display: flex; align-items: center; justify-content: center; gap: 10rpx;
  box-shadow: var(--shadow-brand); letter-spacing: 0.3rpx;
}
.btn-primary::after { border: none; }
.btn-primary:active { opacity: 0.88; transform: scale(0.98); }
.btn-primary.disabled,
.btn-primary[disabled] { opacity: 0.4; pointer-events: none; box-shadow: none; }

.btn-secondary {
  background: rgba(0,0,0,0.04); color: var(--text2);
  border-radius: var(--radius-full); font-size: 28rpx;
  text-align: center; padding: 24rpx 0; border: none;
  display: flex; align-items: center; justify-content: center; gap: 8rpx;
}
.btn-secondary::after { border: none; }

.btn-danger {
  background: var(--red); color: #fff;
  border-radius: var(--radius-full); font-size: 28rpx;
  text-align: center; padding: 24rpx 0; border: none;
}
.btn-danger::after { border: none; }

/* ── 表单 ── */
.form-item { margin-bottom: 30rpx; }
.form-item:last-child { margin-bottom: 0; }
.form-label { display: block; font-size: 26rpx; color: var(--text2); margin-bottom: 14rpx; font-weight: 500; }
.input-field {
  background: rgba(0,0,0,0.03); border-radius: var(--radius-sm);
  padding: 24rpx 26rpx; font-size: 28rpx; border: 2rpx solid transparent;
  color: var(--text); width: 100%; box-sizing: border-box;
}
.input-field:focus { border-color: var(--green); background: rgba(74,140,92,0.04); }
.input-field::placeholder { color: var(--text3); }

.picker-wrap {
  display: flex; align-items: center; justify-content: space-between;
  background: rgba(0,0,0,0.03); border-radius: var(--radius-sm);
  padding: 24rpx 26rpx; font-size: 28rpx; border: 2rpx solid transparent;
}
.picker-wrap:active { border-color: var(--green); }
.picker-value { color: var(--text); flex: 1; }
.picker-value.placeholder { color: var(--text3); }

/* ── 菜单 ── */
.menu-list {
  background: var(--surface); border-radius: var(--radius);
  overflow: hidden; margin-bottom: var(--sp-md);
  box-shadow: var(--shadow);
  -webkit-backdrop-filter: var(--glass); backdrop-filter: var(--glass);
}
.menu-item {
  display: flex; align-items: center; padding: var(--sp-lg) 30rpx;
  background: transparent; transition: background 0.15s; position: relative;
}
.menu-item:active { background: rgba(0,0,0,0.03); }
.menu-item + .menu-item::before {
  content: ''; position: absolute; top: 0; left: 104rpx; right: 30rpx;
  height: 1rpx; background: var(--line);
}
.menu-text { flex: 1; font-size: 30rpx; color: var(--text); margin-left: var(--sp-md); }
.menu-tag  { font-size: 22rpx; color: var(--amber); font-weight: 600; }

/* ── 标签 ── */
.tag {
  display: inline-flex; align-items: center;
  padding: 6rpx 16rpx; border-radius: 6rpx;
  font-size: 22rpx; font-weight: 500;
  margin-right: 10rpx; margin-bottom: 10rpx;
}
.tag--success { background: var(--tint-mint); color: var(--green); }
.tag--warning { background: rgba(212,145,74,0.1); color: var(--amber); }
.tag--danger  { background: var(--tint-rose);  color: var(--red); }

/* ── FAB ── */
.fab {
  position: fixed; right: var(--sp-lg); bottom: 160rpx;
  width: 108rpx; height: 108rpx; border-radius: 50%;
  background: var(--green); box-shadow: var(--shadow-brand);
  display: flex; align-items: center; justify-content: center;
}

/* ── 空状态 ── */
.empty-state {
  display: flex; flex-direction: column; align-items: center;
  padding-top: 220rpx;
}
.empty-text { font-size: 30rpx; color: var(--text3); margin-top: var(--sp-md); }
.empty-desc { font-size: 26rpx; color: rgba(0,0,0,0.15); margin-top: var(--sp-xs); }

/* ── 错误 ── */
.error-state { display: flex; flex-direction: column; align-items: center; padding: 200rpx var(--sp-lg); }
.error-text  { font-size: 28rpx; color: var(--text3); margin-top: var(--sp-md); display: block; }
.error-retry { margin-top: var(--sp-lg); padding: 18rpx 60rpx; background: var(--green); color: #fff; border-radius: var(--radius-full); font-size: 28rpx; display: inline-block; }

@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
