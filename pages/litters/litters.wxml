<view class="page-hero">
  <view class="decor-ring r1"></view>
  <view class="decor-ring r2"></view>
  <text class="hero-title">同窝管理</text>
  <text class="hero-sub">同窝幼犬与父母信息一览</text>
</view>
<view class="container">
  <view wx:if="{{loading}}" class="loading">加载中...</view>

  <!-- 错误状态 -->
  <view wx:elif="{{error}}" class="error-state">
    <cbs-icon name="warning" size="72" color="#E0903C" />
    <text class="error-text">加载失败，请检查网络</text>
    <view class="error-retry" bindtap="loadData">点击重试</view>
  </view>
  <view wx:elif="{{litters.length===0}}" class="empty"><cbs-icon name="baby" size="80" color="#C0C4CC"/><text class="empty-text">暂无同窝记录</text><text class="empty-desc">在繁育记录中标记"已分娩"时自动创建</text></view>
  <view wx:else class="list">
    <view wx:for="{{litters}}" wx:key="id" class="card" bindtap="goDetail" data-id="{{item.id}}" data-id="{{item.id}}">
      <view class="card-top">
        <text class="card-mother">母：{{item.mother_name||'?'}}</text>
        <text class="card-father" wx:if="{{item.father_name}}">父：{{item.father_name}}</text>
      </view>
      <view class="card-meta">
        <text>出生：{{item.birth_date}}</text>
        <text>幼犬：{{item.puppy_count||0}}/{{item.litter_size}}</text>
      </view>
      <view class="card-actions" wx:if="{{item.puppy_count < item.litter_size}}">
        <view class="btn-batch" catchtap="batchAdd" data-id="{{item.id}}">补齐幼犬</view>
      </view>
    </view>
  </view>
</view>
