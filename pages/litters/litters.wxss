.container { background: var(--bg); min-height: 100vh; padding: 24rpx; }
.header-bar { padding: 24rpx 0; }
.title { font-size: 36rpx; font-weight: 700; }
.card { background: var(--surface); border-radius: var(--radius); padding: 24rpx; margin-bottom: 16rpx; box-shadow: var(--shadow); }
.card-top { display: flex; gap: 16rpx; margin-bottom: 12rpx; }
.card-mother { font-size: 30rpx; font-weight: 600; color: var(--green); }
.card-father { font-size: 26rpx; color: var(--text3); }
.card-meta { display: flex; gap: 24rpx; font-size: 24rpx; color: var(--text3); }
.card-actions { margin-top: 16rpx; }
.btn-batch { display: inline-block; padding: 12rpx 24rpx; background: var(--green); color: #fff; border-radius: 8rpx; font-size: 24rpx; }
.empty { display: flex; flex-direction: column; align-items: center; padding-top: 200rpx; }
.empty-text { font-size: 32rpx; color: var(--text3); margin-top: 24rpx; }
.empty-desc { font-size: 26rpx; color: #C0C4CC; margin-top: 8rpx; }
