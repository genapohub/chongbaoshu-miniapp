/* P4 宠物详情样式 - 按设计稿一比一复刻 */

.container {
  min-height: 100vh;
  background: #F6F4F0;
}

/* 加载状态 */
.loading-wrapper {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 40rpx;
}

.loading-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 4rpx solid #E8E8E8;
  border-top-color: #4A8C5C;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  margin-top: 24rpx;
  font-size: 26rpx;
  color: #948F89;
}

/* 头部 */
.pet-header {
  background: #4A8C5C;
  padding: 40rpx 32rpx;
  color: #fff;
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.pet-avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: var(--radius);
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-img {
  width: 100%;
  height: 100%;
  border-radius: var(--radius);
}

.avatar-placeholder {
  font-size: 56rpx;
}

.pet-info {
  flex: 1;
}

.pet-name {
  font-size: 36rpx;
  font-weight: 700;
  display: block;
}

.pet-desc {
  font-size: 24rpx;
  opacity: 0.85;
  display: block;
  margin-top: 4rpx;
}

.pet-status {
  display: inline-block;
  background: rgba(255, 255, 255, 0.2);
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 20rpx;
  margin-top: 8rpx;
}

.edit-btn {
  width: 72rpx;
  height: 72rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.edit-icon {
  font-size: 32rpx;
}

/* Tab切换 */
.detail-tabs {
  display: flex;
  background: #fff;
  padding: 0 24rpx;
  border-bottom: 1rpx solid #EDEDEF;
}

.detail-tab {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  font-weight: 500;
  color: #5E5953;
  position: relative;
}

.detail-tab.active {
  color: #4A8C5C;
}

.detail-tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 4rpx;
  background: #4A8C5C;
  border-radius: 2rpx;
}

/* Tab内容 */
.tab-content {
  padding: 24rpx;
}

/* 卡片 */
.card {
  background: #fff;
  border-radius: var(--radius);
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.card-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.pro-tag {
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
  background: linear-gradient(135deg, #4A8C5C, #5B8DEF);
  color: #fff;
  padding: 2rpx 12rpx;
  border-radius: var(--radius-s);
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  vertical-align: middle;
  margin-left: 8rpx;
}

/* 字段 */
.field {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #EDEDEF;
}

.field:last-child {
  border-bottom: none;
}

.field-label {
  font-size: 26rpx;
  color: #948F89;
}

.field-value {
  font-size: 26rpx;
  font-weight: 500;
}

/* 照片卡片 */
.photo-card {
  padding: 24rpx 24rpx 16rpx;
}

.card-header {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 20rpx;
}

.card-title {
  font-size: 28rpx;
  font-weight: 600;
}

.photo-count {
  font-size: 26rpx;
  color: #5E5953;
}

/* 照片网格 */
.photo-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.photo-item {
  aspect-ratio: 1;
  border-radius: 12rpx;
  overflow: hidden;
  background: #F3F4F6;
}

.photo-img {
  width: 100%;
  height: 100%;
}

.photo-add {
  aspect-ratio: 1;
  background: #F3F4F6;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  color: #948F89;
}

.form-hint {
  font-size: 22rpx;
  color: #948F89;
  margin-top: 16rpx;
  text-align: center;
}

/* 繁育记录 */
.breeding-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #EDEDEF;
}

.breeding-item:last-child {
  border-bottom: none;
}

.breeding-info {
  flex: 1;
}

.breeding-name {
  font-size: 28rpx;
  font-weight: 600;
  display: block;
}

.breeding-date {
  font-size: 22rpx;
  color: #948F89;
  margin-top: 4rpx;
}

/* 健康记录 */
.health-item {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #EDEDEF;
}

.health-item:last-child {
  border-bottom: none;
}

.health-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.health-name {
  font-size: 28rpx;
  font-weight: 600;
}

.health-date {
  font-size: 22rpx;
  color: #948F89;
  margin-top: 4rpx;
}

/* 空卡片 */
.empty-card {
  text-align: center;
  padding: 40rpx;
  color: #948F89;
  font-size: 26rpx;
}

/* Badge */
.badge {
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 20rpx;
  font-weight: 600;
}

.badge-green {
  background: #E8F8F0;
  color: #3D8B37;
}

.badge-orange {
  background: #FFF8E1;
  color: #D99006;
}

.badge-red {
  background: #FEE2E2;
  color: #DC2626;
}

.badge-gray {
  background: #F3F4F6;
  color: #5E5953;
}

/* 按钮 */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius);
  padding: 24rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.btn-primary {
  background: #4A8C5C;
  color: #fff;
}

.btn-outline {
  background: transparent;
  color: #4A8C5C;
  border: 2rpx solid #4A8C5C;
}

.btn-block {
  width: 100%;
}