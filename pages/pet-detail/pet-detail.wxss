.detail-page { min-height: 100vh; background: var(--bg); padding-bottom: 180rpx; }

.pet-header {
  background: var(--gradient-hero);
  padding: 100rpx var(--sp-xl) 60rpx; text-align: center; color: #2D2A26;
  position: relative; overflow: hidden;
}
.pr1 { width: 420rpx; height: 420rpx; top: -140rpx; right: -150rpx; }
.pr2 { width: 240rpx; height: 240rpx; bottom: -80rpx; left: -90rpx; }
.pet-avatar-wrap {
  width: 160rpx; height: 160rpx; border-radius: 50%;
  overflow: hidden; margin: 0 auto 24rpx;
  border: 4rpx solid rgba(255,255,255,0.8);
  position: relative; z-index: 1;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.08);
}
.pet-avatar-lg { width: 100%; height: 100%; }
.pet-avatar-placeholder-lg {
  width: 100%; height: 100%; display: flex; align-items: center; justify-content: center;
  font-size: 64rpx; background: rgba(74,140,92,0.12);
}
.pet-name-lg { font-size: 44rpx; font-weight: 800; letter-spacing: 2rpx; position: relative; z-index: 1; }
.pet-desc-lg { font-size: 26rpx; color: #5E5953; margin-top: 8rpx; display: block; position: relative; z-index: 1; }
.pet-status-badge {
  display: inline-block; padding: 8rpx 24rpx;
  background: rgba(255,255,255,0.7); border-radius: 20rpx;
  font-size: 22rpx; margin-top: 16rpx; color: var(--green);
  position: relative; z-index: 1;
}

.detail-tabs {
  display: flex; background: var(--surface);
  border-bottom: 1rpx solid var(--line);
}
.detail-tab {
  flex: 1; text-align: center; padding: 28rpx 0;
  font-size: 28rpx; color: var(--text3); position: relative;
}
.detail-tab.active { color: var(--green); font-weight: 700; }
.detail-tab.active::after {
  content: ''; position: absolute; bottom: 0; left: 50%;
  transform: translateX(-50%); width: 48rpx; height: 4rpx;
  background: var(--green); border-radius: 2rpx;
}

.tab-content { padding: var(--sp-lg); }

.field-row {
  display: flex; justify-content: space-between; align-items: center;
  padding: 24rpx 0; border-bottom: 1rpx solid var(--line);
}
.field-row:last-child { border-bottom: none; }
.field-label { font-size: 28rpx; color: var(--text3); }
.field-value { font-size: 28rpx; font-weight: 600; color: var(--text); }

.photo-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16rpx; }
.photo-item { aspect-ratio: 1; border-radius: var(--radius-sm); overflow: hidden; background: rgba(0,0,0,0.03); }
.photo-img { width: 100%; height: 100%; }
.photo-add {
  aspect-ratio: 1; border-radius: var(--radius-sm);
  background: rgba(74,140,92,0.1); display: flex;
  align-items: center; justify-content: center; font-size: 48rpx;
  color: var(--green);
}

.record-row {
  display: flex; align-items: center; padding: 24rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.record-row:last-child { border-bottom: none; }
.record-info { flex: 1; }
.record-name { font-size: 28rpx; font-weight: 600; color: var(--text); display: block; }
.record-date { font-size: 24rpx; color: var(--text3); margin-top: 6rpx; display: block; }
.record-arrow { font-size: 32rpx; color: var(--text3); }
