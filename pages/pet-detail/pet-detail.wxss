/* P4 宠物详情样式 - 按设计稿一比一复刻 */

.container {
  min-height: 100vh;
  background: #F7F8FA;
}

/* 头部 */
.pet-header {
  background: #E94560;
  padding: 40rpx 32rpx;
  color: #fff;
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.pet-avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 16rpx;
}

.avatar-placeholder {
  font-size: 56rpx;
}

.pet-info {
  flex: 1;
}

.pet-name {
  font-size: 36rpx;
  font-weight: 700;
  display: block;
}

.pet-desc {
  font-size: 24rpx;
  opacity: 0.85;
  display: block;
  margin-top: 4rpx;
}

.pet-status {
  display: inline-block;
  background: rgba(255, 255, 255, 0.2);
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 20rpx;
  margin-top: 8rpx;
}

.edit-btn {
  width: 72rpx;
  height: 72rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.edit-icon {
  font-size: 32rpx;
}

/* Tab切换 */
.detail-tabs {
  display: flex;
  background: #fff;
  padding: 0 24rpx;
  border-bottom: 1rpx solid #F3F4F6;
}

.detail-tab {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  font-weight: 500;
  color: #6B7280;
  position: relative;
}

.detail-tab.active {
  color: #E94560;
}

.detail-tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 4rpx;
  background: #E94560;
  border-radius: 2rpx;
}

/* Tab内容 */
.tab-content {
  padding: 24rpx;
}

/* 卡片 */
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.card-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.pro-tag {
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
  background: linear-gradient(135deg, #E94560, #FD79A8);
  color: #fff;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  vertical-align: middle;
  margin-left: 8rpx;
}

/* 字段 */
.field {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F3F4F6;
}

.field:last-child {
  border-bottom: none;
}

.field-label {
  font-size: 26rpx;
  color: #9CA3AF;
}

.field-value {
  font-size: 26rpx;
  font-weight: 500;
}

/* 照片卡片 */
.photo-card {
  padding: 24rpx 24rpx 16rpx;
}

.card-header {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 20rpx;
}

.card-title {
  font-size: 28rpx;
  font-weight: 600;
}

.photo-count {
  font-size: 26rpx;
  color: #6B7280;
}

.pro-tag {
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
  background: linear-gradient(135deg, #E94560, #FD79A8);
  color: #fff;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  vertical-align: middle;
  margin-left: 8rpx;
}

/* 照片网格 */
.photo-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.photo-item {
  aspect-ratio: 1;
  border-radius: 12rpx;
  overflow: hidden;
  background: #F3F4F6;
}

.photo-img {
  width: 100%;
  height: 100%;
}

.photo-add {
  aspect-ratio: 1;
  background: #F3F4F6;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  color: #9CA3AF;
}

.form-hint {
  font-size: 22rpx;
  color: #9CA3AF;
  margin-top: 16rpx;
  text-align: center;
}

/* 繁育记录 */
.breeding-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F3F4F6;
}

.breeding-item:last-child {
  border-bottom: none;
}

.breeding-info {
  flex: 1;
}

.breeding-name {
  font-size: 28rpx;
  font-weight: 600;
  display: block;
}

.breeding-date {
  font-size: 22rpx;
  color: #9CA3AF;
  margin-top: 4rpx;
}

/* 健康记录 */
.health-item {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F3F4F6;
}

.health-item:last-child {
  border-bottom: none;
}

.health-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.health-name {
  font-size: 28rpx;
  font-weight: 600;
}

.health-date {
  font-size: 22rpx;
  color: #9CA3AF;
  margin-top: 4rpx;
}

/* 空卡片 */
.empty-card {
  text-align: center;
  padding: 40rpx;
  color: #9CA3AF;
  font-size: 26rpx;
}

/* Badge */
.badge {
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 20rpx;
  font-weight: 600;
}

.badge-green {
  background: #D1FAE5;
  color: #059669;
}

.badge-orange {
  background: #FEF3C7;
  color: #D97706;
}

.badge-red {
  background: #FEE2E2;
  color: #DC2626;
}

.badge-gray {
  background: #F3F4F6;
  color: #6B7280;
}

/* 按钮 */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.btn-primary {
  background: #E94560;
  color: #fff;
}

.btn-outline {
  background: transparent;
  color: #E94560;
  border: 2rpx solid #E94560;
}

.btn-block {
  width: 100%;
}