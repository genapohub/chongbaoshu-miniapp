/* 宠物详情 */

.container { min-height: 100vh; background: var(--bg); }

/* 头部 */
.detail-header { background: var(--green); padding: 48rpx 24rpx 40rpx; text-align: center; color: #fff; }
.pet-avatar-lg { width: 140rpx; height: 140rpx; border-radius: 24rpx; overflow: hidden; margin: 0 auto 20rpx; background: rgba(255,255,255,0.2); display: flex; align-items: center; justify-content: center; }
.pet-name-lg { font-size: 40rpx; font-weight: 700; }
.pet-desc-lg { font-size: 26rpx; opacity: 0.8; margin-top: 6rpx; }

/* Tab */
.detail-tabs { display: flex; background: var(--surface); border-bottom: 1rpx solid var(--line); }
.detail-tab { flex: 1; text-align: center; padding: 28rpx 0; font-size: 28rpx; color: var(--text3); position: relative; }
.detail-tab.active { color: var(--green); }
.detail-tab.active::after { content: ''; position: absolute; bottom: 0; left: 50%; transform: translateX(-50%); width: 40rpx; height: 4rpx; background: var(--green); border-radius: 2rpx; }
.tab-content { padding: 24rpx; }

/* 字段 */
.field { display: flex; justify-content: space-between; padding: 16rpx 0; border-bottom: 1rpx solid var(--line); }
.field:last-child { border-bottom: none; }
.field-label { font-size: 26rpx; color: var(--text3); }
.field-value { font-size: 26rpx; font-weight: 500; }

/* 照片网格 */
.photo-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16rpx; }
.photo-item { aspect-ratio: 1; border-radius: 12rpx; overflow: hidden; background: var(--bg); }
.photo-img { width: 100%; height: 100%; }

/* 按钮 */
.btn { border-radius: var(--radius); padding: 24rpx; font-size: 28rpx; font-weight: 600; text-align: center; display: block; }
.btn-primary { background: var(--green); color: #fff; }
.btn-outline { background: transparent; color: var(--green); border: 2rpx solid var(--green); }
.btn-block { width: 100%; }
