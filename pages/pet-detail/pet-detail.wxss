.container { min-height: 100vh; background: var(--bg); }
.detail-header { background: var(--green); padding: 56rpx 32rpx 48rpx; text-align: center; color: #fff; }
.pet-avatar-lg { width: 140rpx; height: 140rpx; border-radius: 28rpx; overflow: hidden; margin: 0 auto 24rpx; background: rgba(255,255,255,0.18); display: flex; align-items: center; justify-content: center; border: 3rpx solid rgba(255,255,255,0.3); }
.pet-name-lg { font-size: 42rpx; font-weight: 700; letter-spacing: 0.5rpx; }
.pet-desc-lg { font-size: 26rpx; opacity: 0.8; margin-top: 8rpx; }
.detail-tabs { display: flex; background: var(--surface-solid); border-bottom: 1rpx solid var(--line); }
.detail-tab { flex: 1; text-align: center; padding: 30rpx 0; font-size: 28rpx; color: var(--text3); position: relative; }
.detail-tab.active { color: var(--green); }
.detail-tab.active::after { content: ''; position: absolute; bottom: 0; left: 50%; transform: translateX(-50%); width: 44rpx; height: 4rpx; background: var(--green); border-radius: 2rpx; }
.tab-content { padding: 28rpx 32rpx; }
.field { display: flex; justify-content: space-between; padding: 18rpx 0; border-bottom: 1rpx solid var(--line); }
.field:last-child { border-bottom: none; }
.field-label { font-size: 26rpx; color: var(--text3); }
.field-value { font-size: 26rpx; font-weight: 500; }
.photo-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18rpx; }
.photo-item { aspect-ratio: 1; border-radius: var(--radius-sm); overflow: hidden; background: rgba(0,0,0,0.03); }
.photo-img { width: 100%; height: 100%; }
.btn { border-radius: 48rpx; padding: 26rpx; font-size: 28rpx; font-weight: 600; text-align: center; display: block; }
.btn-primary { background: var(--green); color: #fff; }
.btn-outline { background: transparent; color: var(--green); border: 2rpx solid var(--green); }
.btn-block { width: 100%; }
