<!--
  P4 宠物详情 - 按设计稿一比一复刻
  结构：头部信息 → 4Tab切换（概览/繁育/健康/血统）→ 各Tab内容
-->
<view class="container">
  <!-- 加载状态 -->
  <loading-spinner wx:if="{{loading}}" />

  <!-- 头部信息 -->
  <view wx:elif="{{pet.name}}" class="pet-header">
    <pet-avatar src="{{pet.avatar}}" icon="{{pet.speciesIcon}}" size="lg" radius="16rpx" />
    <view class="pet-info">
      <text class="pet-name">{{pet.name}}</text>
      <text class="pet-desc">{{pet.speciesLabel}} · {{pet.genderLabel}} · {{pet.age}}</text>
      <view class="pet-status">{{pet.statusLabel}}</view>
    </view>
    <view class="edit-btn" bindtap="goEdit">
      <icon name="edit" size="36" color="#3370FF" />
    </view>
  </view>

  <!-- Tab切换 -->
  <view class="detail-tabs">
    <view
      wx:for="{{tabs}}"
      wx:key="key"
      class="detail-tab {{currentTab === item.key ? 'active' : ''}}"
      data-key="{{item.key}}"
      bindtap="switchTab"
    >
      {{item.label}}
    </view>
  </view>

  <!-- 概览Tab -->
  <view wx:if="{{currentTab === 'overview'}}" class="tab-content">
    <view class="card">
      <field-row label="物种" value="{{pet.speciesLabel}}" />
      <field-row label="品种" value="{{pet.breed}}" />
      <field-row label="性别" value="{{pet.genderLabel}}" />
      <field-row label="出生日期" value="{{pet.birthDate}}" />
      <field-row label="毛色" value="{{pet.color}}" />
      <field-row label="芯片号" value="{{pet.chipNo}}" />
    </view>

    <view class="card photo-card">
      <view class="card-header">
        <text class="card-title">照片</text>
        <text class="photo-count">({{photoCount}}/{{maxPhotos}})</text>
        <text class="pro-tag" wx:if="{{isPro}}">PRO</text>
      </view>
      <view class="photo-grid">
        <view wx:for="{{pet.photos}}" wx:key="index" class="photo-item">
          <image src="{{item}}" mode="aspectFill" class="photo-img" lazy-load />
        </view>
        <view wx:if="{{canAddPhoto}}" class="photo-add" bindtap="addPhoto"><icon name="plus" size="44" color="#FFFFFF" /></view>
      </view>
      <view class="form-hint">免费版每只3张，基础版每只10张，Pro版每只20张</view>
    </view>
  </view>

  <!-- 繁育Tab -->
  <view wx:if="{{currentTab === 'breeding'}}" class="tab-content">
    <view class="card">
      <view class="card-title"><icon name="heart" size="36" color="#F54A45" /><text>繁育记录</text></view>
      <view wx:for="{{breedingRecords}}" wx:key="id" class="breeding-item" data-id="{{item.id}}" bindtap="goBreedingDetail">
        <view class="breeding-info">
          <text class="breeding-name">{{item.name}}</text>
          <text class="breeding-date">{{item.date}}</text>
        </view>
        <status-badge type="{{item.statusType}}" label="{{item.status}}" />
      </view>
      <view wx:if="{{breedingRecords.length === 0}}" class="empty-card">暂无繁育记录</view>
    </view>
    <view class="btn btn-primary btn-block" bindtap="goAddBreeding"><icon name="plus" size="32" color="#FFFFFF" />添加配种记录</view>
  </view>

  <!-- 健康Tab -->
  <view wx:if="{{currentTab === 'health'}}" class="tab-content">
    <view class="card">
      <view class="card-title"><icon name="syringe" size="36" color="#2D9CDB" /><text>健康记录</text></view>
      <view wx:for="{{healthRecords}}" wx:key="id" class="health-item" data-id="{{item.id}}" bindtap="goHealthDetail">
        <view class="health-info">
          <view class="health-header">
            <text class="health-name">{{item.name}}</text>
            <status-badge type="{{item.statusType}}" label="{{item.status}}" />
          </view>
          <text class="health-date">{{item.date}} · 下次：{{item.nextDate}}</text>
        </view>
      </view>
      <view wx:if="{{healthRecords.length === 0}}" class="empty-card">暂无健康记录</view>
    </view>
    <view class="btn btn-primary btn-block" bindtap="goAddHealth"><icon name="plus" size="32" color="#FFFFFF" />添加健康记录</view>
  </view>

  <!-- 血统Tab -->
  <view wx:if="{{currentTab === 'pedigree'}}" class="tab-content">
    <view class="card">
      <view class="card-title"><icon name="document" size="36" color="#8B5CF6" /><text>血统信息 <text class="pro-tag">PRO</text></text></view>
      <field-row label="注册名" value="{{isPro ? pedigree.regName : ''}}" empty="—" />
      <field-row label="注册号" value="{{isPro ? pedigree.regNo : ''}}" empty="—" />
      <field-row label="犬舍名" value="{{isPro ? pedigree.kennel : ''}}" empty="—" />
      <field-row label="毛色(血统)" value="{{isPro ? pedigree.color : ''}}" empty="—" />
      <field-row label="父亲" value="{{isPro ? pedigree.father : ''}}" empty="—" />
      <field-row label="母亲" value="{{isPro ? pedigree.mother : ''}}" empty="—" />
      <field-row label="父方祖父" value="{{isPro ? pedigree.fatherFather : ''}}" empty="—" />
      <field-row label="父方祖母" value="{{isPro ? pedigree.fatherMother : ''}}" empty="—" />
      <field-row label="母方祖父" value="{{isPro ? pedigree.motherFather : ''}}" empty="—" />
      <field-row label="母方祖母" value="{{isPro ? pedigree.motherMother : ''}}" empty="—" />
    </view>
    <view class="btn btn-outline btn-block" bindtap="goPedigreeCert">查看血统证书 →</view>
    <view class="btn btn-primary btn-block" bindtap="goShareCard">📤 生成分享卡片</view>
  </view>
</view>