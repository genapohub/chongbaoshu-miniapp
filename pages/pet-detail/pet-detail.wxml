<view class="detail-page">
  <view class="pet-header">
    <view class="pet-avatar-wrap">
      <image wx:if="{{pet.avatar}}" class="pet-avatar-lg" src="{{pet.avatar}}" mode="aspectFill" />
      <view wx:else class="pet-avatar-placeholder-lg">{{pet.speciesIcon}}</view>
    </view>
    <text class="pet-name-lg">{{pet.name}}</text>
    <text class="pet-desc-lg">{{pet.speciesLabel}} · {{pet.genderLabel}} · {{pet.age}}</text>
    <view class="pet-status-badge">{{pet.statusLabel}}</view>
  </view>
  
  <view class="detail-tabs">
    <view wx:for="{{tabs}}" wx:key="key" class="detail-tab {{currentTab === item.key ? 'active' : ''}}" data-key="{{item.key}}" bindtap="switchTab">
      {{item.label}}
    </view>
  </view>
  
  <view wx:if="{{currentTab === 'overview'}}" class="tab-content">
    <view class="card">
      <text class="section-title">基本信息</text>
      <view class="field-row"><text class="field-label">物种</text><text class="field-value">{{pet.speciesLabel}}</text></view>
      <view class="field-row"><text class="field-label">品种</text><text class="field-value">{{pet.breed || '—'}}</text></view>
      <view class="field-row"><text class="field-label">性别</text><text class="field-value">{{pet.genderLabel}}</text></view>
      <view class="field-row"><text class="field-label">售价</text><text class="field-value">{{pet.price ? '¥' + (pet.price/100) : '未设置'}}</text></view>
      <view class="field-row"><text class="field-label">在售状态</text><text class="field-value">{{pet.is_for_sale ? '在售中' : '非在售'}}</text></view>
      <view class="field-row"><text class="field-label">出生日期</text><text class="field-value">{{pet.birthDate || '—'}}</text></view>
      <view class="field-row"><text class="field-label">毛色</text><text class="field-value">{{pet.color || '—'}}</text></view>
      <view class="field-row"><text class="field-label">芯片号</text><text class="field-value">{{pet.chipNo || '—'}}</text></view>
    </view>
    
    <view class="card">
      <text class="section-title">照片 ({{photoCount}}/{{maxPhotos}})</text>
      <view class="photo-grid">
        <view wx:for="{{pet.photos}}" wx:key="index" class="photo-item"><image src="{{item}}" mode="aspectFill" class="photo-img" /></view>
        <view wx:if="{{canAddPhoto}}" class="photo-add" bindtap="addPhoto">+</view>
      </view>
    </view>
    
    <view class="card">
      <text class="section-title">操作</text>
      <view class="btn btn-green btn-block" bindtap="goEdit">编辑宠物信息</view>
    </view>
  </view>
  
  <view wx:if="{{currentTab === 'breeding'}}" class="tab-content">
    <view class="card">
      <text class="section-title">🐕 繁育记录</text>
      <view wx:for="{{breedingRecords}}" wx:key="id" class="record-row" bindtap="goBreedingDetail" data-id="{{item.id}}">
        <view class="record-info">
          <text class="record-name">{{item.name}}</text>
          <text class="record-date">{{item.date}}</text>
        </view>
        <text class="record-arrow">→</text>
      </view>
      <empty-state wx:if="{{breedingRecords.length === 0}}" text="暂无繁育记录" subText="点击下方添加配种记录" />
    </view>
    <view class="btn btn-green btn-block" bindtap="goAddBreeding">添加配种记录</view>
  </view>
  
  <view wx:if="{{currentTab === 'health'}}" class="tab-content">
    <view class="card">
      <text class="section-title">💉 健康记录</text>
      <view wx:for="{{healthRecords}}" wx:key="id" class="record-row" bindtap="goHealthDetail" data-id="{{item.id}}">
        <view class="record-info">
          <text class="record-name">{{item.name}}</text>
          <text class="record-date">{{item.date}} · 下次：{{item.nextDate}}</text>
        </view>
        <text class="record-arrow">→</text>
      </view>
      <empty-state wx:if="{{healthRecords.length === 0}}" text="暂无健康记录" subText="点击下方添加健康记录" />
    </view>
    <view class="btn btn-green btn-block" bindtap="goAddHealth">添加健康记录</view>
  </view>
  
  <view wx:if="{{currentTab === 'pedigree'}}" class="tab-content">
    <view class="card">
      <text class="section-title">📜 血统信息</text>
      <view class="field-row"><text class="field-label">注册名</text><text class="field-value">{{isPro ? pedigree.regName : '—'}}</text></view>
      <view class="field-row"><text class="field-label">注册号</text><text class="field-value">{{isPro ? pedigree.regNo : '—'}}</text></view>
      <view class="field-row"><text class="field-label">犬舍名</text><text class="field-value">{{isPro ? pedigree.kennel : '—'}}</text></view>
      <view class="field-row"><text class="field-label">毛色(血统)</text><text class="field-value">{{isPro ? pedigree.color : '—'}}</text></view>
      <view class="field-row"><text class="field-label">父亲</text><text class="field-value">{{isPro ? pedigree.father : '—'}}</text></view>
      <view class="field-row"><text class="field-label">母亲</text><text class="field-value">{{isPro ? pedigree.mother : '—'}}</text></view>
    </view>
    <view class="btn btn-outline btn-block" bindtap="goPedigreeCert">查看血统证书 →</view>
  </view>
</view>
