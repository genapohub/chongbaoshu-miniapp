<view class="container"><view class="form"><view class="form-item"><text class="label">买家名称 *</text><input class="input" value="{{form.buyer_name}}" bindinput="onInput" data-field="buyer_name" placeholder="必填"/></view><view class="form-item"><text class="label">微信号</text><input class="input" value="{{form.buyer_wechat}}" bindinput="onInput" data-field="buyer_wechat"/></view><view class="form-item"><text class="label">手机号</text><input class="input" type="number" value="{{form.buyer_phone}}" bindinput="onInput" data-field="buyer_phone"/></view><view class="form-item"><text class="label">预算/报价</text><input class="input" value="{{form.budget}}" bindinput="onInput" data-field="budget"/></view><view class="form-item"><text class="label">备注</text><textarea class="input textarea" value="{{form.notes}}" bindinput="onInput" data-field="notes"/></view></view><view class="btn-save" bindtap="save"><text wx:if="{{!saving}}">保存</text><text wx:else>保存中...</text></view></view>
