/* 添加意向客户 — 暖森林 2.0 */
.container {
  padding: var(--sp-md) var(--sp-lg) calc(var(--sp-xl) + env(safe-area-inset-bottom));
}

.form {
  background: var(--surface);
  border-radius: var(--radius);
  padding: var(--sp-lg);
  box-shadow: var(--shadow);
  -webkit-backdrop-filter: var(--glass);
  backdrop-filter: var(--glass);
}

.form-item {
  margin-bottom: 30rpx;
}
.form-item:last-child {
  margin-bottom: 0;
}

.label {
  display: block;
  font-size: 26rpx;
  color: var(--text2);
  font-weight: 500;
  margin-bottom: 14rpx;
}

.input {
  width: 100%;
  min-height: 88rpx;
  box-sizing: border-box;
  background: rgba(0, 0, 0, 0.03);
  border-radius: var(--radius-sm);
  padding: 24rpx 26rpx;
  font-size: 28rpx;
  color: var(--text);
  border: 2rpx solid transparent;
}
.input:focus {
  border-color: var(--green);
  background: rgba(74, 140, 92, 0.04);
}
.input::placeholder {
  color: var(--text3);
}

.textarea {
  min-height: 160rpx;
  padding-top: 22rpx;
  line-height: 1.6;
}

.btn-save {
  margin-top: 40rpx;
  background: var(--green);
  color: #fff;
  border-radius: var(--radius-full);
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  padding: 30rpx 0;
  box-shadow: 0 8rpx 32rpx rgba(74, 140, 92, 0.25);
}
.btn-save:active {
  opacity: 0.9;
}
