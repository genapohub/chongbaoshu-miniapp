<view class="container">
  <view class="card">
    <view class="form-section">
      <text class="form-label">Logo</text>
      <view class="logo-upload-wrap">
        <view class="logo-upload" bindtap="chooseLogo">
          <image wx:if="{{formData.kennel_logo}}" src="{{formData.kennel_logo}}" class="logo-img" mode="aspectFill" lazy-load />
          <view wx:else class="logo-placeholder">
            <view class="logo-icon"><cbs-icon name="camera" size="48" color="#8F959E" /></view>
            <text class="logo-text">点击上传</text>
          </view>
        </view>
        <text wx:if="{{formData.kennel_logo}}" class="logo-hint">点击更换</text>
      </view>
    </view>
  </view>

  <view class="card">
    <text class="card-title">基本信息</text>

    <view class="form-item">
      <text class="form-label">宠舍名称 <text class="required">*</text></text>
      <input class="input-field" placeholder="请输入宠舍名称（1-50字）" value="{{formData.kennel_name}}" bindinput="onInputChange" data-field="kennel_name" maxlength="50" />
    </view>

    <view class="form-item">
      <text class="form-label">所在地区</text>
      <picker mode="region" value="{{formData.region}}" bindchange="onRegionChange">
        <view class="picker-wrap">
          <text class="picker-value {{formData.region.length ? '' : 'placeholder'}}">
            {{formData.region.length ? formData.region[0] + ' ' + formData.region[1] + ' ' + formData.region[2] : '请选择地区'}}
          </text>
          <text class="picker-arrow"><cbs-icon name="chevron-right" size="28" color="#C0C4CC" /></text>
        </view>
      </picker>
    </view>

    <view class="form-item">
      <text class="form-label">详细地址</text>
      <input class="input-field" placeholder="请输入详细地址" value="{{formData.address}}" bindinput="onInputChange" data-field="address" />
    </view>

    <view class="form-item">
      <text class="form-label">宠舍简介</text>
      <view class="textarea-wrap">
        <textarea class="textarea-field" placeholder="请输入宠舍简介" value="{{formData.kennel_intro}}" bindinput="onIntroInput" maxlength="200" auto-height />
        <text class="char-count">{{introLength}}/200</text>
      </view>
    </view>

    <view class="form-item">
      <text class="form-label">联系电话</text>
      <input class="input-field" placeholder="请输入联系电话" value="{{formData.phone}}" bindinput="onInputChange" data-field="phone" type="number" maxlength="11" />
    </view>

    <view class="form-item">
      <text class="form-label">微信号</text>
      <input class="input-field" placeholder="请输入微信号" value="{{formData.wechat}}" bindinput="onInputChange" data-field="wechat" />
    </view>
  </view>

  <view class="card">
    <text class="card-title">主营品种</text>
    <view class="tag-options">
      <view wx:for="{{availableBreeds}}" wx:key="index"
            class="tag-option {{selectedBreedsIndex[item] ? 'selected' : ''}}"
            bindtap="toggleBreed" data-breed="{{item}}">
        {{item}}
      </view>
      <view wx:for="{{customBreeds}}" wx:key="index"
            class="tag-option {{selectedBreedsIndex[item] ? 'selected' : ''}}"
            bindtap="toggleBreed" data-breed="{{item}}">
        {{item}}
      </view>
    </view>
    <view class="add-tag-row">
      <input class="input-field small" placeholder="自定义品种" value="{{newBreed}}" bindinput="onNewBreedInput" />
      <view class="btn-add-tag" bindtap="addCustomBreed">添加</view>
    </view>
  </view>

  <view class="submit-section">
    <view class="btn-primary {{canSubmit ? '' : 'disabled'}}" bindtap="submitForm">保存</view>
  </view>
</view>
