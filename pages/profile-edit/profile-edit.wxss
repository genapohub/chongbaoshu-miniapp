/* 宠舍信息编辑 — 页面特有样式 */

/* Logo区 */
.logo-upload-wrap { display: flex; flex-direction: column; align-items: center; margin-top: 8rpx; }
.logo-upload { width: 160rpx; height: 160rpx; border-radius: var(--radius); overflow: hidden; background: rgba(0,0,0,0.04); display: flex; align-items: center; justify-content: center; }
.logo-img { width: 100%; height: 100%; }
.logo-placeholder { display: flex; flex-direction: column; align-items: center; gap: 8rpx; }
.logo-text { font-size: 22rpx; color: var(--text3); }
.logo-hint { font-size: 22rpx; color: var(--text3); margin-top: 12rpx; }

/* 输入框组 */
.required { color: var(--red); margin-left: 4rpx; }
.textarea-wrap { position: relative; }
.textarea-field { width: 100%; min-height: 160rpx; background: rgba(0,0,0,0.03); border-radius: var(--radius-sm); padding: 22rpx 24rpx; font-size: 28rpx; color: var(--text); border: 2rpx solid transparent; box-sizing: border-box; }
.textarea-field:focus { border-color: var(--green); }
.char-count { text-align: right; font-size: 22rpx; color: var(--text3); margin-top: 6rpx; }

/* 品种标签 */
.tag-options { display: flex; flex-wrap: wrap; gap: 12rpx; }
.tag-option { padding: 12rpx 24rpx; border-radius: 32rpx; font-size: 26rpx; background: rgba(0,0,0,0.04); color: var(--text2); border: 2rpx solid transparent; }
.tag-option.selected { background: var(--green); color: #fff; border-color: var(--green); }
.add-tag-row { display: flex; gap: 12rpx; margin-top: 16rpx; }
.add-tag-row .input-field { flex: 1; }
.btn-add-tag { padding: 18rpx 28rpx; background: var(--green); color: #fff; border-radius: var(--radius-sm); font-size: 26rpx; display: flex; align-items: center; white-space: nowrap; }

/* 提交区 */
.submit-section { padding: 32rpx; padding-bottom: calc(32rpx + env(safe-area-inset-bottom)); }
.submit-section .btn-primary { margin-top: 0; }
