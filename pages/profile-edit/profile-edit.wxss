.container {
  min-height: 100vh;
  background: #F6F4F0;
  padding-bottom: env(safe-area-inset-bottom);
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin: 20rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2D2A26;
  margin-bottom: 24rpx;
}

.form-section {
  padding: 16rpx 0;
}

.logo-upload-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 160rpx;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #2D2A26;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.required {
  color: #4A8C5C;
}

.input-field {
  background: #F6F4F0;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #2D2A26;
}

.input-field.small {
  padding: 16rpx 20rpx;
  font-size: 26rpx;
}

.logo-upload {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: 2rpx dashed #DDDDDD;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  background: #F6F4F0;
}

.logo-img {
  width: 100%;
  height: 100%;
}

.logo-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #948F89;
}

.logo-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.logo-text {
  font-size: 22rpx;
}

.logo-hint {
  font-size: 24rpx;
  color: #948F89;
  margin-top: 12rpx;
}

.picker-wrap {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #F6F4F0;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
}

.picker-value {
  color: #2D2A26;
}

.picker-value.placeholder {
  color: #948F89;
}

.picker-arrow {
  color: #948F89;
  font-size: 36rpx;
}

.textarea-wrap {
  position: relative;
  background: #F6F4F0;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
}

.textarea-field {
  width: 100%;
  font-size: 28rpx;
  color: #2D2A26;
  min-height: 120rpx;
  box-sizing: border-box;
}

.char-count {
  display: block;
  text-align: right;
  font-size: 24rpx;
  color: #948F89;
  margin-top: 8rpx;
}

.tag-options {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.tag-option {
  padding: 12rpx 24rpx;
  background: #F6F4F0;
  border-radius: 24rpx;
  font-size: 26rpx;
  color: #5E5953;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.tag-option.selected {
  background: #E8F0FE;
  color: #4A8C5C;
  border-color: #4A8C5C;
}

.add-tag-row {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.add-tag-row .input-field.small {
  flex: 1;
}

.btn-add-tag {
  padding: 16rpx 32rpx;
  background: #4A8C5C;
  color: #FFFFFF;
  border-radius: 12rpx;
  font-size: 26rpx;
}

.submit-section {
  padding: 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.btn-primary {
  background: #4A8C5C;
  color: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
}

.btn-primary.disabled {
  opacity: 0.5;
}
