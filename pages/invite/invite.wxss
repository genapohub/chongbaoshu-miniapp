/* 邀请好友页 - 样式 */
.invite-page {
  min-height: 100vh;
  background: #F5F7FA;
  padding-bottom: 60rpx;
}

/* 顶部横幅 */
.banner {
  background: var(--green);
  padding: 60rpx 30rpx 50rpx;
  text-align: center;
}

.banner-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.banner-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 12rpx;
}

.banner-subtitle {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}

/* 邀请码卡片 */
.code-card {
  margin: -30rpx 30rpx 24rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 36rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
}

.card-label {
  font-size: 26rpx;
  color: #948F89;
  text-align: center;
  margin-bottom: 20rpx;
}

.invite-code {
  font-size: 56rpx;
  font-weight: 700;
  color: #4A8C5C;
  text-align: center;
  letter-spacing: 8rpx;
  font-family: 'Courier New', monospace;
  margin-bottom: 32rpx;
}

.btn-row {
  display: flex;
  gap: 20rpx;
}

.btn-copy, .btn-share {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 28rpx;
  font-weight: 500;
  border: 2rpx solid #4A8C5C;
  margin: 0;
  padding: 0;
  background: #fff;
  color: #4A8C5C;
}

.btn-share {
  background: #4A8C5C;
  color: #fff;
  border: none;
}

/* 弱化统计区 */
.stats-section {
  margin: 0 30rpx 24rpx;
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 32rpx;
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-item .stat-value {
  font-size: 36rpx;
  font-weight: 600;
  color: #374151;
}

.stat-item .stat-label {
  font-size: 24rpx;
  color: #948F89;
  margin-top: 6rpx;
}

.stat-divider {
  width: 2rpx;
  height: 48rpx;
  background: #E5E7EB;
}

/* 累计奖励 */
.reward-section {
  margin: 24rpx 30rpx;
  background: var(--bg);
  border-radius: 20rpx;
  padding: 36rpx;
  text-align: center;
}

.reward-label {
  font-size: 26rpx;
  color: #948F89;
  margin-bottom: 12rpx;
}

.reward-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #7C3AED;
  margin-bottom: 8rpx;
}

.reward-hint {
  font-size: 24rpx;
  color: #948F89;
}

/* 邀请记录 */
.records-section {
  margin: 0 30rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
}

.section-header {
  display: flex;
  align-items: center;
  margin-bottom: 28rpx;
}

.section-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #374151;
}

.record-list {
  display: flex;
  flex-direction: column;
}

.record-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #EDEDEF;
}

.record-item:last-child {
  border-bottom: none;
}

.record-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #E1EAFF;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
  overflow: hidden;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.avatar-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #EC4899;
}

.record-info {
  flex: 1;
}

.record-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #2D2A26;
}

.record-time {
  font-size: 26rpx;
  color: #948F89;
  margin-top: 8rpx;
}

.record-badge {
  font-size: 24rpx;
  font-weight: 500;
  padding: 10rpx 20rpx;
  border-radius: 24rpx;
  flex-shrink: 0;
}

.record-badge.badge-success {
  background: #E8F8F0;
  color: #3D8B37;
}

.record-badge.badge-default {
  background: #F3F4F6;
  color: #5E5953;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 60rpx 0;
}

.empty-state .empty-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.empty-state .empty-text {
  font-size: 28rpx;
  color: #948F89;
  margin-bottom: 8rpx;
}

.empty-state .empty-hint {
  font-size: 24rpx;
  color: #C0C4CC;
}

/* 加载更多 */
.load-more {
  text-align: center;
  padding: 20rpx;
  font-size: 24rpx;
  color: #948F89;
}
