/* 邀请好友页 - 样式 */
.invite-page {
  min-height: 100vh;
  background: #F5F7FA;
  padding-bottom: 60rpx;
}

/* 顶部横幅 */
.banner {
  background: linear-gradient(135deg, #00C9A7, #00B894);
  padding: 60rpx 30rpx 50rpx;
  text-align: center;
}

.banner-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.banner-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 12rpx;
}

.banner-subtitle {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}

/* 邀请码卡片 */
.code-card {
  margin: -30rpx 30rpx 24rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 36rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
}

.card-label {
  font-size: 26rpx;
  color: #9CA3AF;
  text-align: center;
  margin-bottom: 20rpx;
}

.invite-code {
  font-size: 56rpx;
  font-weight: 700;
  color: #E94560;
  text-align: center;
  letter-spacing: 8rpx;
  font-family: 'Courier New', monospace;
  margin-bottom: 32rpx;
}

.btn-row {
  display: flex;
  gap: 20rpx;
}

.btn-copy, .btn-share {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 28rpx;
  font-weight: 500;
  border: 2rpx solid #E94560;
  margin: 0;
  padding: 0;
  background: #fff;
  color: #E94560;
}

.btn-share {
  background: #E94560;
  color: #fff;
  border: none;
}

/* 弱化统计区 */
.stats-section {
  margin: 0 30rpx 24rpx;
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 32rpx;
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-item .stat-value {
  font-size: 36rpx;
  font-weight: 600;
  color: #374151;
}

.stat-item .stat-label {
  font-size: 24rpx;
  color: #9CA3AF;
  margin-top: 6rpx;
}

.stat-divider {
  width: 2rpx;
  height: 48rpx;
  background: #E5E7EB;
}

/* 邀请记录 */
.records-section {
  margin: 0 30rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
}

.section-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #374151;
}

.record-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.record-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F3F4F6;
}

.record-item:last-child {
  border-bottom: none;
}

.record-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #E94560;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.avatar-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
}

.record-info {
  flex: 1;
}

.record-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #374151;
}

.record-time {
  font-size: 24rpx;
  color: #9CA3AF;
  margin-top: 6rpx;
}

.record-badge {
  background: #D1FAE5;
  color: #059669;
  font-size: 24rpx;
  font-weight: 500;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 60rpx 0;
}

.empty-state .empty-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.empty-state .empty-text {
  font-size: 28rpx;
  color: #9CA3AF;
  margin-bottom: 8rpx;
}

.empty-state .empty-hint {
  font-size: 24rpx;
  color: #D1D5DB;
}

/* 加载更多 */
.load-more {
  text-align: center;
  padding: 20rpx;
  font-size: 24rpx;
  color: #9CA3AF;
}

/* 累计奖励 */
.reward-section {
  margin: 24rpx 30rpx;
  background: linear-gradient(135deg, #EDE9FE, #DDD6FE);
  border-radius: 20rpx;
  padding: 36rpx;
  text-align: center;
}

.reward-label {
  font-size: 26rpx;
  color: #9CA3AF;
  margin-bottom: 12rpx;
}

.reward-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #7C3AED;
  margin-bottom: 8rpx;
}

.reward-hint {
  font-size: 24rpx;
  color: #9CA3AF;
}