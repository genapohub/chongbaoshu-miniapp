<!-- 邀请好友页 - 模板 -->
<view class="invite-page">

  <!-- 顶部横幅 -->
  <view class="banner">
    <view class="banner-icon">🎁</view>
    <view class="banner-title">邀请好友，双方各得7天Pro</view>
    <view class="banner-subtitle">每成功邀请1人注册，额外获得7天Pro会员</view>
  </view>

  <!-- 邀请码卡片 -->
  <view class="code-card">
    <view class="card-label">我的邀请码</view>
    <view class="invite-code">{{inviteCode || '加载中...'}}</view>
    <view class="btn-row">
      <button class="btn-copy" bindtap="onCopyCode">复制邀请码</button>
      <button class="btn-share" open-type="share">分享给好友</button>
    </view>
  </view>

  <!-- 弱化统计区 -->
  <view class="stats-section">
    <view class="stat-item">
      <view class="stat-value">{{stats.total_invites}}</view>
      <view class="stat-label">邀请人数</view>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <view class="stat-value">{{stats.redeemed_invites}}</view>
      <view class="stat-label">已兑换</view>
    </view>
  </view>
<!-- 累计奖励 -->
<view class="reward-section">
    <view class="reward-label">已累计获得</view>
    <view class="reward-value">{{stats.total_reward_days}}天 Pro会员</view>
    <view class="reward-hint">邀请{{stats.redeemed_invites}}人 · 继续邀请可叠加</view>
  </view>
  <!-- 邀请记录 -->
  <view class="records-section">
    <view class="section-header">
      <text class="section-icon">📋</text>
      <text class="section-title">邀请记录</text>
    </view>

    <view wx:if="{{records.length > 0}}" class="record-list">
      <view class="record-item" wx:for="{{records}}" wx:key="id">
        <view class="record-avatar">
          <image wx:if="{{item.invitee_avatar}}" class="avatar-img" src="{{item.invitee_avatar}}" mode="aspectFill" lazy-load />
          <text wx:else class="avatar-text">{{item.avatarText}}</text>
        </view>
        <view class="record-info">
          <view class="record-name">{{item.invitee_nickname || '新用户'}}</view>
          <view class="record-time">{{item.formattedDate}}</view>
        </view>
        <view class="record-badge {{item.statusClass}}">{{item.statusBadge}}</view>
      </view>
    </view>

    <view class="empty-state" wx:elif="{{!loading}}">
      <view class="empty-icon">🔗</view>
      <view class="empty-text">还没有邀请记录</view>
      <view class="empty-hint">快去邀请好友吧</view>
    </view>
    <view class="load-more" wx:if="{{loading}}">加载中...</view>
    <view class="load-more" wx:elif="{{!hasMore && records.length > 0}}">没有更多了</view>
  </view>
</view>
