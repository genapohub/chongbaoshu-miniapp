<!--
  P16 手机号登录页 - 按设计稿一比一复刻
-->
<view class="phone-login-page">
  <view class="header">
    <view class="back-btn" bindtap="goBack">
      <text class="back-icon">←</text>
    </view>
    <view class="header-title">手机号登录</view>
  </view>

  <view class="content">
    <view class="form-title">请输入手机号</view>
    <view class="form-subtitle">我们将发送验证码进行验证</view>

    <view class="phone-input-wrapper">
      <view class="country-code">
        <text class="country-flag">🇨🇳</text>
        <text class="code-text">+86</text>
      </view>
      <input
        class="phone-input"
        type="number"
        placeholder="请输入手机号"
        maxlength="11"
        value="{{phone}}"
        bindinput="onPhoneInput"
        placeholder-class="placeholder"
      />
    </view>

    <view class="code-input-wrapper">
      <input
        class="code-input"
        type="number"
        placeholder="请输入验证码"
        maxlength="6"
        value="{{code}}"
        bindinput="onCodeInput"
        placeholder-class="placeholder"
      />
      <view
        class="send-code-btn {{counting ? 'counting' : ''}}"
        bindtap="sendCode"
      >
        <text wx:if="{{counting}}">{{countdown}}s</text>
        <text wx:else>获取验证码</text>
      </view>
    </view>

    <button
      class="login-btn {{canLogin ? 'active' : ''}}"
      bindtap="onLogin"
      disabled="{{!canLogin || loading}}"
    >
      <text wx:if="{{loading}}">登录中...</text>
      <text wx:else>登录</text>
    </button>

    <view class="terms">
      登录即表示同意
      <text class="link" bindtap="openTerms">《用户协议》</text>
      和
      <text class="link" bindtap="openPrivacy">《隐私政策》</text>
    </view>

    <view class="dev-hint" wx:if="{{devMode}}">
      <text class="dev-hint-icon">🛠</text>
      <text>开发模式：输入任意手机号 + 验证码 123456 即可登录</text>
    </view>
  </view>
</view>
