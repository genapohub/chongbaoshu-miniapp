/* 手机号登录 — 暖森林品牌 */

.phone-login-page {
  min-height: 100vh;
  background: var(--bg);
  display: flex;
  flex-direction: column;
}

.header {
  height: 88rpx;
  padding: 0 32rpx;
  display: flex;
  align-items: center;
  position: relative;
}

.back-btn {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  position: absolute;
  left: 32rpx;
  top: 50%;
  transform: translateY(-50%);
}

.header-title {
  flex: 1;
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text);
}

.content {
  flex: 1;
  padding: 64rpx 48rpx 48rpx;
  display: flex;
  flex-direction: column;
}

.form-title {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 16rpx;
}

.form-subtitle {
  font-size: 28rpx;
  color: var(--text2);
  margin-bottom: 64rpx;
}

.phone-input-wrapper {
  display: flex;
  align-items: center;
  height: 96rpx;
  border: 2rpx solid var(--line);
  border-radius: var(--radius);
  padding: 0 24rpx;
  margin-bottom: 24rpx;
  background: var(--surface-solid);
}

.phone-input-wrapper:focus-within {
  border-color: var(--green);
}

.country-code {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding-right: 24rpx;
  border-right: 2rpx solid var(--line);
  margin-right: 24rpx;
}

.country-flag { font-size: 36rpx; }

.code-text {
  font-size: 28rpx;
  color: var(--text);
  font-weight: 500;
}

.phone-input {
  flex: 1;
  height: 100%;
  font-size: 28rpx;
  color: var(--text);
}

.placeholder { color: var(--text3); }

.code-input-wrapper {
  display: flex;
  align-items: center;
  height: 96rpx;
  border: 2rpx solid var(--line);
  border-radius: var(--radius);
  padding: 0 24rpx;
  margin-bottom: 64rpx;
  background: var(--surface-solid);
}

.code-input-wrapper:focus-within {
  border-color: var(--green);
}

.code-input {
  flex: 1;
  height: 100%;
  font-size: 28rpx;
  color: var(--text);
}

.send-code-btn {
  padding: 16rpx 32rpx;
  background: var(--green);
  border-radius: var(--radius-sm);
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
  white-space: nowrap;
}

.send-code-btn.counting {
  background: rgba(0,0,0,0.06);
  color: var(--text3);
}

.login-btn {
  height: 96rpx;
  border-radius: 48rpx;
  background: rgba(0,0,0,0.06);
  color: var(--text3);
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  line-height: 96rpx;
  padding: 0;
  margin: 0;
}

.login-btn.active {
  background: var(--green);
  color: #fff;
}

.login-btn::after { border: none; }

.terms {
  margin-top: 48rpx;
  font-size: 24rpx;
  color: var(--text3);
  text-align: center;
  line-height: 1.6;
}

.terms .link { color: var(--green); }

.dev-hint {
  margin-top: 32rpx;
  padding: 20rpx 24rpx;
  background: rgba(212,145,74,0.1);
  border-radius: var(--radius-sm);
  font-size: 24rpx;
  color: var(--amber);
  display: flex;
  align-items: center;
  gap: 8rpx;
}
