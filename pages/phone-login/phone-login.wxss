.phone-login-page {
  min-height: 100vh;
  background: #ffffff;
  display: flex;
  flex-direction: column;
}

.header {
  height: 88rpx;
  padding: 0 32rpx;
  display: flex;
  align-items: center;
  position: relative;
}

.back-btn {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  position: absolute;
  left: 32rpx;
  top: 50%;
  transform: translateY(-50%);
}

.back-icon {
  font-size: 48rpx;
  color: #212529;
  font-weight: 300;
}

.header-title {
  flex: 1;
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
  color: #212529;
}

.content {
  flex: 1;
  padding: 64rpx 48rpx 48rpx;
  display: flex;
  flex-direction: column;
}

.form-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #212529;
  margin-bottom: 16rpx;
}

.form-subtitle {
  font-size: 28rpx;
  color: #6C757D;
  margin-bottom: 64rpx;
}

.phone-input-wrapper {
  display: flex;
  align-items: center;
  height: 96rpx;
  border: 2rpx solid #E9ECEF;
  border-radius: 16rpx;
  padding: 0 24rpx;
  margin-bottom: 24rpx;
  background: #ffffff;
}

.country-code {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding-right: 24rpx;
  border-right: 2rpx solid #E9ECEF;
  margin-right: 24rpx;
}

.country-flag {
  font-size: 36rpx;
}

.code-text {
  font-size: 28rpx;
  color: #212529;
  font-weight: 500;
}

.phone-input {
  flex: 1;
  height: 100%;
  font-size: 28rpx;
  color: #212529;
}

.placeholder {
  color: #ADB5BD;
}

.code-input-wrapper {
  display: flex;
  align-items: center;
  height: 96rpx;
  border: 2rpx solid #E9ECEF;
  border-radius: 16rpx;
  padding: 0 24rpx;
  margin-bottom: 64rpx;
  background: #ffffff;
}

.code-input {
  flex: 1;
  height: 100%;
  font-size: 28rpx;
  color: #212529;
}

.send-code-btn {
  padding: 16rpx 32rpx;
  background: linear-gradient(135deg, #4A8C5C, #5B8DEF);
  border-radius: 12rpx;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 500;
  white-space: nowrap;
  transition: all 0.3s ease;
}

.send-code-btn.counting {
  background: #E9ECEF;
  color: #ADB5BD;
}

.login-btn {
  height: 96rpx;
  border-radius: 16rpx;
  background: #E9ECEF;
  color: #ADB5BD;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  line-height: 96rpx;
  padding: 0;
  margin: 0;
}

.login-btn.active {
  background: linear-gradient(135deg, #4A8C5C, #5B8DEF);
  color: #ffffff;
}

.login-btn::after {
  border: none;
}

.terms {
  margin-top: 48rpx;
  font-size: 24rpx;
  color: #6C757D;
  text-align: center;
  line-height: 1.6;
}

.terms .link {
  color: #4A8C5C;
}

.dev-hint {
  margin-top: 32rpx;
  padding: 20rpx 24rpx;
  background: #FFF3E0;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #E65100;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.dev-hint-icon {
  font-size: 28rpx;
}
