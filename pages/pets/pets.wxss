/* 宠物列表 */

.container { min-height: 100vh; background: var(--bg); padding: 16rpx; padding-bottom: 160rpx; }

/* 搜索栏 */
.search { display: flex; align-items: center; background: var(--surface); border-radius: var(--radius); padding: 16rpx 24rpx; margin-bottom: 20rpx; box-shadow: var(--shadow); }
.search-input { border: none; outline: none; font-size: 28rpx; flex: 1; margin-left: 14rpx; background: transparent; }
.search-placeholder { color: var(--text3); }

/* 筛选Tab */
.filters { display: flex; gap: 16rpx; margin-bottom: 20rpx; white-space: nowrap; }
.filter-tab { display: inline-flex; align-items: center; padding: 14rpx 28rpx; border-radius: 40rpx; font-size: 26rpx; background: var(--surface); color: var(--text2); border: 2rpx solid var(--line); }
.filter-tab.active { background: var(--green); color: #fff; border-color: var(--green); }

/* 宠物列表 */
.pet-list { display: flex; flex-direction: column; gap: 16rpx; }
.pet-card { display: flex; align-items: center; gap: 24rpx; padding: 24rpx; background: var(--surface); border-radius: var(--radius); box-shadow: var(--shadow); }
.pet-avatar { width: 104rpx; height: 104rpx; border-radius: var(--radius); background: var(--bg); display: flex; align-items: center; justify-content: center; flex-shrink: 0; overflow: hidden; }
.avatar-img { width: 100%; height: 100%; border-radius: var(--radius); }
.pet-info { flex: 1; min-width: 0; }
.pet-name-row { display: flex; align-items: center; gap: 10rpx; }
.pet-name { font-size: 30rpx; font-weight: 600; }
.pet-desc { font-size: 24rpx; color: var(--text3); margin-top: 4rpx; }

.sale-price-badge { display: inline-block; padding: 4rpx 14rpx; background: #FDEDEC; color: var(--red); font-size: 22rpx; font-weight: 700; border-radius: 6rpx; margin-left: auto; }

/* 限额提示 */
.limit-hint { background: var(--bg); border-radius: var(--radius); padding: 20rpx 24rpx; display: flex; align-items: center; justify-content: space-between; margin-top: 16rpx; }
.limit-text { font-size: 26rpx; color: var(--green); font-weight: 600; }
.limit-btn { background: var(--green); color: #fff; padding: 12rpx 24rpx; border-radius: 24rpx; font-size: 24rpx; font-weight: 600; }

/* 空状态 */
.empty-state { display: flex; flex-direction: column; align-items: center; padding: 120rpx 0; }

/* FAB */
.fab { position: fixed; bottom: 140rpx; right: 32rpx; width: 96rpx; height: 96rpx; border-radius: 50%; background: var(--green); display: flex; align-items: center; justify-content: center; box-shadow: 0 8rpx 24rpx rgba(74,140,92,0.35); z-index: 10; }
