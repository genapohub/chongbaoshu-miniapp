.pet-page { padding: var(--sp-lg); padding-bottom: 200rpx; }

.search-bar {
  display: flex; align-items: center;
  background: var(--surface); border-radius: var(--radius-full);
  padding: 20rpx 32rpx; margin-bottom: var(--sp-lg);
  box-shadow: var(--shadow);
}
.search-icon { font-size: 32rpx; color: var(--text3); margin-right: 16rpx; }
.search-input { flex: 1; font-size: 28rpx; background: transparent; border: none; }
.search-placeholder { color: var(--text3); }

.filter-scroll { white-space: nowrap; margin-bottom: var(--sp-lg); }
.filter-item {
  display: inline-flex; align-items: center;
  padding: 16rpx 32rpx; border-radius: var(--radius-full);
  font-size: 26rpx; color: var(--text2); background: var(--surface);
  margin-right: 16rpx; border: 2rpx solid transparent;
}
.filter-item.active {
  background: var(--green); color: #fff;
}

.pet-list { display: flex; flex-direction: column; gap: var(--sp-md); }
.pet-card {
  display: flex; align-items: center; gap: var(--sp-lg);
  background: var(--surface); border-radius: var(--radius);
  padding: var(--sp-lg); box-shadow: var(--shadow);
}
.pet-avatar-wrap {
  width: 120rpx; height: 120rpx; border-radius: var(--radius-sm);
  overflow: hidden; flex-shrink: 0; background: rgba(0,0,0,0.03);
}
.pet-avatar { width: 100%; height: 100%; }
.pet-avatar-placeholder {
  width: 100%; height: 100%; display: flex; align-items: center; justify-content: center;
  font-size: 48rpx;
}
.pet-info { flex: 1; min-width: 0; }
.pet-name-row { display: flex; align-items: center; justify-content: space-between; }
.pet-name { font-size: 32rpx; font-weight: 700; color: var(--text); }
.price-tag { font-size: 26rpx; font-weight: 700; color: var(--red); }
.pet-desc { font-size: 24rpx; color: var(--text3); margin-top: 8rpx; display: block; }
.pet-arrow { font-size: 32rpx; color: var(--text3); flex-shrink: 0; }
