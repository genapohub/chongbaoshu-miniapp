<view class="pet-page">
  <view class="hero pets-hero">
    <view class="decor-ring ph1"></view>
    <view class="decor-ring ph2"></view>
    <view class="pets-hero-inner">
      <text class="pets-title">我的宠物</text>
      <text class="pets-sub">建档管理你的繁育伙伴</text>
    </view>
  </view>

  <view class="pets-body">
    <view class="search-bar">
      <text class="search-icon">🔍</text>
      <input class="search-input" placeholder="搜索宠物名称…" placeholder-class="search-placeholder" value="{{searchKeyword}}" bindinput="onSearch" />
    </view>

    <scroll-view class="filter-scroll" scroll-x enable-flex>
      <view wx:for="{{filterTabs}}" wx:key="key" class="filter-item {{currentFilter === item.key ? 'active' : ''}}" data-key="{{item.key}}" bindtap="onFilterTab">
        <text>{{item.icon}} {{item.label}}</text>
      </view>
    </scroll-view>

    <view class="pet-list">
      <view wx:for="{{petList}}" wx:key="id" class="pet-card" bindtap="goPetDetail" data-id="{{item.id}}">
        <view class="pet-avatar-wrap">
          <image wx:if="{{item.avatar}}" class="pet-avatar" src="{{item.avatar}}" mode="aspectFill" />
          <view wx:else class="pet-avatar-placeholder">{{item.speciesIcon}}</view>
        </view>
        <view class="pet-info">
          <view class="pet-name-row">
            <text class="pet-name">{{item.name}}</text>
            <text wx:if="{{item.is_for_sale && item.price}}" class="price-tag">¥{{item.price / 100}}</text>
          </view>
          <text class="pet-desc">{{item.speciesLabel}} · {{item.genderLabel}} · {{item.age}}</text>
        </view>
        <text class="pet-arrow">→</text>
      </view>
    </view>

    <empty-state wx:if="{{petList.length === 0 && !loading}}" icon="paw" text="{{!userInfo ? '登录后即可管理宠物' : '还没有宠物，添加第一只吧'}}" />
    <view wx:if="{{showLoginGuide}}" class="btn btn-green btn-block" style="margin: 24rpx 32rpx; width: auto;" bindtap="goLogin">微信登录</view>
  </view>

  <view class="fab-btn" bindtap="goAddPet">+</view>
</view>
