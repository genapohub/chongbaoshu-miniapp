page {
  background: #F5F5F5;
  min-height: 100vh;
}

.container {
  min-height: 100vh;
  padding-bottom: 140rpx;
}

.content {
  padding: 20rpx;
}

.section-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #2D2A26;
}

.reminder-section {
  background: #FDEDEC;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  border: 2rpx solid #FECACA;
}

.reminder-list {
  margin-top: 8rpx;
}

.reminder-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #FECACA;
}

.reminder-item:last-child {
  border-bottom: none;
}

.reminder-info {
  flex: 1;
}

.reminder-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #DC2626;
  margin-bottom: 4rpx;
}

.reminder-desc {
  font-size: 24rpx;
  color: #948F89;
}

.reminder-action {
  margin-left: 16rpx;
}

.reminder-btn {
  padding: 12rpx 24rpx;
  background: #DC2626;
  color: #FFFFFF;
  font-size: 24rpx;
  border-radius: 20rpx;
}

.record-section {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.record-list {
  margin-top: 8rpx;
}

.record-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #EDEDEF;
}

.record-item:last-child {
  border-bottom: none;
}

.record-main {
  flex: 1;
}

.record-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #2D2A26;
  margin-bottom: 6rpx;
}

.record-date {
  font-size: 24rpx;
  color: #948F89;
}

.record-meta {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  margin-left: 16rpx;
}

.record-badge {
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.record-badge.red {
  background: #FEF2F2;
  color: #DC2626;
}

.record-badge.orange {
  background: #FFF7ED;
  color: #EA580C;
}

.record-badge.green {
  background: #E8F8F0;
  color: #3D8B37;
}

.record-next {
  font-size: 22rpx;
  color: #948F89;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #5E5953;
  margin-bottom: 8rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: #948F89;
}

.bottom-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  padding: 20rpx;
  background: #FFFFFF;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.08);
  gap: 20rpx;
}

.action-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.action-btn .btn-icon {
  font-size: 32rpx;
  margin-right: 8rpx;
}

.action-btn .btn-text {
  color: #FFFFFF;
}

.vaccine-btn {
  background: var(--red);
}

.deworm-btn {
  background: var(--amber);
}