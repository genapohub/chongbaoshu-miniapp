/* 健康档案详情页 — 暖森林·毛玻璃 */
.container {
  min-height: 100vh;
  background: var(--bg);
  padding: 32rpx 32rpx 200rpx;
  box-sizing: border-box;
}

.content {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

/* 区段通用 */
.reminder-section,
.record-section {
  background: var(--surface);
  -webkit-backdrop-filter: var(--glass);
  backdrop-filter: var(--glass);
  border-radius: var(--radius);
  padding: 32rpx;
  box-shadow: var(--shadow);
}

.section-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.section-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: var(--radius-sm);
  background: rgba(0, 0, 0, 0.04);
  display: flex;
  align-items: center;
  justify-content: center;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
  letter-spacing: 0.5rpx;
}

/* 待处理提醒 */
.reminder-section {
  background: linear-gradient(135deg, rgba(244, 165, 86, 0.08), var(--surface));
}

.reminder-list {
  display: flex;
  flex-direction: column;
}

.reminder-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.reminder-item:last-child {
  border-bottom: none;
}

.reminder-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

.reminder-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text);
}

.reminder-desc {
  font-size: 24rpx;
  color: var(--amber);
  letter-spacing: 0.4rpx;
}

.reminder-action {
  margin-left: 16rpx;
}

.reminder-btn {
  padding: 12rpx 28rpx;
  background: var(--amber);
  color: #fff;
  font-size: 24rpx;
  border-radius: var(--radius-full);
  font-weight: 500;
  letter-spacing: 0.4rpx;
}

.reminder-btn:active {
  opacity: 0.85;
}

/* 记录列表 */
.record-list {
  display: flex;
  flex-direction: column;
}

.record-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--line);
  gap: 16rpx;
}

.record-item:last-child {
  border-bottom: none;
}

.record-item:active {
  background: rgba(0, 0, 0, 0.02);
  border-radius: var(--radius-sm);
}

.record-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
}

.record-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text);
}

.record-date {
  font-size: 24rpx;
  color: var(--text3);
  letter-spacing: 0.3rpx;
}

.record-meta {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
  min-width: 0;
}

.record-badge {
  padding: 6rpx 20rpx;
  font-size: 22rpx;
  border-radius: var(--radius-full);
  background: rgba(0, 0, 0, 0.06);
  color: var(--text2);
  letter-spacing: 0.4rpx;
}

.record-badge.success {
  background: rgba(74, 140, 92, 0.12);
  color: var(--green-dark);
}

.record-badge.warning {
  background: rgba(212, 145, 74, 0.12);
  color: var(--amber);
}

.record-badge.danger {
  background: rgba(212, 83, 74, 0.12);
  color: var(--red);
}

.record-next {
  font-size: 22rpx;
  color: var(--text3);
  letter-spacing: 0.3rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
  gap: 16rpx;
}

.empty-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.04);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
}

.empty-text {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text2);
}

.empty-hint {
  font-size: 26rpx;
  color: var(--text3);
}

/* 底部操作按钮 */
.bottom-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 20rpx;
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  background: var(--surface-solid);
  box-shadow: 0 -4rpx 32rpx rgba(0, 0, 0, 0.06);
  z-index: 10;
}

.action-btn {
  flex: 1;
  height: 96rpx;
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
  letter-spacing: 0.6rpx;
}

.action-btn:active {
  opacity: 0.88;
}

.vaccine-btn {
  background: linear-gradient(135deg, #4A8C5C, var(--green-dark));
}

.deworm-btn {
  background: linear-gradient(135deg, var(--amber), #B5763A);
}

.btn-text {
  color: #fff;
  font-size: 28rpx;
}
