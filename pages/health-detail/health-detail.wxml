<view class="container">
  <loading-spinner wx:if="{{loading}}" />
  
  <view wx:elif="{{!loading}}" class="content">
    <view class="reminder-section" wx:if="{{reminders.length > 0}}">
      <view class="section-header">
        <view class="section-icon"><icon name="alert-circle" size="36" color="#F54A45" /></view>
        <text class="section-title">待处理提醒</text>
      </view>
      <view class="reminder-list">
        <view class="reminder-item" wx:for="{{reminders}}" wx:key="id">
          <view class="reminder-info">
            <view class="reminder-name">{{item.name}}</view>
            <view class="reminder-desc">
              <text wx:if="{{item.daysLeft !== null}}">
                {{item.daysLeft < 0 ? '过期' + Math.abs(item.daysLeft) + '天' : '还有' + item.daysLeft + '天'}}
              </text>
              <text wx:else>{{item.date}}</text>
            </view>
          </view>
          <view class="reminder-action">
            <view class="reminder-btn" bindtap="goAddHealth">记录</view>
          </view>
        </view>
      </view>
    </view>

    <view class="record-section" wx:if="{{vaccineRecords.length > 0}}">
      <view class="section-header">
        <view class="section-icon"><icon name="syringe" size="36" color="#2D9CDB" /></view>
        <text class="section-title">疫苗记录</text>
      </view>
      <view class="record-list">
        <view class="record-item" wx:for="{{vaccineRecords}}" wx:key="id" bindtap="goEditRecord" data-id="{{item.id}}">
          <view class="record-main">
            <view class="record-name">{{item.name}}</view>
            <view class="record-date">{{item.date}} · {{item.vetHospital || '宠物医院'}}</view>
          </view>
          <view class="record-meta">
            <view class="record-badge {{item.statusType}}">{{item.status}}</view>
            <view class="record-next" wx:if="{{item.nextDate}}">下次: {{item.nextDate}}</view>
          </view>
        </view>
      </view>
    </view>

    <view class="record-section" wx:if="{{dewormRecords.length > 0}}">
      <view class="section-header">
        <view class="section-icon"><icon name="bug" size="36" color="#2BA471" /></view>
        <text class="section-title">驱虫记录</text>
      </view>
      <view class="record-list">
        <view class="record-item" wx:for="{{dewormRecords}}" wx:key="id" bindtap="goEditRecord" data-id="{{item.id}}">
          <view class="record-main">
            <view class="record-name">{{item.name}}</view>
            <view class="record-date">{{item.date}}</view>
          </view>
          <view class="record-meta">
            <view class="record-badge {{item.statusType}}">{{item.status}}</view>
            <view class="record-next" wx:if="{{item.nextDate}}">下次: {{item.nextDate}}</view>
          </view>
        </view>
      </view>
    </view>

    <view class="record-section" wx:if="{{otherRecords.length > 0}}">
      <view class="section-header">
        <view class="section-icon"><icon name="clipboard" size="36" color="#646A73" /></view>
        <text class="section-title">其他记录</text>
      </view>
      <view class="record-list">
        <view class="record-item" wx:for="{{otherRecords}}" wx:key="id" bindtap="goEditRecord" data-id="{{item.id}}">
          <view class="record-main">
            <view class="record-name">{{item.name}}</view>
            <view class="record-date">{{item.date}}</view>
          </view>
          <view class="record-meta">
            <view class="record-badge {{item.statusType}}">{{item.status}}</view>
          </view>
        </view>
      </view>
    </view>

    <view class="empty-state" wx:if="{{reminders.length === 0 && vaccineRecords.length === 0 && dewormRecords.length === 0 && otherRecords.length === 0}}">
      <view class="empty-icon"><icon name="clipboard" size="36" color="#646A73" /></view>
      <text class="empty-text">暂无健康记录</text>
      <text class="empty-hint">点击下方按钮添加记录</text>
    </view>
  </view>

  <view class="bottom-actions">
    <view class="action-btn vaccine-btn" bindtap="goRecordVaccine">
      <icon name="syringe" size="34" color="#FFFFFF" />
      <text class="btn-text">记录疫苗</text>
    </view>
    <view class="action-btn deworm-btn" bindtap="goRecordDeworm">
      <icon name="bug" size="34" color="#FFFFFF" />
      <text class="btn-text">记录驱虫</text>
    </view>
  </view>
</view>