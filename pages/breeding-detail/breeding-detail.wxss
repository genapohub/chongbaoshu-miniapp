.container {
  min-height: 100vh;
  background: #F8F9FA;
  padding: 24rpx;
}

.card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #212529;
}

.breeding-info {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.info-label {
  font-size: 28rpx;
  color: #6C757D;
}

.info-value {
  font-size: 28rpx;
  color: #212529;
  font-weight: 500;
}

.due-date {
  color: #E94560;
  font-weight: 600;
}

.notes-section {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #E9ECEF;
}

.notes-label {
  font-size: 26rpx;
  color: #6C757D;
  margin-bottom: 12rpx;
  display: block;
}

.notes-text {
  font-size: 28rpx;
  color: #212529;
  line-height: 1.6;
}

/* 状态卡片 */
.status-card .card-title {
  margin-bottom: 24rpx;
}

.status-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.status-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx;
  background: #F8F9FA;
  border-radius: 16rpx;
  border: 2rpx solid transparent;
  transition: all 0.2s ease;
}

.status-item.current {
  background: #FFF5F7;
  border-color: #E94560;
}

.status-item.disabled {
  opacity: 0.5;
}

.status-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}

.status-item.current .status-icon {
  background: #E94560;
  color: #FFFFFF;
}

.status-info {
  flex: 1;
}

.status-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #212529;
  display: block;
  margin-bottom: 4rpx;
}

.status-desc {
  font-size: 24rpx;
  color: #6C757D;
}

.status-check {
  font-size: 32rpx;
  color: #E94560;
  font-weight: 700;
}

.status-lock {
  font-size: 28rpx;
}

/* 徽章 */
.badge {
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.badge-gray {
  background: #E9ECEF;
  color: #6C757D;
}

.badge-orange {
  background: #FFF3E0;
  color: #F57C00;
}

.badge-green {
  background: #E8F5E9;
  color: #2E7D32;
}

.badge-red {
  background: #FFEBEE;
  color: #C62828;
}

/* 操作按钮 */
.action-section {
  display: flex;
  gap: 24rpx;
}

.btn {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  padding: 0;
}

.btn::after {
  border: none;
}

.btn-outline {
  background: #FFFFFF;
  color: #E94560;
  border: 2rpx solid #E94560;
}

.btn-danger {
  background: #E9ECEF;
  color: #C62828;
}
