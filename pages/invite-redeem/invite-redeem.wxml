<!-- 邀请码兑换页 - 模板 -->
<view class="redeem-page">

  <!-- 成功状态 -->
  <view class="result-section" wx:if="{{status === 'success'}}">
    <view class="result-icon success"><icon name="celebration" size="48" color="#2BA471" /></view>
    <view class="result-title">兑换成功！</view>
    <view class="result-desc">您已获得{{rewardDays}}天Pro体验</view>
    <button class="btn-action" bindtap="onGoHome">开始使用</button>
  </view>

  <!-- 错误状态 -->
  <view class="result-section" wx:elif="{{status === 'error'}}">
    <view class="result-icon error"><icon name="close" size="36" color="#F54A45" /></view>
    <view class="result-title">邀请码无效</view>
    <view class="result-desc">{{errorMessage || '该邀请码不存在或已过期，请确认后重试'}}</view>
    <button class="btn-action" bindtap="onReInput">重新输入</button>
  </view>

  <!-- 输入状态 -->
  <view class="form-section" wx:else>
    <view class="form-header">
      <view class="header-icon"><icon name="gift" size="36" color="#F54A45" /></view>
      <view class="header-title">输入邀请码</view>
      <view class="header-desc">兑换后双方各得7天Pro体验</view>
    </view>

    <view class="code-input-group">
      <input
        class="code-input"
        type="text"
        maxlength="8"
        placeholder="请输入邀请码"
        value="{{inviteCode}}"
        bindinput="onCodeInput"
      />
      <view class="btn-paste" bindtap="onPasteCode">粘贴</view>
    </view>

    <view class="error-msg" wx:if="{{errorMessage}}">{{errorMessage}}</view>

    <button
      class="btn-redeem"
      bindtap="onRedeem"
      disabled="{{loading || inviteCode.length !== 8}}"
      loading="{{loading}}"
    >
      {{loading ? '兑换中...' : '兑换'}}
    </button>

    <view class="tips">
      <view class="tip-title">使用说明</view>
      <view class="tip-item">1. 向好友获取邀请码</view>
      <view class="tip-item">2. 输入邀请码并点击兑换</view>
      <view class="tip-item">3. 兑换成功后Pro权益立即生效</view>
      <view class="tip-item">4. 每个用户仅可兑换一次邀请码</view>
    </view>
  </view>

</view>