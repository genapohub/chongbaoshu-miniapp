/* 邀请码兑换页 - 样式 */
.redeem-page {
  min-height: 100vh;
  background: #f5f5f5;
}

/* 成功状态 */
.success-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 60rpx;
  background: #fff;
  min-height: 100vh;
}

.success-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}

.success-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 16rpx;
}

.success-desc {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 60rpx;
}

.btn-home {
  width: 400rpx;
  height: 88rpx;
  line-height: 88rpx;
  background: #E94560;
  color: #fff;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 500;
  border: none;
}

/* 表单区 */
.form-section {
  padding: 60rpx 40rpx;
}

.form-header {
  text-align: center;
  margin-bottom: 60rpx;
  background: linear-gradient(135deg, #E94560, #C73650);
  margin: -40rpx -40rpx 60rpx;
  padding: 80rpx 40rpx 60rpx;
  border-radius: 0 0 40rpx 40rpx;
  color: #fff;
}

.header-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.header-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 12rpx;
}

.header-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* 输入框 */
.code-input-group {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 0 24rpx;
  height: 100rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.code-input {
  flex: 1;
  height: 100rpx;
  font-size: 36rpx;
  font-weight: 600;
  letter-spacing: 16rpx;
  color: #333;
}

.btn-paste {
  font-size: 28rpx;
  color: #E94560;
  padding: 10rpx 20rpx;
}

/* 错误信息 */
.error-msg {
  font-size: 24rpx;
  color: #E94560;
  margin-bottom: 20rpx;
  padding-left: 10rpx;
}

/* 兑换按钮 */
.btn-redeem {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: #E94560;
  color: #fff;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  margin-top: 20rpx;
}

.btn-redeem[disabled] {
  background: #ccc;
  color: #fff;
}

/* 使用说明 */
.tips {
  margin-top: 60rpx;
  padding: 30rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.tip-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

.tip-item {
  font-size: 24rpx;
  color: #666;
  line-height: 2;
}
