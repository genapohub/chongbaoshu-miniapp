/* 宠宝树品牌样式 — 暖森林·毛玻璃 */
.container { min-height: 100vh; background: var(--bg); padding: 32rpx; }
.card { background: var(--surface); border-radius: var(--radius); padding: 32rpx; margin-bottom: 24rpx; box-shadow: var(--shadow); -webkit-backdrop-filter: var(--glass); backdrop-filter: var(--glass); }
.card-title { font-size: 30rpx; font-weight: 600; color: var(--text); margin-bottom: 24rpx; letter-spacing: 0.5rpx; }
.btn-primary { background: var(--green); color: #fff; border-radius: 48rpx; font-size: 30rpx; font-weight: 600; text-align: center; padding: 26rpx 0; border: none; display: flex; align-items: center; justify-content: center; gap: 10rpx; }
.btn-primary::after { border: none; }
.btn-primary:active { opacity: 0.88; }
.btn-primary.disabled, .btn-primary[disabled] { opacity: 0.4; pointer-events: none; }
.btn-secondary { background: rgba(0,0,0,0.04); color: var(--text2); border-radius: 48rpx; font-size: 28rpx; text-align: center; padding: 22rpx 0; border: none; }
.btn-secondary::after { border: none; }
.form-item { margin-bottom: 28rpx; }
.form-label { display: block; font-size: 26rpx; color: var(--text2); margin-bottom: 12rpx; font-weight: 500; }
.input-field { background: rgba(0,0,0,0.03); border-radius: var(--radius-sm); padding: 22rpx 24rpx; font-size: 28rpx; border: 2rpx solid transparent; color: var(--text); width: 100%; box-sizing: border-box; min-height: 80rpx; }
.input-field:focus { border-color: var(--green); }
.input-field::placeholder { color: var(--text3); }
