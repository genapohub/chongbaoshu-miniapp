/* 添加宠物页面样式 - 页面特有样式，通用样式已提取到 app.wxss */

/* 头像上传 */
.avatar-upload {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: 2rpx dashed #DDDDDD;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  background: #F6F4F0;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.avatar-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #948F89;
}

.avatar-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.avatar-text {
  font-size: 22rpx;
}

/* 选择器包装已提取到 app.wxss */

/* 性别选择 */
.gender-options {
  display: flex;
  gap: 24rpx;
}

.gender-option {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  background: #F6F4F0;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #5E5953;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.gender-option.active {
  background: #E8F0FE;
  color: #4A8C5C;
  border-color: #4A8C5C;
}

/* 角色选项 */
.role-options {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.role-option {
  padding: 16rpx 28rpx;
  background: #F6F4F0;
  border-radius: 24rpx;
  font-size: 26rpx;
  color: #5E5953;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.role-option.active {
  background: #E8F0FE;
  color: #4A8C5C;
  border-color: #4A8C5C;
}

/* 血统信息区域 - card-header 已提取到 app.wxss */

.toggle-arrow {
  font-size: 36rpx;
  color: #948F89;
}

.pedigree-section {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #EEEEEE;
}

/* 标签选项 */
.tag-options {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.tag-option {
  padding: 12rpx 24rpx;
  background: #F6F4F0;
  border-radius: 24rpx;
  font-size: 26rpx;
  color: #5E5953;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.tag-option.selected {
  background: #E8F0FE;
  color: #4A8C5C;
  border-color: #4A8C5C;
}

/* 添加标签行 */
.add-tag-row {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.add-tag-row .input-field.small {
  flex: 1;
}

.btn-add-tag {
  padding: 16rpx 32rpx;
  background: #4A8C5C;
  color: #FFFFFF;
  border-radius: 12rpx;
  font-size: 26rpx;
}

