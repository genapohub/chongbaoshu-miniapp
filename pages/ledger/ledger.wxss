.container { background: #F6F4F0; min-height: 100vh; padding-bottom: 120rpx; }
.summary-card { background: #FFF; margin: 24rpx; border-radius: 16rpx; padding: 32rpx; }
.summary-row { display: flex; }
.summary-item { flex: 1; text-align: center; }
.s-label { font-size: 24rpx; color: #8F959E; }
.s-amount { font-size: 36rpx; font-weight: 700; margin-top: 8rpx; display: block; }
.summary-item.income .s-amount { color: #2BA471; }
.summary-item.expense .s-amount { color: #E34D59; }
.tabs { display: flex; background: #FFF; margin: 0 24rpx; border-radius: 12rpx; overflow: hidden; }
.tab { flex: 1; text-align: center; padding: 20rpx; font-size: 26rpx; color: #8F959E; }
.tab.active { background: #4A8C5C; color: #FFF; font-weight: 600; }
.entry-list { padding: 16rpx 24rpx; }
.entry-card { background: #FFF; border-radius: 12rpx; padding: 24rpx; margin-bottom: 12rpx; display: flex; justify-content: space-between; align-items: center; }
.entry-category { font-size: 28rpx; font-weight: 600; }
.entry-date { font-size: 22rpx; color: #B0B0B0; margin-top: 4rpx; }
.entry-desc { font-size: 24rpx; color: #8F959E; margin-top: 4rpx; }
.amount-income { font-size: 32rpx; font-weight: 700; color: #2BA471; }
.amount-expense { font-size: 32rpx; font-weight: 700; color: #E34D59; }
.empty { text-align: center; padding: 120rpx 0; }
.empty-text { font-size: 28rpx; color: #C0C4CC; }
.fab { position: fixed; right: 32rpx; bottom: 120rpx; width: 96rpx; height: 96rpx; border-radius: 48rpx; background: #4A8C5C; display: flex; align-items: center; justify-content: center; box-shadow: 0 8rpx 24rpx rgba(74,140,92,0.4); }
