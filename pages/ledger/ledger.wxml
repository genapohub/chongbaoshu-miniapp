<view class="page-hero">
  <view class="decor-ring r1"></view>
  <view class="decor-ring r2"></view>
  <text class="hero-title">收支账本</text>
  <text class="hero-sub">宠舍收入与支出明细</text>
</view>
<view class="container">
  <view class="summary-card">
    <view class="summary-row">
      <view class="summary-item income"><text class="s-label">收入</text><text class="s-amount">+¥{{summary.income_total || 0}}</text></view>
      <view class="summary-item expense"><text class="s-label">支出</text><text class="s-amount">-¥{{summary.expense_total || 0}}</text></view>
      <view class="summary-item net"><text class="s-label">结余</text><text class="s-amount" style="color:{{summary.net >= 0 ? 'var(--green)' : 'var(--red)'}}">{{summary.net >= 0 ? '¥' : '-¥'}}{{Math.abs(summary.net || 0)}}</text></view>
    </view>
  </view>

  <view class="tabs">
    <view class="tab {{tab==='all'?'active':''}}" bindtap="switchTab" data-tab="all">全部</view>
    <view class="tab {{tab==='income'?'active':''}}" bindtap="switchTab" data-tab="income">收入</view>
    <view class="tab {{tab==='expense'?'active':''}}" bindtap="switchTab" data-tab="expense">支出</view>
  </view>

  <view wx:if="{{entries.length===0}}" class="empty">
    <text class="empty-text">记录第一笔收入或支出</text>
  </view>

  <view wx:else class="entry-list">
    <view wx:for="{{entries}}" wx:key="id" class="entry-card">
      <view class="entry-left">
        <text class="entry-category">{{item.category}}</text>
        <text class="entry-date">{{item.entry_date}}</text>
        <text wx:if="{{item.description}}" class="entry-desc">{{item.description}}</text>
      </view>
      <text class="entry-amount {{item.entry_type==='income'?'amount-income':'amount-expense'}}">{{item.entry_type==='income'?'+':'-'}}¥{{item.amount/100}}</text>
    </view>
  </view>

  <view class="fab" bindtap="goAdd"><cbs-icon name="add" size="48" color="#FFF" /></view>
</view>
