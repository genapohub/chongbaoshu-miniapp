.onboarding { height: 100vh; background: var(--surface); display: flex; flex-direction: column; }
.swiper { flex: 1; }
.slide { display: flex; flex-direction: column; align-items: center; justify-content: center; height: 100%; padding: 0 64rpx; }
.slide-icon { margin-bottom: 48rpx; }
.slide-title { font-size: 40rpx; font-weight: 700; color: var(--text); margin-bottom: 24rpx; }
.slide-desc { font-size: 28rpx; color: var(--text3); text-align: center; line-height: 44rpx; white-space: pre-line; }
.actions { display: flex; align-items: center; justify-content: space-between; padding: 48rpx 48rpx 96rpx; }
.btn-skip { font-size: 28rpx; color: var(--text3); }
.btn-next { font-size: 28rpx; color: var(--green); font-weight: 600; padding: 16rpx 32rpx; border-radius: 40rpx; background: var(--bg); }
.btn-start { flex: 1; text-align: center; padding: 24rpx; background: var(--green); color: #fff; font-size: 32rpx; font-weight: 600; border-radius: 48rpx; }
