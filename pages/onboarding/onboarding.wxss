.onboarding { height: 100vh; background: #FFF; display: flex; flex-direction: column; }
.swiper { flex: 1; }
.slide { display: flex; flex-direction: column; align-items: center; justify-content: center; height: 100%; padding: 0 64rpx; }
.slide-icon { margin-bottom: 48rpx; }
.slide-title { font-size: 40rpx; font-weight: 700; color: #1A1A1A; margin-bottom: 24rpx; }
.slide-desc { font-size: 28rpx; color: #8F959E; text-align: center; line-height: 44rpx; white-space: pre-line; }
.actions { display: flex; align-items: center; justify-content: space-between; padding: 48rpx 48rpx 96rpx; }
.btn-skip { font-size: 28rpx; color: #B0B0B0; }
.btn-next { font-size: 28rpx; color: #4A8C5C; font-weight: 600; padding: 16rpx 32rpx; border-radius: 40rpx; background: #F0F7F2; }
.btn-start { flex: 1; text-align: center; padding: 24rpx; background: #4A8C5C; color: #FFF; font-size: 32rpx; font-weight: 600; border-radius: 48rpx; }
