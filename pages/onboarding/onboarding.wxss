.onboarding {
  height: 100vh;
  background: linear-gradient(180deg, #EDF4EF 0%, #D4E8DA 30%, #B8D4C0 70%, #9DC0A8 100%);
  display: flex;
  flex-direction: column;
  position: relative;
  overflow: hidden;
}

/* 装饰圆环 */
.bg-decor { position: absolute; top: 0; left: 0; right: 0; bottom: 0; pointer-events: none; }
.decor-circle { position: absolute; border-radius: 50%; border: 2rpx solid rgba(74,140,92,0.08); }
.c1 { width: 600rpx; height: 600rpx; top: -180rpx; right: -200rpx; }
.c2 { width: 400rpx; height: 400rpx; bottom: 120rpx; left: -100rpx; }
.c3 { width: 200rpx; height: 200rpx; top: 50%; right: -60rpx; margin-top: -100rpx; }

.swiper { flex: 1; }

.slide {
  display: flex; flex-direction: column; align-items: center;
  justify-content: center; height: 100%;
  padding: 0 80rpx; padding-top: 40rpx;
}

/* 图标圆环 */
.icon-ring {
  width: 180rpx; height: 180rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  margin-bottom: 56rpx;
  position: relative;
}
.icon-ring::before {
  content: ''; position: absolute;
  width: 220rpx; height: 220rpx; border-radius: 50%;
  border: 4rpx dashed currentColor; opacity: 0.18;
}
.ring-green { background: rgba(74,140,92,0.08); color: #4A8C5C; }
.ring-amber { background: rgba(212,145,74,0.08); color: #D4914A; }
.ring-red   { background: rgba(212,83,74,0.08);  color: #D4534A; }

/* 页码 */
.slide-num {
  font-size: 96rpx; font-weight: 900;
  color: rgba(74,140,92,0.06);
  position: absolute; top: 60rpx; right: 48rpx;
  letter-spacing: 2rpx;
}

.slide-title {
  font-size: 44rpx; font-weight: 800;
  color: #2D2A26; margin-bottom: 28rpx;
  letter-spacing: 1rpx; text-align: center;
}

.slide-desc {
  font-size: 28rpx; color: #5E5953;
  text-align: center; line-height: 48rpx;
  white-space: pre-line; max-width: 480rpx;
}

/* 底部操作区 */
.actions {
  display: flex; align-items: center; justify-content: space-between;
  padding: 40rpx 56rpx 100rpx;
  position: relative; z-index: 1;
}

.btn-skip {
  font-size: 28rpx; color: #5E5953;
  opacity: 0.6;
}

.btn-next {
  font-size: 28rpx; color: #4A8C5C;
  font-weight: 700;
  padding: 16rpx 36rpx;
  border-radius: 48rpx;
  background: rgba(74,140,92,0.08);
}

.btn-start {
  flex: 1; text-align: center;
  padding: 28rpx;
  background: #4A8C5C; color: #fff;
  font-size: 32rpx; font-weight: 700;
  border-radius: 52rpx;
  letter-spacing: 1rpx;
  box-shadow: 0 8rpx 24rpx rgba(74,140,92,0.30);
}
