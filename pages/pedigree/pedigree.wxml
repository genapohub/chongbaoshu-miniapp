<view class="page-hero">
  <view class="decor-ring r1"></view>
  <view class="decor-ring r2"></view>
  <text class="hero-title">血统树</text>
  <text class="hero-sub">三代血统可视化与近亲系数检测</text>
</view>
<view class="container">
  <view wx:if="{{!isPro}}" class="upgrade-popup">
    <view class="upgrade-header">
      <view class="upgrade-icon"><cbs-icon name="diamond" size="36" color="#4A8C5C" /></view>
      <view class="upgrade-title">解锁血统树</view>
      <view class="upgrade-desc">升级Pro查看完整血统可视化</view>
    </view>
    <view class="upgrade-btn" bindtap="goUpgrade">立即升级</view>
  </view>

  <view wx:else class="tree-container">
    <view class="tree-header">
      <text class="tree-title">血统树</text>
      <text class="tree-sub" wx:if="{{selectedPet}}">{{selectedPet.name}} · {{selectedPet.breed || selectedPet.species}}</text>
    </view>

    <scroll-view scroll-x scroll-y class="tree-scroll" wx:if="{{pedigreeData}}">
      <canvas type="2d" id="pedigreeCanvas" class="tree-canvas" style="width:{{canvasW}}px;height:{{canvasH}}px;"></canvas>
    </scroll-view>

    <view wx:else class="empty-tree">
      <text>选择一只宠物查看血统树</text>
    </view>
  </view>
</view>
