/* 宠宝树品牌样式 — 暖森林·毛玻璃 | pedigree */
.container {
  min-height: 100vh;
  background: var(--bg);
  padding: 32rpx;
  box-sizing: border-box;
}

/* ===== 升级解锁弹层 ===== */
.upgrade-popup {
  background: var(--surface);
  -webkit-backdrop-filter: var(--glass);
  backdrop-filter: var(--glass);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow);
  padding: 64rpx 40rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 80rpx;
}
.upgrade-header {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.upgrade-icon {
  width: 128rpx;
  height: 128rpx;
  border-radius: var(--radius-full);
  background: rgba(74,140,92,0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}
.upgrade-title {
  font-size: 38rpx;
  font-weight: 700;
  color: var(--text);
  letter-spacing: 1rpx;
  margin-bottom: 14rpx;
}
.upgrade-desc {
  font-size: 26rpx;
  color: var(--text2);
  line-height: 1.6;
}
.upgrade-btn {
  margin-top: 48rpx;
  width: 100%;
  height: 92rpx;
  border-radius: var(--radius-full);
  background: var(--green);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(74,140,92,0.28);
}
.upgrade-btn:active { opacity: 0.88; }

/* ===== 血统树主区域 ===== */
.tree-container {
  background: var(--surface);
  -webkit-backdrop-filter: var(--glass);
  backdrop-filter: var(--glass);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  padding: 32rpx;
  min-height: calc(100vh - 96rpx);
  box-sizing: border-box;
}
.tree-header {
  display: flex;
  flex-direction: column;
  margin-bottom: 28rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid var(--line);
}
.tree-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text);
  letter-spacing: 0.5rpx;
}
.tree-sub {
  font-size: 26rpx;
  color: var(--text2);
  margin-top: 10rpx;
}
.tree-scroll {
  width: 100%;
  height: 900rpx;
  border-radius: var(--radius-sm);
  overflow: hidden;
}
.tree-canvas {
  display: block;
}
.empty-tree {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 600rpx;
  color: var(--text3);
  font-size: 28rpx;
}
