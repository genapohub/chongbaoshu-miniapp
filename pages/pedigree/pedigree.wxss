.container {
  min-height: 100vh;
  background: #F5F5F5;
  padding: 0;
}

/* 有宠物时的升级弹窗 */
.upgrade-popup {
  background: linear-gradient(180deg, #FFF5F7 0%, #FFFFFF 100%);
  border: 2rpx solid #FFE4E8;
  border-radius: 24rpx;
  padding: 32rpx;
  margin: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(51, 112, 255, 0.08);
}

.upgrade-header {
  text-align: center;
  margin-bottom: 28rpx;
}

.upgrade-icon {
  width: 96rpx;
  height: 96rpx;
  background: linear-gradient(135deg, #4A8C5C 0%, #5B8DEF 100%);
  border-radius: 24rpx;
  margin: 0 auto 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
}

.upgrade-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #2D2A26;
  margin-bottom: 8rpx;
}

.upgrade-desc {
  font-size: 24rpx;
  color: #5E5953;
}

.upgrade-benefits {
  background: #FFF9FA;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.upgrade-benefits .benefit-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 10rpx 0;
}

.upgrade-benefits .benefit-item:not(:last-child) {
  border-bottom: 1rpx solid #FFE4E8;
}

.upgrade-benefits .benefit-check {
  width: 36rpx;
  height: 36rpx;
  background: linear-gradient(135deg, #4A8C5C 0%, #5B8DEF 100%);
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.upgrade-benefits .benefit-text {
  font-size: 26rpx;
  color: #5E5953;
}

.upgrade-action {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.upgrade-plan {
  flex: 1;
}

.upgrade-plan .plan-info {
  display: flex;
  flex-direction: column;
}

.upgrade-plan .plan-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #2D2A26;
}

.upgrade-plan .plan-price {
  font-size: 24rpx;
  color: #4A8C5C;
  font-weight: 600;
  margin-top: 4rpx;
}

.upgrade-btn {
  background: linear-gradient(135deg, #4A8C5C 0%, #5B8DEF 100%);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  padding: 20rpx 40rpx;
  border-radius: 40rpx;
  box-shadow: 0 4rpx 16rpx rgba(51, 112, 255, 0.3);
}

/* 章节标题 */
.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #2D2A26;
  margin: 20rpx 24rpx;
}

/* 宠物列表 */
.pet-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 0 24rpx;
}

.pet-item {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.06);
  transition: all 0.2s;
}

.pet-item.disabled {
  opacity: 0.5;
}

.pet-avatar {
  width: 104rpx;
  height: 104rpx;
  border-radius: 16rpx;
  background: #F3F4F6;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 16rpx;
}

.avatar-placeholder {
  font-size: 48rpx;
}

.pet-info {
  flex: 1;
  min-width: 0;
}

.pet-name {
  font-size: 30rpx;
  font-weight: 600;
}

.pet-desc {
  font-size: 24rpx;
  color: #948F89;
  margin-top: 6rpx;
}

.pet-arrow {
  color: #C0C4CC;
  font-size: 32rpx;
}

.pet-lock {
  font-size: 32rpx;
}

/* ============ 无宠物时的设计稿UI ============ */

/* 预览容器 */
.preview-container {
  position: relative;
  padding: 24rpx;
  padding-bottom: 48rpx;
}

/* 模糊预览背景 */
.preview-bg {
  background: #FFFDE7;
  border-radius: 24rpx;
  padding: 48rpx;
  overflow: hidden;
}

.preview-bg .preview-card {
  filter: blur(4px);
  opacity: 0.6;
  background: #fff;
  border-radius: 16rpx;
  padding: 48rpx 32rpx;
  text-align: center;
}

.preview-bg .preview-header {
  font-size: 28rpx;
  font-weight: 600;
  color: #2D2A26;
  margin-bottom: 24rpx;
}

.preview-bg .preview-body {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.preview-bg .preview-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #EDEDEF;
}

.preview-bg .preview-line {
  width: 180rpx;
  height: 12rpx;
  background: #E8E8E8;
  border-radius: 6rpx;
}

/* 锁定卡片 */
.lock-card {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -40%);
  background: linear-gradient(135deg, #4A8C5C 0%, #F87171 100%);
  border-radius: 24rpx;
  padding: 40rpx 56rpx;
  text-align: center;
  box-shadow: 0 16rpx 48rpx rgba(51, 112, 255, 0.4);
  z-index: 10;
}

.lock-icon {
  font-size: 56rpx;
  margin-bottom: 16rpx;
}

.lock-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 8rpx;
}

.lock-desc {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-bottom: 20rpx;
}

.lock-btn {
  background: #fff;
  color: #4A8C5C;
  font-size: 24rpx;
  font-weight: 600;
  padding: 14rpx 40rpx;
  border-radius: 28rpx;
  display: inline-block;
}

/* Pro专属权益 */
.benefits-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin: 0 24rpx 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.benefits-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #2D2A26;
  margin-bottom: 20rpx;
}

.benefits-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.benefit-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.benefit-check {
  font-size: 24rpx;
  color: #34D399;
  font-weight: 700;
  flex-shrink: 0;
}

.benefit-text {
  font-size: 26rpx;
  color: #5E5953;
}

/* 订阅方案 */
.plan-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin: 0 24rpx;
  border: 2rpx solid #4A8C5C;
  position: relative;
}

.plan-badge {
  position: absolute;
  top: -2rpx;
  right: -2rpx;
  background: #4A8C5C;
  color: #fff;
  font-size: 18rpx;
  font-weight: 600;
  padding: 6rpx 16rpx;
  border-radius: 0 14rpx 0 14rpx;
}

.plan-content {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.plan-icon-wrapper {
  width: 72rpx;
  height: 72rpx;
  background: #FFE4E8;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.plan-icon {
  font-size: 36rpx;
}

.plan-info {
  flex: 1;
}

.plan-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #2D2A26;
}

.plan-desc {
  font-size: 22rpx;
  color: #948F89;
  margin-top: 4rpx;
}

.plan-price {
  text-align: right;
}

.price-symbol {
  font-size: 22rpx;
  color: #4A8C5C;
  font-weight: 600;
}

.price-num {
  font-size: 34rpx;
  color: #4A8C5C;
  font-weight: 700;
}

.price-unit {
  font-size: 20rpx;
  color: #5E5953;
}
