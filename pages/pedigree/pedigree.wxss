.container { background: #F6F4F0; min-height: 100vh; }
.upgrade-popup { padding: 120rpx 48rpx; text-align: center; }
.upgrade-header { margin-bottom: 48rpx; }
.upgrade-icon { margin-bottom: 24rpx; }
.upgrade-title { font-size: 36rpx; font-weight: 700; color: #1A1A1A; }
.upgrade-desc { font-size: 26rpx; color: #8F959E; margin-top: 12rpx; }
.upgrade-btn { display: inline-block; padding: 24rpx 64rpx; background: #4A8C5C; color: #FFF; border-radius: 48rpx; font-size: 28rpx; }
.tree-container { padding: 24rpx; }
.tree-header { margin-bottom: 24rpx; }
.tree-title { font-size: 32rpx; font-weight: 700; color: #1A1A1A; }
.tree-sub { font-size: 24rpx; color: #8F959E; margin-left: 16rpx; }
.tree-scroll { width: 100%; height: 500rpx; background: #FFF; border-radius: 16rpx; overflow: auto; }
.tree-canvas { display: block; }
.empty-tree { text-align: center; padding: 160rpx 0; font-size: 26rpx; color: #C0C4CC; }
