.login-page {
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  min-height: 100vh; padding: 160rpx 96rpx; text-align: center;
  background: linear-gradient(180deg, var(--green-dark) 0%, var(--green-deep) 60%, #1E4A2A 100%);
  color: #fff;
}

.login-logo { font-size: 160rpx; margin-bottom: 32rpx; text-shadow: 0 4rpx 16rpx rgba(0,0,0,0.15); }
.login-title { font-size: 96rpx; font-weight: 800; letter-spacing: 4rpx; text-shadow: 0 4rpx 16rpx rgba(0,0,0,0.15); }
.login-subtitle { font-size: 32rpx; opacity: 0.75; margin-top: 32rpx; font-weight: 400; }

.login-btns { margin-top: 160rpx; width: 100%; }
.login-btn { width: 100%; padding: 36rpx; border-radius: 96rpx; font-size: 32rpx; font-weight: 600; display: flex; align-items: center; justify-content: center; gap: 16rpx; margin-bottom: 32rpx; }
.login-btn::after { border: none; }

.login-wechat { background: rgba(255,255,255,0.9); color: var(--green); box-shadow: 0 8rpx 32rpx rgba(74,140,92,0.25); }
.login-phone { background: rgba(255,255,255,0.1); color: #fff; border: 2rpx solid rgba(255,255,255,0.2); }

.login-skip { font-size: 24rpx; opacity: 0.5; margin-top: 80rpx; }
.login-terms { font-size: 22rpx; opacity: 0.4; margin-top: 80rpx; }
.login-link { color: rgba(255,255,255,0.6); text-decoration: underline; }
