/* 登录 — 暖森林 2.0（onboarding 设计语言） */

.login-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  position: relative;
  overflow: hidden;
}

/* 装饰圆环 */
.cr1 { width: 520rpx; height: 520rpx; top: -160rpx; right: -180rpx; }
.cr2 { width: 360rpx; height: 360rpx; bottom: 220rpx; left: -140rpx; }
.cr3 { width: 180rpx; height: 180rpx; top: 30%; right: -60rpx; }

.login-body {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 96rpx 80rpx;
  text-align: center;
}

.login-title {
  font-size: 64rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
  color: #2D2A26;
  margin-top: 48rpx;
}

.login-subtitle {
  font-size: 28rpx;
  color: #5E5953;
  margin-top: 16rpx;
}

.login-btns {
  margin-top: 140rpx;
  width: 100%;
}

.login-btn {
  width: 100%;
  padding: 32rpx;
  border-radius: 96rpx;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  margin-bottom: 32rpx;
}
.login-btn::after { border: none; }

.login-wechat {
  background: #4A8C5C;
  color: #fff;
  box-shadow: 0 8rpx 32rpx rgba(74,140,92,0.30);
}
.login-phone {
  background: rgba(255,255,255,0.75);
  color: #4A8C5C;
  border: 2rpx solid rgba(74,140,92,0.25);
}

.login-skip {
  font-size: 26rpx;
  color: #5E5953;
  opacity: 0.6;
  margin-top: 56rpx;
}

.login-terms {
  font-size: 22rpx;
  color: #948F89;
  margin-top: 64rpx;
}

.login-link {
  color: #4A8C5C;
  text-decoration: underline;
}
