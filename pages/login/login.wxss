.login-page {
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  min-height: 100vh; padding: 80rpx 56rpx; text-align: center;
  background: linear-gradient(180deg, #3D7A4D 0%, #2A5E38 60%, #1E4A2A 100%);
  color: #fff;
}
.login-logo { font-size: 128rpx; margin-bottom: 36rpx; opacity: 0.9; }
.login-title { font-size: 52rpx; font-weight: 800; letter-spacing: 2rpx; text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.15); }
.login-subtitle { font-size: 28rpx; opacity: 0.75; margin-top: 20rpx; font-weight: 400; }
.login-btn { width: 100%; padding: 30rpx; border-radius: 52rpx; font-size: 32rpx; font-weight: 700; display: flex; align-items: center; justify-content: center; gap: 16rpx; margin-top: 88rpx; }
.login-wechat { background: rgba(255,255,255,0.92); color: var(--green); box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.12); }
.login-phone { background: rgba(255,255,255,0.1); color: #fff; margin-top: 24rpx; border: 1rpx solid rgba(255,255,255,0.15); }
.login-skip { font-size: 26rpx; opacity: 0.65; margin-top: 40rpx; }
.login-terms { font-size: 22rpx; color: rgba(255,255,255,0.45); margin-top: 52rpx; }
.login-link { color: rgba(255,255,255,0.7); text-decoration: underline; }
