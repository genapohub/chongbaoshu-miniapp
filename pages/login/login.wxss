.login-page { display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 100vh; padding: 80rpx 56rpx; text-align: center; background: var(--green); color: #fff; }
.login-logo { font-size: 128rpx; margin-bottom: 32rpx; }
.login-title { font-size: 48rpx; font-weight: 800; letter-spacing: 1rpx; }
.login-subtitle { font-size: 28rpx; opacity: 0.8; margin-top: 20rpx; }
.login-btn { width: 100%; padding: 30rpx; border-radius: 52rpx; font-size: 32rpx; font-weight: 700; display: flex; align-items: center; justify-content: center; gap: 16rpx; margin-top: 80rpx; backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); }
.login-wechat { background: rgba(255,255,255,0.88); color: var(--green); }
.login-phone { background: rgba(255,255,255,0.12); color: #fff; margin-top: 24rpx; border: 1rpx solid rgba(255,255,255,0.2); }
.login-skip { font-size: 26rpx; opacity: 0.7; margin-top: 36rpx; }
.login-terms { font-size: 22rpx; color: rgba(255,255,255,0.5); margin-top: 48rpx; }
.login-link { color: rgba(255,255,255,0.8); text-decoration: underline; }
