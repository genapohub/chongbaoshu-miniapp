/* agreement page */
.container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background: var(--bg);
}

.header {
  position: relative;
  overflow: hidden;
  background: var(--gradient-hero);
  padding: 56rpx 32rpx 40rpx;
  border-bottom: none;
}

.title {
  font-size: 40rpx;
  font-weight: 800;
  color: #2D2A26;
  display: block;
  margin-bottom: 8rpx;
  letter-spacing: 1rpx;
  position: relative;
  z-index: 1;
}

.update-time {
  font-size: 24rpx;
  color: #5E5953;
  position: relative;
  z-index: 1;
}

.content {
  flex: 1;
  padding: 28rpx 32rpx;
  max-height: 70vh;
}

.content .rich-text {
  font-size: 28rpx;
  line-height: 1.8;
  color: #374151;
}

.footer {
  padding: 20rpx 32rpx 48rpx;
  border-top: 1rpx solid #EDEDEF;
}

.confirm-bar {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.confirm-text {
  font-size: 26rpx;
  color: #5E5953;
  margin-left: 12rpx;
}

.btn-primary {
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: var(--green);
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #FFF;
}

.btn-primary.disabled {
  opacity: 0.4;
}
