/* agreement page */
.container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background: #FFF;
}

.header {
  padding: 40rpx 32rpx 24rpx;
  border-bottom: 1rpx solid #F3F4F6;
}

.title {
  font-size: 36rpx;
  font-weight: 600;
  color: #111827;
  display: block;
  margin-bottom: 8rpx;
}

.update-time {
  font-size: 24rpx;
  color: #9CA3AF;
}

.content {
  flex: 1;
  padding: 28rpx 32rpx;
  max-height: 70vh;
}

.content .rich-text {
  font-size: 28rpx;
  line-height: 1.8;
  color: #374151;
}

.footer {
  padding: 20rpx 32rpx 48rpx;
  border-top: 1rpx solid #F3F4F6;
}

.confirm-bar {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.confirm-text {
  font-size: 26rpx;
  color: #6B7280;
  margin-left: 12rpx;
}

.btn-primary {
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: linear-gradient(135deg, #E94560, #FD79A8);
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #FFF;
}

.btn-primary.disabled {
  opacity: 0.4;
}
