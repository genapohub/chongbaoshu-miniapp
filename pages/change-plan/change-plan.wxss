.container {
  min-height: 100vh;
  background: #F5F5F5;
}

.page-content {
  padding: 24rpx;
}

.current-plan {
  background: #F3F4F6;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  position: relative;
}

.current-badge {
  position: absolute;
  top: -12rpx;
  left: 24rpx;
  background: #6B7280;
  color: #fff;
  font-size: 18rpx;
  font-weight: 600;
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
}

.current-plan-icon {
  font-size: 40rpx;
}

.current-plan-info {
  flex: 1;
}

.current-plan-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #212529;
}

.section-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #212529;
  margin-bottom: 16rpx;
}

.debug-info {
  background: #E0E7FF;
  padding: 12rpx 16rpx;
  border-radius: 8rpx;
  margin-bottom: 16rpx;
  display: flex;
  gap: 24rpx;
  font-size: 22rpx;
  color: #4338CA;
}

.plans-section {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.plan-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx;
  border-radius: 12rpx;
  background: #fff;
  border: 2rpx solid transparent;
}

.plan-card:active {
  border-color: #4A8C5C;
}

.plan-card.selected {
  border-color: #4A8C5C;
  background: #FFF5F6;
}

.check-icon {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #4A8C5C;
  color: #fff;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: bold;
}

.plan-icon-wrapper {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}

.free-bg {
  background: #F3F4F6;
}

.basic-bg {
  background: #E3F2FD;
}

.free-tag {
  font-size: 16rpx;
  font-weight: 700;
  color: #5E5953;
}

.plan-details {
  flex: 1;
}

.plan-card-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #212529;
  margin-bottom: 6rpx;
}

.plan-card-desc {
  font-size: 22rpx;
  color: #6C757D;
}

.plan-tag {
  font-size: 22rpx;
  font-weight: 600;
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
}

.plan-tag.downgrade {
  background: #E8F8F0;
  color: #3D8B37;
}

.plan-tag.upgrade {
  background: #DBEAFE;
  color: #2563EB;
}

.notice-card {
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}

.downgrade-card {
  background: #FFF3E0;
}

.upgrade-card {
  background: #E8F5E9;
}

.notice-header {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 12rpx;
}

.notice-icon {
  font-size: 24rpx;
}

.notice-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #D99006;
}

.upgrade-card .notice-title {
  color: #166534;
}

.notice-list {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.notice-list text {
  font-size: 22rpx;
  color: #6C757D;
  line-height: 1.5;
}

.confirm-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #4A8C5C;
  color: #fff;
  border-radius: 44rpx;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
  margin-top: 8rpx;
}
