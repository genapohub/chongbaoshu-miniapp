/* 宠宝树品牌样式 — 暖森林·毛玻璃 | change-plan */
.container {
  min-height: 100vh;
  background: var(--bg);
  padding: 32rpx;
  box-sizing: border-box;
}
.page-content { padding-bottom: 180rpx; }

/* ===== 当前方案卡片 ===== */
.current-plan {
  background: linear-gradient(135deg, var(--green) 0%, var(--green-dark) 100%);
  border-radius: var(--radius);
  padding: 36rpx 32rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(74,140,92,0.22);
  margin-bottom: 40rpx;
  position: relative;
  overflow: hidden;
}
.current-badge {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  font-size: 20rpx;
  color: rgba(255,255,255,0.85);
  background: rgba(255,255,255,0.18);
  padding: 6rpx 18rpx;
  border-radius: var(--radius-full);
}
.current-plan-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: var(--radius-sm);
  background: rgba(255,255,255,0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.current-plan-info { flex: 1; }
.current-plan-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 0.5rpx;
}

/* ===== 区块标题 ===== */
.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text2);
  margin: 8rpx 0 20rpx 8rpx;
  letter-spacing: 0.5rpx;
}

/* ===== 方案列表 ===== */
.plans-section { display: flex; flex-direction: column; gap: 20rpx; }
.plan-card {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 28rpx 24rpx;
  background: var(--surface);
  -webkit-backdrop-filter: var(--glass);
  backdrop-filter: var(--glass);
  border-radius: var(--radius);
  border: 2rpx solid transparent;
  box-shadow: var(--shadow);
  transition: all 0.2s;
}
.plan-card:active { transform: scale(0.99); }
.plan-icon-wrapper {
  width: 84rpx;
  height: 84rpx;
  border-radius: var(--radius-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.free-tag {
  font-size: 22rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 1rpx;
}
.plan-details { flex: 1; min-width: 0; }
.plan-card-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
}
.plan-card-desc {
  font-size: 24rpx;
  color: var(--text3);
  margin-top: 6rpx;
}
.plan-tag {
  font-size: 22rpx;
  padding: 8rpx 18rpx;
  border-radius: var(--radius-full);
  background: rgba(74,140,92,0.12);
  color: var(--green);
  flex-shrink: 0;
}
.plan-tag.recommend { background: rgba(212,145,74,0.14); color: var(--amber); }
.plan-tag.hot { background: rgba(212,83,74,0.12); color: var(--red); }

/* ===== 须知卡片 ===== */
.notice-card {
  margin-top: 36rpx;
  background: var(--surface);
  -webkit-backdrop-filter: var(--glass);
  backdrop-filter: var(--glass);
  border-radius: var(--radius);
  padding: 28rpx 28rpx 32rpx;
  box-shadow: var(--shadow);
}
.notice-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}
.notice-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: var(--radius-full);
  background: rgba(247,186,30,0.12);
  display: flex;
  align-items: center;
  justify-content: center;
}
.upgrade-card .notice-icon { background: rgba(74,140,92,0.12); }
.notice-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
}
.notice-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.notice-list text {
  font-size: 26rpx;
  color: var(--text2);
  line-height: 1.6;
}

/* ===== 底部确认按钮 ===== */
.confirm-btn {
  position: fixed;
  left: 32rpx;
  right: 32rpx;
  bottom: 40rpx;
  height: 96rpx;
  border-radius: var(--radius-full);
  background: var(--green);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(74,140,92,0.32);
  border: none;
}
.confirm-btn::after { border: none; }
.confirm-btn:active { opacity: 0.88; }
