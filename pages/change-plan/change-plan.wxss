.container {
  min-height: 100vh;
  background: #F8F9FA;
}

.page-content {
  padding: 24rpx;
}

/* 当前方案 */
.current-plan {
  background: #E9ECEF;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.plan-icon {
  font-size: 40rpx;
}

.plan-info {
  flex: 1;
}

.plan-label {
  font-size: 26rpx;
  color: #6C757D;
  margin-bottom: 8rpx;
}

.plan-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #212529;
}

/* 卡片 */
.card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #212529;
  margin-bottom: 24rpx;
}

/* 方案卡片 */
.plan-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  border: 2rpx solid #E9ECEF;
  margin-bottom: 16rpx;
  transition: all 0.2s ease;
}

.plan-card:last-child {
  margin-bottom: 0;
}

.plan-card.selected {
  border-color: #E94560;
  background: #FFF5F7;
}

.plan-card.disabled {
  opacity: 0.5;
}

.plan-icon-wrapper {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
}

.plan-details {
  flex: 1;
}

.plan-card-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #212529;
  margin-bottom: 6rpx;
}

.plan-card-desc {
  font-size: 24rpx;
  color: #6C757D;
}

.plan-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.plan-amount {
  font-size: 28rpx;
  font-weight: 600;
}

/* 警告卡片 */
.warning-card {
  background: #FFF3E0;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.warning-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #F57C00;
  margin-bottom: 12rpx;
}

.warning-text {
  font-size: 24rpx;
  color: #6C757D;
  line-height: 1.8;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

/* 成功卡片 */
.success-card {
  background: #E8F5E9;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.success-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #2E7D32;
  margin-bottom: 12rpx;
}

.success-text {
  font-size: 24rpx;
  color: #6C757D;
  line-height: 1.8;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

/* 按钮 */
.btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  border: none;
  outline: none;
}

.btn-primary {
  background: #E94560;
  color: #FFFFFF;
}

.btn-primary[disabled] {
  background: #E9ECEF;
  color: #ADB5BD;
}

.btn-block {
  width: 100%;
}
