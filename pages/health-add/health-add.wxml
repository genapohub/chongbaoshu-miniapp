<view class="container">
  <view class="tab-bar">
    <view class="tab-item {{currentType === 'vaccine' ? 'active' : ''}}" bindtap="switchType" data-type="vaccine">
      <text>疫苗</text>
    </view>
    <view class="tab-item {{currentType === 'deworm' ? 'active' : ''}}" bindtap="switchType" data-type="deworm">
      <text>驱虫</text>
    </view>
    <view class="tab-item {{currentType === 'other' ? 'active' : ''}}" bindtap="switchType" data-type="other">
      <text>其他</text>
    </view>
  </view>

  <view wx:if="{{currentType === 'vaccine'}}">
    <view class="card">
      <view class="card-title"><icon name="syringe" size="36" color="#2D9CDB" /><text>疫苗信息</text></view>

      <view class="form-item">
        <text class="form-label">宠物 *</text>
        <view class="picker-wrap" bindtap="showPetPicker">
          <text class="picker-value {{petName ? '' : 'placeholder'}}">{{petName || '请选择宠物'}}</text>
          <icon name="chevron-right" size="28" color="#C0C4CC" />
        </view>
      </view>

      <view class="form-item">
        <text class="form-label">疫苗类型 *</text>
        <view class="picker-wrap" bindtap="showVaccinePickerFn">
          <text class="picker-value {{formData.vaccine_type ? '' : 'placeholder'}}">{{formData.vaccine_type || '请选择疫苗类型'}}</text>
          <icon name="chevron-right" size="28" color="#C0C4CC" />
        </view>
      </view>

      <view class="form-item">
        <text class="form-label">针次 *</text>
        <input class="input-field {{roundError ? 'input-error' : ''}}" type="number" placeholder="请输入针次（1-10）" value="{{formData.vaccine_round}}" bindinput="onInputChange" data-field="vaccine_round" />
        <text wx:if="{{roundError}}" class="field-error">{{roundError}}</text>
      </view>

      <view class="form-item">
        <text class="form-label">接种日期 *</text>
        <picker mode="date" value="{{formData.record_date}}" bindchange="onDateChange">
          <view class="picker-wrap">
            <text class="picker-value {{formData.record_date ? '' : 'placeholder'}}">{{formData.record_date || '请选择日期'}}</text>
            <icon name="chevron-right" size="28" color="#C0C4CC" />
          </view>
        </picker>
      </view>

      <view wx:if="{{nextDate}}" class="next-date-row">
        <text class="next-date-label">下次接种：</text>
        <text class="next-date-value">{{nextDateInfo}}</text>
      </view>

      <view class="form-item">
        <text class="form-label">批号</text>
        <input class="input-field" placeholder="请输入批号（选填）" value="{{formData.batch_no}}" bindinput="onInputChange" data-field="batch_no" />
      </view>

      <view class="form-item">
        <text class="form-label">兽医/医院</text>
        <input class="input-field" placeholder="请输入兽医或医院名称（选填）" value="{{formData.vet_hospital}}" bindinput="onInputChange" data-field="vet_hospital" />
      </view>
    </view>

    <view class="card">
      <view class="card-title"><icon name="clipboard" size="36" color="#646A73" /><text>备注</text></view>
      <notes-textarea
        value="{{formData.notes}}"
        placeholder="请输入备注信息（选填）"
        maxlength="{{200}}"
        bind:input="onNotesInput"
      />
    </view>
  </view>

  <view wx:if="{{currentType === 'deworm'}}">
    <view class="card">
      <view class="card-title"><icon name="bug" size="36" color="#2BA471" /><text>驱虫信息</text></view>

      <view class="form-item">
        <text class="form-label">宠物 *</text>
        <view class="picker-wrap" bindtap="showPetPicker">
          <text class="picker-value {{petName ? '' : 'placeholder'}}">{{petName || '请选择宠物'}}</text>
          <icon name="chevron-right" size="28" color="#C0C4CC" />
        </view>
      </view>

      <view class="form-item">
        <text class="form-label">驱虫类型 *</text>
        <view class="picker-wrap" bindtap="showDewormPickerFn">
          <text class="picker-value {{formData.deworm_type_display ? '' : 'placeholder'}}">{{formData.deworm_type_display || '请选择驱虫类型'}}</text>
          <icon name="chevron-right" size="28" color="#C0C4CC" />
        </view>
      </view>

      <view class="form-item">
        <text class="form-label">药品名称 *</text>
        <input class="input-field" placeholder="请输入药品名称" value="{{formData.medicine_name}}" bindinput="onInputChange" data-field="medicine_name" />
      </view>

      <view class="form-item">
        <text class="form-label">驱虫日期 *</text>
        <picker mode="date" value="{{formData.record_date}}" bindchange="onDateChange">
          <view class="picker-wrap">
            <text class="picker-value {{formData.record_date ? '' : 'placeholder'}}">{{formData.record_date || '请选择日期'}}</text>
            <icon name="chevron-right" size="28" color="#C0C4CC" />
          </view>
        </picker>
      </view>

      <view wx:if="{{nextDate}}" class="next-date-row">
        <text class="next-date-label">下次驱虫：</text>
        <text class="next-date-value">{{nextDateInfo}}</text>
      </view>

      <view class="form-item">
        <text class="form-label">剂量</text>
        <input class="input-field" placeholder="请输入剂量（选填）" value="{{formData.dosage}}" bindinput="onInputChange" data-field="dosage" />
      </view>

      <view class="form-item">
        <text class="form-label">兽医/医院</text>
        <input class="input-field" placeholder="请输入兽医或医院名称（选填）" value="{{formData.vet_hospital}}" bindinput="onInputChange" data-field="vet_hospital" />
      </view>
    </view>

    <view class="card">
      <view class="card-title"><icon name="clipboard" size="36" color="#646A73" /><text>备注</text></view>
      <notes-textarea
        value="{{formData.notes}}"
        placeholder="请输入备注信息（选填）"
        maxlength="{{200}}"
        bind:input="onNotesInput"
      />
    </view>
  </view>

  <view wx:if="{{currentType === 'other'}}">
    <view class="card">
      <view class="card-title"><icon name="clipboard" size="36" color="#646A73" /><text>其他记录</text></view>

      <view class="form-item">
        <text class="form-label">宠物 *</text>
        <view class="picker-wrap" bindtap="showPetPicker">
          <text class="picker-value {{petName ? '' : 'placeholder'}}">{{petName || '请选择宠物'}}</text>
          <icon name="chevron-right" size="28" color="#C0C4CC" />
        </view>
      </view>

      <view class="form-item">
        <text class="form-label">日期 *</text>
        <picker mode="date" value="{{formData.record_date}}" bindchange="onDateChange">
          <view class="picker-wrap">
            <text class="picker-value {{formData.record_date ? '' : 'placeholder'}}">{{formData.record_date || '请选择日期'}}</text>
            <icon name="chevron-right" size="28" color="#C0C4CC" />
          </view>
        </picker>
      </view>

      <view class="form-item">
        <text class="form-label">描述 *</text>
        <input class="input-field" placeholder="请输入描述" value="{{formData.description}}" bindinput="onInputChange" data-field="description" />
      </view>
    </view>

    <view class="card">
      <view class="card-title"><icon name="clipboard" size="36" color="#646A73" /><text>备注</text></view>
      <notes-textarea
        value="{{formData.notes}}"
        placeholder="请输入备注信息（选填）"
        maxlength="{{200}}"
        bind:input="onNotesInput"
      />
    </view>
  </view>

  <view class="submit-section">
    <button class="btn btn-primary btn-block" bindtap="submitForm" disabled="{{!canSubmit || loading}}">
      <text wx:if="{{loading}}">{{isEdit ? '更新中...' : '保存中...'}}</text>
      <text wx:else>{{isEdit ? '更新健康记录' : '保存健康记录'}}</text>
    </button>
  </view>
</view>

<!-- 疫苗类型选择弹窗 -->
<picker-modal
  title="选择疫苗类型"
  items="{{vaccinePickerItems}}"
  selectedValue="{{formData.vaccine_type}}"
  show="{{showVaccinePicker}}"
  bind:select="onVaccineSelect"
  bind:close="hideVaccinePicker"
/>

<!-- 驱虫类型选择弹窗 -->
<picker-modal
  title="选择驱虫类型"
  items="{{dewormPickerItems}}"
  selectedValue="{{formData.deworm_type}}"
  show="{{showDewormPicker}}"
  bind:select="onDewormSelect"
  bind:close="hideDewormPicker"
/>

<!-- 宠物选择弹窗（保持原样，因为包含头像等自定义渲染） -->
<view wx:if="{{showPetPicker}}" class="picker-modal" bindtap="hidePetPicker">
  <view class="picker-content" catchtap="stopPropagation">
    <view class="picker-header">
      <text class="picker-title">选择宠物</text>
      <icon name="close" size="36" color="#8F959E" class="picker-close" bindtap="hidePetPicker" />
    </view>
    <scroll-view scroll-y class="picker-list">
      <view wx:if="{{petList.length === 0}}" class="picker-empty">
        <text>还没有添加小可爱，
点下方 + 开始记录，请先记下第一只小家伙</text>
      </view>
      <view
        wx:for="{{petList}}"
        wx:key="id"
        class="picker-item pet-item {{petId === item.id ? 'selected' : ''}}"
        bindtap="selectPet"
        data-id="{{item.id}}"
        data-name="{{item.name}}"
      >
        <image wx:if="{{item.avatar_photo}}" class="pet-avatar" src="{{item.avatar_photo}}" mode="aspectFill" lazy-load />
        <view wx:else class="pet-avatar placeholder">
          <text class="avatar-text">{{item.name ? item.name.charAt(0) : '?'}}</text>
        </view>
        <view class="pet-info">
          <text class="pet-name">{{item.name}}</text>
          <text class="pet-breed">{{item.breed || '未知品种'}}</text>
        </view>
      </view>
    </scroll-view>
  </view>
</view>
