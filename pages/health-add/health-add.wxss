.container {
  min-height: 100vh;
  background: #F6F4F0;
  padding: 24rpx;
  padding-bottom: 160rpx;
}

.tab-bar {
  display: flex;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 6rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  font-weight: 500;
  color: #5E5953;
  border-radius: 12rpx;
  transition: all 0.3s;
}

.tab-item.active {
  background: var(--green);
  color: #FFFFFF;
  font-weight: 600;
}

.card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #212529;
  margin-bottom: 24rpx;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #2D2A26;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.input-field {
  width: 100%;
  height: 88rpx;
  background: #F6F4F0;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #212529;
  box-sizing: border-box;
}

.picker-wrap {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  background: #F6F4F0;
  border-radius: 12rpx;
  padding: 0 24rpx;
}

.picker-value {
  font-size: 28rpx;
  color: #212529;
}

.picker-value.placeholder {
  color: #C4C9D2;
}

.picker-arrow {
  font-size: 36rpx;
  color: #948F89;
}

/* textarea 已提取为 notes-textarea 组件 */

.next-date-card {
  background: #EBF5FF;
}

.next-date-row {
  display: flex;
  align-items: flex-start;
  flex-wrap: wrap;
}

.next-date-label {
  font-size: 28rpx;
  font-weight: 500;
  color: #1E88E5;
  flex-shrink: 0;
}

.next-date-value {
  font-size: 28rpx;
  font-weight: 600;
  color: #1E88E5;
  flex: 1;
  word-break: break-all;
}

.submit-section {
  padding: 24rpx 0;
}

.btn {
  width: 100%;
  height: 96rpx;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  padding: 0;
}

.btn::after {
  border: none;
}

.btn-primary {
  background: var(--green);
  color: #FFFFFF;
}

.btn-primary[disabled] {
  background: #E9ECEF;
  color: #ADB5BD;
}

.picker-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: flex-end;
  z-index: 1000;
}

.picker-content {
  width: 100%;
  background: #FFFFFF;
  border-radius: 24rpx 24rpx 0 0;
  max-height: 70vh;
  overflow: hidden;
}

.picker-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  border-bottom: 1rpx solid #EEEEEE;
}

.picker-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #2D2A26;
}

.picker-close {
  font-size: 48rpx;
  color: #948F89;
  line-height: 1;
}

.picker-list {
  max-height: 50vh;
}

.picker-item {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #F5F5F5;
}

.picker-item:last-child {
  border-bottom: none;
}

.picker-item.selected {
  background: #FFF5F7;
}

.picker-item-text {
  font-size: 30rpx;
  color: #2D2A26;
}

.picker-item.selected .picker-item-text {
  color: #4A8C5C;
}

.picker-empty {
  padding: 80rpx 32rpx;
  text-align: center;
  color: #948F89;
  font-size: 28rpx;
}

.pet-item {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #F5F5F5;
}

.pet-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 24rpx;
  background: #F5F5F5;
}

.pet-avatar.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FDEDEC;
}

.avatar-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #4A8C5C;
}

.pet-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.pet-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #2D2A26;
}

.pet-breed {
  font-size: 24rpx;
  color: #948F89;
  margin-top: 4rpx;
}

.input-error {
  border-color: #4A8C5C !important;
}

.field-error {
  display: block;
  font-size: 24rpx;
  color: #4A8C5C;
  margin-top: 8rpx;
}
