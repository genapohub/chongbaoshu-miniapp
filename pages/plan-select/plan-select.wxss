.container {
  min-height: 100vh;
  background: #F5F5F5;
}

.page-content {
  padding: 24rpx;
}

.plans-section {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.plan-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  border: 2rpx solid transparent;
  position: relative;
}

.plan-card.selected {
  border-color: #4A8C5C;
}

.plan-card.disabled {
  opacity: 0.5;
}

.popular-badge {
  position: absolute;
  top: -12rpx;
  right: 20rpx;
  background: #4A8C5C;
  color: #fff;
  font-size: 20rpx;
  font-weight: 600;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.plan-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.plan-icon-wrapper {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}

.plan-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #212529;
  flex: 1;
}

.plan-price {
  display: flex;
  align-items: baseline;
}

.price-value {
  font-size: 32rpx;
  font-weight: 700;
  color: #4A8C5C;
}

.price-unit {
  font-size: 22rpx;
  color: #6C757D;
  margin-left: 4rpx;
}

.plan-desc {
  font-size: 24rpx;
  color: #6C757D;
  margin-bottom: 12rpx;
}

.yearly-price {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: #3D8B37;
}

.save-tag {
  background: #E8F8F0;
  color: #3D8B37;
  font-size: 18rpx;
  font-weight: 600;
  padding: 4rpx 10rpx;
  border-radius: 8rpx;
}

.current-tag {
  position: absolute;
  top: -12rpx;
  right: 20rpx;
  background: #6B7280;
  color: #fff;
  font-size: 18rpx;
  font-weight: 600;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.features-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.features-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #212529;
  margin-bottom: 20rpx;
}

.features-scroll {
  width: 100%;
}

.features-table {
  min-width: 100%;
}

.feature-row {
  display: flex;
  align-items: center;
}

.feature-row.header {
  background: #F3F4F6;
  border-radius: 8rpx;
  font-weight: 600;
}

.feature-cell {
  flex: 1;
  padding: 16rpx 12rpx;
  text-align: center;
  font-size: 24rpx;
  color: #212529;
  border-bottom: 1rpx solid #EDEDEF;
}

.feature-row.header .feature-cell {
  border-bottom: none;
}

.feature-cell:first-child {
  flex: 1.2;
  text-align: left;
  padding-left: 16rpx;
}

.confirm-btn {
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  background: #4A8C5C;
  color: #fff;
  border-radius: 46rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
}

.confirm-btn[disabled] {
  background: #E9ECEF;
  color: #ADB5BD;
}
