<view class="profile-page">
  <view class="profile-header" bindtap="onHeaderTap">
    <view class="profile-avatar-wrap">
      <image wx:if="{{displayAvatar}}" class="profile-avatar" src="{{displayAvatar}}" mode="aspectFill" />
      <view wx:else class="profile-avatar-placeholder">👤</view>
    </view>
    <text class="profile-name">{{displayName || '未设置昵称'}}</text>
    <text wx:if="{{userInfo.subscription_tier === 'pro'}}" class="badge-amber">PRO</text>
    
    <view class="profile-stats">
      <view class="profile-stat">
        <text class="stat-num">{{stats.petCount}}</text>
        <text class="stat-label">宠物</text>
      </view>
      <view class="profile-stat">
        <text class="stat-num">{{stats.breedingCount}}</text>
        <text class="stat-label">配种</text>
      </view>
      <view class="profile-stat">
        <text class="stat-num">{{stats.healthCount}}</text>
        <text class="stat-label">健康</text>
      </view>
    </view>
  </view>
  
  <view class="content-area">
    <view class="menu-list-bg">
      <view class="menu-row" bindtap="goMenu" data-url="/pages/profile-edit/profile-edit">
        <text class="menu-icon">🏠</text>
        <text class="menu-label">宠舍信息</text>
        <text class="menu-arrow">→</text>
      </view>
      <view class="menu-row" bindtap="goMenu" data-url="/pages/remind-settings/remind-settings">
        <text class="menu-icon">🔔</text>
        <text class="menu-label">提醒设置</text>
        <text class="menu-arrow">→</text>
      </view>
      <view class="menu-row" bindtap="goAbout">
        <text class="menu-icon">ℹ️</text>
        <text class="menu-label">关于我们</text>
        <text class="menu-arrow">→</text>
      </view>
    </view>
    
    <view wx:if="{{isLoggedIn}}" class="btn btn-outline btn-block logout-btn" bindtap="onLogout">退出登录</view>
  </view>
</view>
