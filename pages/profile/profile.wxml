<!--
  P21 我的页面 - 按设计稿一比一复刻
  结构：头部渐变背景 → 订阅状态卡片 → 菜单列表 → 退出登录
-->
<view class="container">
  <!-- 头部 -->
  <view class="profile-header" bindtap="onHeaderTap">
    <view class="profile-avatar">
      <image wx:if="{{displayAvatar}}" src="{{displayAvatar}}" mode="aspectFill" class="avatar-img" lazy-load />
      <view wx:else class="avatar-placeholder"><icon name="user" size="48" color="#8F959E" /></view>
    </view>
    <text class="profile-name">{{displayName || '未设置昵称'}}</text>
    <view wx:if="{{userInfo.subscription_tier === 'pro'}}" class="badge-pro">PRO</view>
    
    <view class="profile-stats">
      <view class="profile-stat">
        <text class="stat-num">{{stats.petCount}}</text>
        <text class="stat-label">宠物</text>
      </view>
      <view class="profile-stat">
        <text class="stat-num">{{stats.breedingCount}}</text>
        <text class="stat-label">配种</text>
      </view>
      <view class="profile-stat">
        <text class="stat-num">{{stats.inviteCount}}</text>
        <text class="stat-label">邀请</text>
      </view>
    </view>
  </view>

  <view class="content">
    <!-- 订阅状态卡片 -->
    <view class="sub-status-card">
      <view class="ssc-left">
        <text class="ssc-label">当前方案</text>
        <text class="ssc-plan">{{subscriptionPlan}}</text>
      </view>
      <view class="btn btn-sm ssc-btn" bindtap="goSubscription"><text>管理 </text><icon name="chevron-right" size="24" color="#4A8C5C" /></view>
    </view>
    <view class="ssc-meta">
      <text>到期：{{expireDate || '永久'}}</text>
      <text>{{isAutoRenew ? '自动续费' : '已关闭'}}</text>
    </view>

    <!-- 菜单列表 -->
    <view class="card menu-card">
      <view class="menu-item" bindtap="goMenu" data-url="/pages/profile-edit/profile-edit">
        <icon name="home" size="36" color="#4A8C5C" />
        <text class="menu-text">宠舍信息</text>
        <icon name="chevron-right" size="28" color="#C0C4CC" />
      </view>
      <view class="menu-item" bindtap="goMenu" data-url="/pages/remind-settings/remind-settings">
        <icon name="bell" size="36" color="#4A8C5C" />
        <text class="menu-text">提醒设置</text>
        <icon name="chevron-right" size="28" color="#C0C4CC" />
      </view>
      <view class="menu-item" bindtap="goMenu" data-url="/pages/invite/invite">
        <icon name="gift" size="36" color="#F54A45" />
        <text class="menu-text">邀请好友 <text class="menu-tag">+1月Pro</text></text>
        <icon name="chevron-right" size="28" color="#C0C4CC" />
      </view>
      <view class="menu-item" bindtap="goMenu" data-url="/pages/invite-redeem/invite-redeem">
        <icon name="key" size="36" color="#F7BA1E" />
        <text class="menu-text">兑换邀请码</text>
        <icon name="chevron-right" size="28" color="#C0C4CC" />
      </view>
      <view class="menu-item" bindtap="goMenu" data-url="/pages/subscription/subscription">
        <icon name="diamond" size="36" color="#4A8C5C" />
        <text class="menu-text">订阅管理</text>
        <icon name="chevron-right" size="28" color="#C0C4CC" />
      </view>
      <view class="menu-item" bindtap="goFeedback">
        <icon name="chat" size="36" color="#4A8C5C" />
        <text class="menu-text">意见反馈</text>
        <icon name="chevron-right" size="28" color="#C0C4CC" />
      </view>
      <view class="menu-item" bindtap="goAbout">
        <icon name="info" size="36" color="#8F959E" />
        <text class="menu-text">关于宠宝树</text>
        <icon name="chevron-right" size="28" color="#C0C4CC" />
      </view>
    </view>

    <!-- 退出登录 -->
    <view wx:if="{{isLoggedIn}}" class="btn btn-block logout-btn" bindtap="onLogout">退出登录</view>
  </view>

  <!-- 登录引导弹窗 -->
  <view wx:if="{{showLoginGuide}}" class="login-guide-mask" bindtap="hideLoginGuide">
    <view class="login-guide-modal" catchtap="stopPropagation">
      <icon name="lock" size="48" color="#8F959E" />
      <text class="login-guide-title">登录后即可使用</text>
      <view class="login-guide-btn primary" bindtap="goLoginFromGuide">立即登录</view>
      <view class="login-guide-btn secondary" bindtap="hideLoginGuide">稍后再说</view>
    </view>
  </view>
</view>