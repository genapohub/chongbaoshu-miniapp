/* 我的 */

.container { min-height: 100vh; background: var(--bg); }

.profile-header { background: var(--green); padding: 56rpx 24rpx 40rpx; text-align: center; color: #fff; }
.profile-avatar { width: 120rpx; height: 120rpx; border-radius: 50%; background: rgba(255,255,255,0.2); display: flex; align-items: center; justify-content: center; margin: 0 auto 16rpx; overflow: hidden; }
.avatar-img { width: 100%; height: 100%; border-radius: 50%; }
.profile-name { font-size: 36rpx; font-weight: 700; display: block; }
.badge-pro { display: inline-flex; align-items: center; gap: 4rpx; background: var(--amber); color: #fff; padding: 4rpx 12rpx; border-radius: 6rpx; font-size: 20rpx; font-weight: 700; margin-top: 8rpx; }

.profile-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20rpx; margin-top: 32rpx; }
.profile-stat { display: flex; flex-direction: column; align-items: center; }
.stat-num { font-size: 40rpx; font-weight: 700; }
.stat-label { font-size: 22rpx; opacity: 0.8; margin-top: 4rpx; }

.content { padding: 24rpx; padding-bottom: 140rpx; }

.sub-status-card { background: var(--green); border-radius: var(--radius); padding: 28rpx; color: #fff; display: flex; justify-content: space-between; align-items: center; margin-bottom: 24rpx; }
.ssc-left { display: flex; flex-direction: column; }
.ssc-label { font-size: 22rpx; opacity: 0.7; }
.ssc-plan { font-size: 32rpx; font-weight: 700; margin-top: 4rpx; }

.card { background: var(--surface); border-radius: var(--radius); padding: 8rpx 0; margin-bottom: 20rpx; box-shadow: var(--shadow); }

.menu-item { display: flex; align-items: center; padding: 24rpx 28rpx; border-bottom: 1rpx solid var(--line); }
.menu-item:last-child { border-bottom: none; }
.menu-text { flex: 1; font-size: 28rpx; color: var(--text); margin-left: 20rpx; }
.menu-tag { background: var(--amber); color: #fff; padding: 4rpx 10rpx; border-radius: 4rpx; font-size: 20rpx; font-weight: 700; margin-left: 8rpx; }

.logout-btn { border-radius: var(--radius); font-weight: 500; background: var(--bg); color: var(--red); text-align: center; padding: 24rpx; margin-top: 8rpx; font-size: 28rpx; }
