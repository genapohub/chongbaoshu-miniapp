/* 我的 — 毛玻璃 */

.container { min-height: 100vh; background: var(--bg); }

.profile-header {
  background: var(--green);
  padding: 64rpx 32rpx 48rpx; text-align: center; color: #fff;
}
.profile-avatar {
  width: 128rpx; height: 128rpx; border-radius: 50%;
  background: rgba(255,255,255,0.18);
  display: flex; align-items: center; justify-content: center;
  margin: 0 auto 20rpx; overflow: hidden;
  border: 3rpx solid rgba(255,255,255,0.3);
}
.avatar-img { width: 100%; height: 100%; border-radius: 50%; }
.profile-name { font-size: 36rpx; font-weight: 700; display: block; letter-spacing: 0.5rpx; }
.badge-pro {
  display: inline-flex; align-items: center; gap: 4rpx;
  background: var(--amber); color: #fff;
  padding: 4rpx 14rpx; border-radius: 6rpx;
  font-size: 20rpx; font-weight: 700; margin-top: 10rpx;
}

.profile-stats {
  display: grid; grid-template-columns: repeat(3, 1fr);
  gap: 24rpx; margin-top: 36rpx;
}
.profile-stat { display: flex; flex-direction: column; align-items: center; }
.stat-num { font-size: 42rpx; font-weight: 700; }
.stat-label { font-size: 22rpx; opacity: 0.8; margin-top: 6rpx; }

.content { padding: 32rpx; padding-bottom: 160rpx; }

.sub-status-card {
  background: rgba(255,255,255,0.35);
  border-radius: var(--radius); padding: 32rpx;
  color: #fff; display: flex; justify-content: space-between; align-items: center;
  margin-bottom: 12rpx;
  -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px);
}
.ssc-left { display: flex; flex-direction: column; }
.ssc-label { font-size: 22rpx; opacity: 0.8; }
.ssc-plan { font-size: 32rpx; font-weight: 700; margin-top: 4rpx; }

.card {
  background: var(--surface);
  border-radius: var(--radius);
  padding: 8rpx 0; margin-bottom: 24rpx;
  box-shadow: var(--shadow);
  -webkit-backdrop-filter: var(--glass); backdrop-filter: var(--glass);
}

.menu-item {
  display: flex; align-items: center;
  padding: 30rpx 32rpx; border-bottom: 1rpx solid var(--line);
}
.menu-item:last-child { border-bottom: none; }
.menu-text { flex: 1; font-size: 28rpx; color: var(--text); margin-left: 20rpx; }
.menu-tag { background: var(--amber); color: #fff; padding: 4rpx 10rpx; border-radius: 4rpx; font-size: 20rpx; font-weight: 700; margin-left: 8rpx; }

.logout-btn {
  border-radius: 48rpx; font-weight: 500;
  background: rgba(0,0,0,0.04); color: var(--red);
  text-align: center; padding: 26rpx; margin-top: 12rpx; font-size: 28rpx;
}
