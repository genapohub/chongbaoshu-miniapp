/* 订阅页 — 暖森林·毛玻璃 */
.container {
  min-height: 100vh;
  background: var(--bg);
  box-sizing: border-box;
}

.page-content {
  padding: 32rpx 32rpx 200rpx;
}

/* 套餐区 */
.plans-section {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-bottom: 40rpx;
}

.plan-card {
  position: relative;
  background: var(--surface);
  -webkit-backdrop-filter: var(--glass);
  backdrop-filter: var(--glass);
  border-radius: var(--radius);
  padding: 32rpx;
  box-shadow: var(--shadow);
  display: flex;
  align-items: center;
  gap: 24rpx;
  border: 2rpx solid transparent;
  transition: all 0.25s ease;
  overflow: hidden;
}

.plan-card:active {
  transform: scale(0.99);
}

.plan-card.selected {
  border-color: var(--green);
  background: linear-gradient(135deg, rgba(74, 140, 92, 0.06), var(--surface));
}

/* 热门角标 */
.hot-badge {
  position: absolute;
  top: 0;
  right: 0;
  padding: 6rpx 20rpx;
  background: var(--amber);
  color: #fff;
  font-size: 22rpx;
  font-weight: 500;
  border-radius: 0 var(--radius) 0 var(--radius-sm);
  letter-spacing: 0.5rpx;
}

/* 套餐图标 */
.plan-icon-wrapper {
  width: 96rpx;
  height: 96rpx;
  border-radius: var(--radius-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.plan-icon-wrapper.free-bg {
  background: rgba(0, 0, 0, 0.06);
}

.plan-icon-wrapper.basic-bg {
  background: rgba(247, 186, 30, 0.12);
}

.plan-icon-wrapper.pro-bg {
  background: rgba(74, 140, 92, 0.12);
}

.free-tag {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--text3);
  letter-spacing: 1rpx;
}

/* 套餐信息 */
.plan-details {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

.plan-card-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
  letter-spacing: 0.5rpx;
}

.plan-card-desc {
  font-size: 22rpx;
  color: var(--text3);
  line-height: 1.5;
}

/* 价格 */
.plan-price {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 4rpx;
  max-width: 200rpx;
}

.price-symbol {
  font-size: 24rpx;
  color: var(--text);
  font-weight: 500;
}

.price-num {
  font-size: 48rpx;
  color: var(--text);
  font-weight: 700;
  line-height: 1;
  letter-spacing: -0.5rpx;
}

.price-unit {
  font-size: 22rpx;
  color: var(--text2);
}

.yearly-discount {
  width: 100%;
  font-size: 20rpx;
  color: var(--amber);
  text-align: right;
  margin-top: 4rpx;
  letter-spacing: 0.3rpx;
}

/* 选中标识 */
.check-icon {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 功能对比表 */
.comparison-section {
  background: var(--surface);
  -webkit-backdrop-filter: var(--glass);
  backdrop-filter: var(--glass);
  border-radius: var(--radius);
  padding: 32rpx;
  box-shadow: var(--shadow);
  margin-bottom: 24rpx;
}

.comparison-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 24rpx;
  letter-spacing: 0.5rpx;
}

.comparison-scroll {
  width: 100%;
  white-space: nowrap;
}

.comparison-table {
  display: inline-flex;
  flex-direction: column;
  min-width: 100%;
}

.comparison-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.comparison-row:last-child {
  border-bottom: none;
}

.header-row {
  background: rgba(0, 0, 0, 0.03);
  border-radius: var(--radius-sm);
  padding: 20rpx 16rpx;
  margin-bottom: 8rpx;
  border-bottom: none;
}

.comparison-cell {
  flex: 0 0 140rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--text2);
  padding: 0 8rpx;
  white-space: nowrap;
}

.comparison-cell.feature-cell {
  flex: 0 0 200rpx;
  text-align: left;
  color: var(--text);
  font-weight: 500;
}

.comparison-cell.tier-cell {
  color: var(--text);
  font-weight: 500;
}

.comparison-cell.check,
.comparison-cell.cross {
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 确认按钮 */
.confirm-btn {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 110rpx;
  line-height: 110rpx;
  background: var(--green);
  color: #fff;
  border-radius: 0;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  border: none;
  padding: 0 32rpx calc(env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 32rpx rgba(74, 140, 92, 0.2);
  z-index: 10;
}

.confirm-btn::after {
  border: none;
}

.confirm-btn:active {
  opacity: 0.9;
}
