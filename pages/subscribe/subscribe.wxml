<view class="container">
  <view class="page-content">
    <view class="plans-section">
      <view
        class="plan-card {{selectedPlan === 'free' ? 'selected' : ''}}"
        catchtap="selectPlan"
        data-tier="free"
      >
        <view class="plan-icon-wrapper free-bg">
          <text class="free-tag">FREE</text>
        </view>
        <view class="plan-details">
          <view class="plan-card-name">免费版</view>
          <view class="plan-card-desc">3只宠物 · 基础功能</view>
        </view>
        <view class="plan-price">
          <text class="price-symbol">¥</text>
          <text class="price-num">0</text>
        </view>
        <view wx:if="{{selectedPlan === 'free'}}" class="check-icon"><cbs-icon name="check" size="36" color="var(--green)" /></view>
      </view>

      <view
        class="plan-card basic-card {{selectedPlan === 'basic' ? 'selected' : ''}}"
        catchtap="selectPlan"
        data-tier="basic"
      >
        <view class="hot-badge">热门</view>
        <view class="plan-icon-wrapper basic-bg"><cbs-icon name="star" size="40" color="#F7BA1E" /></view>
        <view class="plan-details">
          <view class="plan-card-name">基础版</view>
          <view class="plan-card-desc">100只宠物 · 数据导出 · 优先提醒</view>
        </view>
        <view class="plan-price">
          <text class="price-symbol">¥</text>
          <text class="price-num">49</text>
          <text class="price-unit">/月</text>
          <view class="yearly-discount">年付¥39/月 · 省¥120</view>
        </view>
        <view wx:if="{{selectedPlan === 'basic'}}" class="check-icon"><cbs-icon name="check" size="36" color="var(--green)" /></view>
      </view>

      <view
        class="plan-card {{selectedPlan === 'pro' ? 'selected' : ''}}"
        catchtap="selectPlan"
        data-tier="pro"
      >
        <view class="plan-icon-wrapper pro-bg"><cbs-icon name="diamond" size="40" color="#4A8C5C" /></view>
        <view class="plan-details">
          <view class="plan-card-name">Pro 专业版</view>
          <view class="plan-card-desc">无限宠物 · 血统证书 · 专属客服</view>
        </view>
        <view class="plan-price">
          <text class="price-symbol">¥</text>
          <text class="price-num">119</text>
          <text class="price-unit">/月</text>
          <view class="yearly-discount">年付¥99/月 · 省¥240</view>
        </view>
        <view wx:if="{{selectedPlan === 'pro'}}" class="check-icon"><cbs-icon name="check" size="36" color="var(--green)" /></view>
      </view>
    </view>

    <view class="comparison-section">
      <view class="comparison-title">功能对比</view>
      <scroll-view class="comparison-scroll" scroll-x>
        <view class="comparison-table">
          <view class="comparison-row header-row">
            <view class="comparison-cell feature-cell">功能</view>
            <view class="comparison-cell tier-cell">免费</view>
            <view class="comparison-cell tier-cell">基础版</view>
            <view class="comparison-cell tier-cell">Pro</view>
          </view>
          <view class="comparison-row">
            <view class="comparison-cell feature-cell">宠物数量</view>
            <view class="comparison-cell">3只</view>
            <view class="comparison-cell">100只</view>
            <view class="comparison-cell">无限</view>
          </view>
          <view class="comparison-row">
            <view class="comparison-cell feature-cell">照片/宠物</view>
            <view class="comparison-cell">3张</view>
            <view class="comparison-cell">10张</view>
            <view class="comparison-cell">20张</view>
          </view>
          <view class="comparison-row">
            <view class="comparison-cell feature-cell">配种记录</view>
            <view class="comparison-cell">3条</view>
            <view class="comparison-cell">无限</view>
            <view class="comparison-cell">无限</view>
          </view>
          <view class="comparison-row">
            <view class="comparison-cell feature-cell">健康档案</view>
            <view class="comparison-cell check"><cbs-icon name="check" size="24" color="var(--green)" /></view>
            <view class="comparison-cell check"><cbs-icon name="check" size="24" color="var(--green)" /></view>
            <view class="comparison-cell check"><cbs-icon name="check" size="24" color="var(--green)" /></view>
          </view>
          <view class="comparison-row">
            <view class="comparison-cell feature-cell">数据导出</view>
            <view class="comparison-cell cross"><cbs-icon name="close" size="24" color="#F54A45" /></view>
            <view class="comparison-cell check"><cbs-icon name="check" size="24" color="var(--green)" /></view>
            <view class="comparison-cell check"><cbs-icon name="check" size="24" color="var(--green)" /></view>
          </view>
          <view class="comparison-row">
            <view class="comparison-cell feature-cell">血统证书</view>
            <view class="comparison-cell cross"><cbs-icon name="close" size="24" color="#F54A45" /></view>
            <view class="comparison-cell cross"><cbs-icon name="close" size="24" color="#F54A45" /></view>
            <view class="comparison-cell check"><cbs-icon name="check" size="24" color="var(--green)" /></view>
          </view>
          <view class="comparison-row">
            <view class="comparison-cell feature-cell">近亲检测</view>
            <view class="comparison-cell cross"><cbs-icon name="close" size="24" color="#F54A45" /></view>
            <view class="comparison-cell check"><cbs-icon name="check" size="24" color="var(--green)" /></view>
            <view class="comparison-cell check"><cbs-icon name="check" size="24" color="var(--green)" /></view>
          </view>
          <view class="comparison-row">
            <view class="comparison-cell feature-cell">优先提醒</view>
            <view class="comparison-cell cross"><cbs-icon name="close" size="24" color="#F54A45" /></view>
            <view class="comparison-cell check"><cbs-icon name="check" size="24" color="var(--green)" /></view>
            <view class="comparison-cell check"><cbs-icon name="check" size="24" color="var(--green)" /></view>
          </view>
          <view class="comparison-row">
            <view class="comparison-cell feature-cell">专属客服</view>
            <view class="comparison-cell cross"><cbs-icon name="close" size="24" color="#F54A45" /></view>
            <view class="comparison-cell cross"><cbs-icon name="close" size="24" color="#F54A45" /></view>
            <view class="comparison-cell check"><cbs-icon name="check" size="24" color="var(--green)" /></view>
          </view>
        </view>
      </scroll-view>
    </view>

    <button class="confirm-btn" bindtap="goPayment">立即订阅</button>
  </view>
</view>
