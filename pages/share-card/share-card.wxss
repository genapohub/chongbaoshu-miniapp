.container { background: #F6F4F0; min-height: 100vh; display: flex; flex-direction: column; align-items: center; padding: 24rpx; }
.card-preview { background: #FFF; border-radius: 16rpx; padding: 16rpx; box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.12); }
.canvas { display: block; }
.actions { margin-top: 48rpx; width: 100%; }
.btn-save { width: 80%; height: 88rpx; background: #4A8C5C; color: #FFF; border-radius: 44rpx; font-size: 30rpx; font-weight: 600; display: flex; align-items: center; justify-content: center; margin: 0 auto; }
