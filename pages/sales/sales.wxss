.container { background: var(--bg); min-height: 100vh; padding: 24rpx; }
.summary-card { background: var(--green); border-radius: var(--radius); padding: 32rpx; margin-bottom: 24rpx; }
.summary-month { font-size: 26rpx; color: rgba(255,255,255,0.8); }
.summary-row { display: flex; margin-top: 24rpx; }
.summary-item { flex: 1; display: flex; flex-direction: column; align-items: center; }
.s-num { font-size: 40rpx; font-weight: 700; color: #fff; }
.s-label { font-size: 22rpx; color: rgba(255,255,255,0.7); margin-top: 8rpx; }
.sale-card { background: var(--surface); border-radius: var(--radius); padding: 24rpx; margin-bottom: 16rpx; box-shadow: var(--shadow); }
.sale-top { display: flex; justify-content: space-between; align-items: center; }
.sale-pet { font-size: 32rpx; font-weight: 600; }
.sale-price { font-size: 36rpx; font-weight: 700; color: var(--red); }
.sale-meta { display: flex; gap: 24rpx; margin-top: 12rpx; font-size: 24rpx; color: var(--text3); }
.sale-items { font-size: 24rpx; color: var(--text2); margin-top: 8rpx; }
.empty { display: flex; flex-direction: column; align-items: center; padding-top: 200rpx; }
.empty-text { font-size: 32rpx; color: var(--text3); margin-top: 24rpx; }
