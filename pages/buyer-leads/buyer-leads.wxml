<view class="page-hero">
  <view class="decor-ring r1"></view>
  <view class="decor-ring r2"></view>
  <text class="hero-title">意向客户</text>
  <text class="hero-sub">跟踪买家咨询与成交进度</text>
</view>
<view class="leads-page">
  <view class="tab-bar">
    <view wx:for="{{tabList}}" wx:key="key" class="tab-item {{currentTab === item.key ? 'active' : ''}}" bindtap="switchTab" data-tab="{{item.key}}">
      {{item.label}}
    </view>
  </view>
  
  <view wx:if="{{loading}}" class="loading-state">加载中...</view>
  
  <view wx:elif="{{error}}" class="error-state">
    <text class="error-text">加载失败，请检查网络</text>
    <view class="error-retry" bindtap="loadData">点击重试</view>
  </view>
  
  <empty-state wx:elif="{{leads.length === 0}}" icon="user" text="暂无客户" subText="添加意向客户，跟踪销售进度" />
  
  <view wx:else class="lead-list">
    <view wx:for="{{leads}}" wx:key="id" class="lead-card" bindtap="goDetail" data-id="{{item.id}}">
      <view class="lead-header">
        <text class="lead-name">{{item.buyer_name}}</text>
        <text class="lead-status {{getLeadStatusClass(item.status)}}">{{statusLabel(item.status)}}</text>
      </view>
      <view class="lead-body">
        <text wx:if="{{item.pet_name}}" class="lead-pet">🐾 {{item.pet_name}}</text>
        <text wx:if="{{item.budget}}" class="lead-budget">💰 {{item.budget}}</text>
      </view>
      <view class="lead-footer">
        <text class="lead-time">{{item.last_followed_at ? timeAgo(item.last_followed_at) : '暂无跟进'}}</text>
        <view class="lead-actions">
          <view class="lead-btn btn-outline" catchtap="quickFollow" data-id="{{item.id}}">跟进</view>
          <view wx:if="{{item.status !== 'sold'}}" class="lead-btn btn-green" catchtap="markSold" data-id="{{item.id}}">成交</view>
        </view>
      </view>
    </view>
  </view>
  
  <view class="fab-btn" bindtap="goAdd">+</view>
</view>
