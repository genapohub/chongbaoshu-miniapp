.leads-page { min-height: 100vh; background: var(--bg); padding-bottom: 200rpx; }

.tab-bar {
  display: flex; background: var(--surface);
  border-bottom: 1rpx solid var(--line);
}
.tab-item {
  flex: 1; text-align: center; padding: 28rpx 0;
  font-size: 28rpx; color: var(--text3); position: relative;
}
.tab-item.active { color: var(--green); font-weight: 700; }
.tab-item.active::after {
  content: ''; position: absolute; bottom: 0; left: 50%;
  transform: translateX(-50%); width: 48rpx; height: 4rpx;
  background: var(--green); border-radius: 2rpx;
}

.loading-state { padding: 120rpx; text-align: center; }

.error-state { padding: 180rpx var(--sp-lg); text-align: center; }
.error-text { font-size: 28rpx; color: var(--text3); display: block; }
.error-retry {
  margin-top: 32rpx; padding: 20rpx 48rpx;
  background: var(--green); color: #fff;
  border-radius: 48rpx; font-size: 28rpx; display: inline-block;
}

.lead-list { padding: var(--sp-lg); }
.lead-card {
  background: var(--surface); border-radius: var(--radius);
  padding: var(--sp-lg); margin-bottom: var(--sp-md);
  box-shadow: var(--shadow);
}
.lead-header { display: flex; justify-content: space-between; align-items: center; }
.lead-name { font-size: 32rpx; font-weight: 700; color: var(--text); }
.lead-status {
  font-size: 22rpx; padding: 6rpx 16rpx; border-radius: 8rpx;
  font-weight: 600;
}
.lead-status-consulting { background: #E3F2FD; color: var(--green); }
.lead-status-negotiating { background: #FFF4E5; color: var(--amber); }
.lead-status-sold { background: #EDF4EF; color: var(--green); }
.lead-status-lost { background: #FDEDEC; color: var(--red); }
.lead-body { display: flex; gap: 20rpx; margin-top: 16rpx; }
.lead-pet, .lead-budget { font-size: 24rpx; color: var(--text2); }
.lead-footer { display: flex; justify-content: space-between; align-items: center; margin-top: 20rpx; }
.lead-time { font-size: 22rpx; color: var(--text3); }
.lead-actions { display: flex; gap: 16rpx; }
.lead-btn {
  font-size: 24rpx; padding: 12rpx 28rpx; border-radius: 24rpx;
  font-weight: 600;
}
.lead-btn.btn-outline {
  background: transparent; border: 2rpx solid var(--green);
  color: var(--green);
}
.lead-btn.btn-green { background: var(--green); color: #fff; }
