.container {
  min-height: 100vh;
  background: #F5F5F5;
  padding-bottom: 160rpx;
}

.form-section {
  padding: 24rpx;
}

.form-item {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  position: relative;
}

.form-item.required .form-label::before {
  content: '*';
  color: #4A8C5C;
  margin-right: 8rpx;
}

.form-label {
  font-size: 28rpx;
  color: #2D2A26;
  margin-bottom: 16rpx;
  display: block;
}

.picker-wrap {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx;
  background: #F6F4F0;
  border-radius: 12rpx;
}

.pet-display {
  display: flex;
  align-items: center;
  flex: 1;
}

.pet-avatar-small {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  background: #F5F5F5;
}

.pet-avatar-small.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #FFE4E1, #FFC0CB);
}

.pet-text-wrap {
  display: flex;
  align-items: center;
  flex: 1;
}

.pet-picker.disabled {
  background: #EDEDEF;
}

.pet-picker.disabled .pet-text {
  color: #948F89;
}

.pet-text {
  font-size: 30rpx;
  color: #2D2A26;
}

.pet-text.placeholder {
  color: #948F89;
}

.pet-detail {
  font-size: 26rpx;
  color: #948F89;
  margin-left: 8rpx;
}

.picker-arrow {
  font-size: 24rpx;
  color: #948F89;
}

.error-tip {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #4A8C5C;
}

.date-picker {
  padding: 20rpx;
  background: #F6F4F0;
  border-radius: 12rpx;
}

.date-icon {
  font-size: 32rpx;
}

.due-date-card {
  background: #F0FFF4;
  border: 2rpx solid #81C784;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.due-date-main {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.due-date-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.due-date-label {
  font-size: 28rpx;
  color: #2D2A26;
}

.due-date-value {
  font-size: 30rpx;
  font-weight: 600;
  color: #2E7D32;
}

.due-date-note {
  font-size: 24rpx;
  color: #5E5953;
  line-height: 1.5;
}

.breed-method-group {
  display: flex;
  gap: 20rpx;
}

.method-option {
  flex: 1;
  padding: 24rpx;
  text-align: center;
  border-radius: 12rpx;
  border: 2rpx solid #E0E0E0;
  font-size: 28rpx;
  color: #5E5953;
}

.method-option.active {
  border-color: #4A8C5C;
  background: #FFF5F7;
  color: #4A8C5C;
  font-weight: 600;
}

.count-control {
  display: flex;
  align-items: center;
  gap: 32rpx;
}

.count-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  border: 2rpx solid #E0E0E0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #5E5953;
}

.count-btn.plus {
  border-color: #4A8C5C;
  background: #FFF5F7;
  color: #4A8C5C;
}

.count-value {
  font-size: 32rpx;
  font-weight: 600;
  color: #2D2A26;
}

/* textarea 已提取为 notes-textarea 组件 */

.submit-section {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx;
  background: #FFFFFF;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.btn {
  width: 100%;
  height: 96rpx;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  padding: 0;
}

.btn::after {
  border: none;
}

.btn-primary {
  background: linear-gradient(135deg, #4A8C5C, #4A8C5C);
  color: #FFFFFF;
}

.btn-primary[disabled] {
  background: #DDDDDD;
  color: #948F89;
}

.picker-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: flex-end;
  z-index: 1000;
}

.picker-content {
  width: 100%;
  background: #FFFFFF;
  border-radius: 24rpx 24rpx 0 0;
  max-height: 70vh;
  overflow: hidden;
}

.picker-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  border-bottom: 1rpx solid #EEEEEE;
}

.picker-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #2D2A26;
}

.picker-close {
  font-size: 48rpx;
  color: #948F89;
  line-height: 1;
}

.picker-list {
  max-height: 50vh;
}

.picker-empty {
  padding: 80rpx 32rpx;
  text-align: center;
  color: #948F89;
  font-size: 28rpx;
}

.picker-item {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #F5F5F5;
}

.picker-item.selected {
  background: #FFF5F7;
}

.pet-item {
  display: flex;
  align-items: center;
  width: 100%;
}

.pet-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 24rpx;
  background: #F5F5F5;
}

.pet-avatar.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #FFE4E1, #FFC0CB);
}

.avatar-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #4A8C5C;
}

.pet-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.pet-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #2D2A26;
}

.pet-breed {
  font-size: 24rpx;
  color: #948F89;
  margin-top: 4rpx;
}

/* 近亲检测结果 */
.inbreeding-result {
  display: flex;
  align-items: flex-start;
  padding: 24rpx;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  gap: 16rpx;
}

.inbreeding-result.warning {
  background: #FFF3CD;
  border: 2rpx solid #FFC107;
}

.inbreeding-result.success {
  background: #E8F5E9;
  border: 2rpx solid #81C784;
}

.inbreeding-icon {
  font-size: 32rpx;
  flex-shrink: 0;
}

.inbreeding-text {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.inbreeding-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #2D2A26;
}

.inbreeding-result.warning .inbreeding-title {
  color: #F57C00;
}

.inbreeding-result.success .inbreeding-title {
  color: #2E7D32;
}

.inbreeding-message {
  font-size: 26rpx;
  color: #5E5953;
  line-height: 1.5;
}