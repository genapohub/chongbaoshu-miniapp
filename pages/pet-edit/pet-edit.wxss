/* P5 编辑宠物页面样式 - 页面特有样式，通用样式已提取到 app.wxss */

.container {
  min-height: 100vh;
  background: #F8F9FA;
  padding-bottom: env(safe-area-inset-bottom);
}

/* 输入框 */
.input-field.small {
  padding: 16rpx 20rpx;
  font-size: 26rpx;
}

/* 头像上传 */
.avatar-upload {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: 2rpx dashed #DDDDDD;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  background: #F8F9FA;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.avatar-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #999;
}

.avatar-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.avatar-text {
  font-size: 22rpx;
}

/* 性别选择 */
.gender-options {
  display: flex;
  gap: 24rpx;
}

.gender-option {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  background: #F8F9FA;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #666;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.gender-option.active {
  background: #FFF0F3;
  color: #E94560;
  border-color: #E94560;
}

/* 血统信息区域 */
.toggle-arrow {
  font-size: 36rpx;
  color: #999;
}

.pedigree-section {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #EEEEEE;
}

/* 标签选项 */
.tag-options {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.tag-option {
  padding: 12rpx 24rpx;
  background: #F8F9FA;
  border-radius: 24rpx;
  font-size: 26rpx;
  color: #666;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.tag-option.selected {
  background: #FFF0F3;
  color: #E94560;
  border-color: #E94560;
}

/* 添加标签行 */
.add-tag-row {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.add-tag-row .input-field.small {
  flex: 1;
}

.btn-add-tag {
  padding: 16rpx 32rpx;
  background: #E94560;
  color: #FFFFFF;
  border-radius: 12rpx;
  font-size: 26rpx;
}

/* 物种选择弹窗已提取为 picker-modal 组件 */
