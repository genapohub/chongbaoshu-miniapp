/* P5 编辑宠物页面样式 - 按设计稿一比一复刻 */

.container {
  min-height: 100vh;
  background: #F7F8FA;
  padding-bottom: env(safe-area-inset-bottom);
}

/* 卡片 */
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin: 20rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 24rpx;
}

/* 表单区域 */
.form-section {
  padding: 16rpx 0;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 12rpx;
  font-weight: 500;
}

/* 输入框 */
.input-field {
  background: #F8F9FA;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #333;
}

.input-field.small {
  padding: 16rpx 20rpx;
  font-size: 26rpx;
}

/* 头像上传 */
.avatar-upload {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: 2rpx dashed #DDDDDD;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  background: #F8F9FA;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.avatar-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #999;
}

.avatar-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.avatar-text {
  font-size: 22rpx;
}

/* 选择器包装 */
.picker-wrap {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #F8F9FA;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
}

.picker-value {
  color: #333;
}

.picker-value:empty {
  color: #999;
}

.picker-arrow {
  color: #999;
  font-size: 36rpx;
}

/* 性别选择 */
.gender-options {
  display: flex;
  gap: 24rpx;
}

.gender-option {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  background: #F8F9FA;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #666;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.gender-option.active {
  background: #FFF0F3;
  color: #E94560;
  border-color: #E94560;
}

/* 血统信息区域 */
.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.toggle-arrow {
  font-size: 36rpx;
  color: #999;
}

.pedigree-section {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #EEEEEE;
}

/* 标签选项 */
.tag-options {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.tag-option {
  padding: 12rpx 24rpx;
  background: #F8F9FA;
  border-radius: 24rpx;
  font-size: 26rpx;
  color: #666;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.tag-option.selected {
  background: #FFF0F3;
  color: #E94560;
  border-color: #E94560;
}

/* 添加标签行 */
.add-tag-row {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.add-tag-row .input-field.small {
  flex: 1;
}

.btn-add-tag {
  padding: 16rpx 32rpx;
  background: #E94560;
  color: #FFFFFF;
  border-radius: 12rpx;
  font-size: 26rpx;
}

/* 提交区域 */
.submit-section {
  padding: 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.btn-primary {
  background: #E94560;
  color: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
}

/* 物种选择弹窗 */
.picker-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: flex-end;
  z-index: 1000;
}

.picker-content {
  width: 100%;
  background: #FFFFFF;
  border-radius: 24rpx 24rpx 0 0;
  max-height: 70vh;
  overflow: hidden;
}

.picker-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  border-bottom: 1rpx solid #EEEEEE;
}

.picker-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.picker-close {
  font-size: 48rpx;
  color: #999;
  line-height: 1;
}

.picker-list {
  max-height: 50vh;
}

.picker-item {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #F5F5F5;
}

.picker-item:last-child {
  border-bottom: none;
}

.picker-item.selected {
  background: #FFF0F3;
}

.picker-item-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}

.picker-item-text {
  font-size: 30rpx;
  color: #333;
}

.picker-item.selected .picker-item-text {
  color: #E94560;
}
