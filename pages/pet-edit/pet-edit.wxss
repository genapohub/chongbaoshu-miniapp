/* 编辑宠物页面 — 暖森林·毛玻璃 */
.container {
  min-height: 100vh;
  background: var(--bg);
  padding: 32rpx 32rpx 200rpx;
  box-sizing: border-box;
}

/* 卡片通用 */
.card {
  background: var(--surface);
  -webkit-backdrop-filter: var(--glass);
  backdrop-filter: var(--glass);
  border-radius: var(--radius);
  padding: 36rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow);
}

.card-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 28rpx;
  letter-spacing: 0.5rpx;
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.card-header .card-title {
  margin-bottom: 0;
}

/* 表单区块 */
.form-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.form-item {
  margin-bottom: 28rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label {
  display: block;
  font-size: 26rpx;
  color: var(--text2);
  margin-bottom: 14rpx;
  font-weight: 500;
  letter-spacing: 0.4rpx;
}

/* 头像上传 */
.avatar-upload {
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.03);
  border: 2rpx dashed var(--line);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  position: relative;
}

.avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.avatar-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}

.avatar-text {
  font-size: 22rpx;
  color: var(--text3);
  letter-spacing: 0.4rpx;
}

/* 输入框 */
.input-field {
  background: rgba(0, 0, 0, 0.03);
  border-radius: var(--radius-sm);
  padding: 22rpx 24rpx;
  font-size: 28rpx;
  border: 2rpx solid transparent;
  color: var(--text);
  width: 100%;
  box-sizing: border-box;
  transition: border-color 0.2s ease;
}

.input-field:focus {
  border-color: var(--green);
  background: #fff;
}

.input-field::placeholder {
  color: var(--text3);
}

.input-field.small {
  flex: 1;
  padding: 18rpx 24rpx;
  font-size: 26rpx;
}

/* 选择器 */
.picker-wrap {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(0, 0, 0, 0.03);
  border-radius: var(--radius-sm);
  padding: 22rpx 24rpx;
  border: 2rpx solid transparent;
  transition: border-color 0.2s ease;
}

.picker-wrap:active {
  border-color: var(--green);
}

.picker-value {
  font-size: 28rpx;
  color: var(--text);
  letter-spacing: 0.3rpx;
}

/* 性别选项 */
.gender-options {
  display: flex;
  gap: 20rpx;
}

.gender-option {
  flex: 1;
  height: 88rpx;
  border-radius: var(--radius-sm);
  background: rgba(0, 0, 0, 0.03);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: var(--text2);
  border: 2rpx solid transparent;
  transition: all 0.2s ease;
}

.gender-option:active {
  background: rgba(74, 140, 92, 0.08);
}

.gender-option.active {
  background: rgba(74, 140, 92, 0.12);
  color: var(--green-dark);
  border-color: var(--green);
  font-weight: 600;
}

/* 血统信息折叠 */
.pedigree-section {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--line);
}

/* 标签选择 */
.tag-options {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.tag-option {
  padding: 14rpx 28rpx;
  background: rgba(0, 0, 0, 0.03);
  border-radius: var(--radius-full);
  font-size: 26rpx;
  color: var(--text2);
  border: 2rpx solid transparent;
  transition: all 0.2s ease;
  letter-spacing: 0.4rpx;
}

.tag-option:active {
  background: rgba(74, 140, 92, 0.08);
}

.tag-option.selected {
  background: rgba(74, 140, 92, 0.12);
  color: var(--green-dark);
  border-color: var(--green);
  font-weight: 500;
}

/* 自定义标签添加 */
.add-tag-row {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.btn-add-tag {
  flex-shrink: 0;
  padding: 18rpx 32rpx;
  background: var(--green);
  color: #fff;
  font-size: 26rpx;
  border-radius: var(--radius-full);
  font-weight: 500;
  letter-spacing: 0.4rpx;
}

.btn-add-tag:active {
  opacity: 0.88;
}

/* 提交按钮 */
.submit-section {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  background: var(--surface-solid);
  box-shadow: 0 -4rpx 32rpx rgba(0, 0, 0, 0.06);
  z-index: 10;
}

.btn-primary {
  height: 96rpx;
  line-height: 96rpx;
  background: var(--green);
  color: #fff;
  border-radius: var(--radius-full);
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  border: none;
  letter-spacing: 1rpx;
}

.btn-primary::after {
  border: none;
}

.btn-primary:active {
  opacity: 0.88;
}

.btn-primary.disabled {
  opacity: 0.5;
  pointer-events: none;
}
