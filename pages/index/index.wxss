/* P1 工作台首页样式 - 按设计稿一比一复刻 */

/* 容器 */
.container {
  padding: 24rpx;
  padding-bottom: 120rpx;
  min-height: 100vh;
  background: #F7F8FA;
}

/* 升级引导条 */
.upgrade-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(90deg, #E94560, #FD79A8);
  border-radius: 16rpx;
  padding: 20rpx 28rpx;
  margin-bottom: 24rpx;
  color: #fff;
}

.upgrade-content {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.upgrade-icon {
  font-size: 32rpx;
}

.upgrade-text {
  font-size: 26rpx;
  font-weight: 600;
}

.upgrade-arrow {
  font-size: 28rpx;
}

/* 订阅状态卡片 */
.sub-status-card {
  background: linear-gradient(135deg, #E94560, #FD79A8);
  border-radius: 24rpx;
  padding: 32rpx;
  color: #fff;
  margin-bottom: 24rpx;
}

.ssc-label {
  font-size: 22rpx;
  opacity: 0.7;
}

.ssc-plan {
  font-size: 36rpx;
  font-weight: 800;
  margin-top: 8rpx;
}

.ssc-meta {
  display: flex;
  justify-content: space-between;
  margin-top: 20rpx;
  font-size: 22rpx;
  opacity: 0.8;
}

.ssc-upgrade {
  color: #fff;
  cursor: pointer;
}

/* 数据概览 */
.data-overview {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.data-card {
  border-radius: 16rpx;
  padding: 24rpx;
  color: #fff;
  text-align: center;
}

.data-card.primary {
  background: linear-gradient(135deg, #E94560, #C73650);
}

.data-card.orange {
  background: linear-gradient(135deg, #F2994A, #FDCB6E);
}

.data-card.green {
  background: linear-gradient(135deg, #27AE60, #55EFC4);
}

.data-num {
  font-size: 48rpx;
  font-weight: 700;
  display: block;
}

.data-label {
  font-size: 22rpx;
  opacity: 0.85;
  margin-top: 8rpx;
}

/* 卡片通用样式 */
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.06);
}

.card-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
  display: block;
}

/* 今日提醒 */
.reminder-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F3F4F6;
}

.reminder-row:last-child {
  border-bottom: none;
}

.reminder-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.reminder-text {
  flex: 1;
  font-size: 26rpx;
}

.reminder-badge {
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.empty-state {
  text-align: center;
  padding: 40rpx;
}

/* 快捷入口 */
.quick-entry {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20rpx;
}

.quick-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  position: relative;
}

.quick-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
}

.quick-icon.primary {
  background: #FDE8EC;
}

.quick-icon.orange {
  background: #FFF3E0;
}

.quick-icon.green {
  background: #E8F5E9;
}

.quick-icon.purple {
  background: #F3E5F5;
}

.quick-label {
  font-size: 22rpx;
  color: #6B7280;
}

.pro-item {
  position: relative;
}

.pro-badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  background: linear-gradient(135deg, #E94560, #FD79A8);
  color: #fff;
  font-size: 18rpx;
  font-weight: 700;
  padding: 4rpx 12rpx;
  border-radius: 16rpx;
  letter-spacing: 1rpx;
}

/* 最近动态 */
.activity-row {
  padding: 12rpx 0;
  border-bottom: 1rpx solid #F3F4F6;
}

.activity-row:last-child {
  border-bottom: none;
}

.activity-text {
  font-size: 26rpx;
  display: block;
}

.activity-time {
  font-size: 22rpx;
  color: #9CA3AF;
  margin-top: 4rpx;
  display: block;
}

/* 未登录状态 */
.login-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
  text-align: center;
}

.login-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}

.login-title {
  font-size: 48rpx;
  font-weight: 800;
  color: #E94560;
}

.login-subtitle {
  font-size: 28rpx;
  color: #6B7280;
  margin-top: 16rpx;
}

/* 按钮 */
.btn-primary {
  width: 100%;
  background: #E94560;
  color: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
  margin-top: 48rpx;
}

/* 通用样式 */
.flex-between {
  display: flex;
  justify-content: space-between;
}

.flex-row {
  display: flex;
  flex-direction: row;
}