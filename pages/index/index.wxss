/* ══════════════════════════════════════════════
   首页 Dashboard — 暖森林 2.0（onboarding 设计语言）
   ══════════════════════════════════════════════ */

.home-scroll {
  padding-bottom: 200rpx;
  min-height: 100vh;
  background: var(--bg);
}

/* ── 加载 / 错误状态 ── */
.loading-state {
  padding: 200rpx 0;
  text-align: center;
  display: flex;
  justify-content: center;
  align-items: center;
}
.error-state {
  padding: 200rpx var(--sp-lg);
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.error-text {
  font-size: 28rpx;
  color: var(--text3);
  display: block;
  margin-top: var(--sp-md);
}
.error-retry {
  margin-top: var(--sp-lg);
  padding: 20rpx 56rpx;
  background: var(--green);
  color: #fff;
  border-radius: var(--radius-full);
  font-size: 28rpx;
  font-weight: 600;
  display: inline-block;
  box-shadow: 0 8rpx 24rpx rgba(74,140,92,0.25);
}
.error-retry:active { opacity: 0.9; transform: scale(0.98); }

/* ── 顶部 hero 区（绿色渐变 + 装饰圆环） ── */
.home-hero {
  padding: 64rpx 48rpx 128rpx;
  position: relative;
  overflow: hidden;
}
.hr1 { width: 420rpx; height: 420rpx; top: -140rpx; right: -150rpx; }
.hr2 { width: 260rpx; height: 260rpx; bottom: 40rpx; left: -110rpx; }
.hr3 { width: 130rpx; height: 130rpx; top: 200rpx; right: 48rpx; }

.hero-inner {
  position: relative;
  z-index: 1;
}
.hero-title {
  font-size: 48rpx;
  font-weight: 800;
  color: #2D2A26;
  display: block;
  letter-spacing: -1rpx;
}
.hero-sub {
  font-size: 26rpx;
  color: #5E5953;
  margin-top: 12rpx;
  display: block;
}
.hero-plan {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.hero-upgrade {
  display: inline-block;
  padding: 4rpx 20rpx;
  background: rgba(74,140,92,0.14);
  color: #4A8C5C;
  font-size: 22rpx;
  font-weight: 700;
  border-radius: var(--radius-full);
}
.hero-login-btn {
  margin-top: 32rpx;
  display: inline-block;
  padding: 20rpx 56rpx;
  background: #4A8C5C;
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  border-radius: 48rpx;
  box-shadow: 0 8rpx 24rpx rgba(74,140,92,0.30);
}
.hero-login-btn:active { opacity: 0.9; transform: scale(0.98); }

/* ── 数据概览（白色浮起卡） ── */
.stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--sp-sm);
  margin: -88rpx 40rpx 0;
  position: relative;
  z-index: 2;
}
.stat {
  background: #FFFFFF;
  border-radius: var(--radius);
  padding: 32rpx 16rpx 28rpx;
  text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.08);
}
.stat-num {
  font-size: 48rpx;
  font-weight: 800;
  display: block;
  line-height: 1.1;
  letter-spacing: -1rpx;
}
.stat-green { color: #4A8C5C; }
.stat-amber { color: #D4914A; }
.stat-teal  { color: #3D8B37; }
.stat-label {
  font-size: 22rpx;
  color: #948F89;
  margin-top: 8rpx;
  display: block;
  letter-spacing: 1rpx;
}

/* ── 卡片通用（毛玻璃） ── */
.card {
  background: var(--surface);
  -webkit-backdrop-filter: var(--glass);
  backdrop-filter: var(--glass);
  border-radius: var(--radius);
  padding: var(--sp-lg);
  margin: var(--sp-md) var(--sp-lg) 0;
  box-shadow: var(--shadow);
  border: 1rpx solid rgba(255,255,255,0.6);
}
.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text);
  margin-bottom: var(--sp-md);
  display: block;
  letter-spacing: -0.5rpx;
}

/* ── 待办提醒列表 ── */
.reminder {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.reminder:last-child { border-bottom: none; padding-bottom: 0; }
.reminder:first-child { padding-top: 0; }
.reminder:active { opacity: 0.7; }
.rem-icon {
  font-size: 44rpx;
  width: 80rpx;
  height: 80rpx;
  text-align: center;
  line-height: 80rpx;
  background: rgba(74,140,92,0.08);
  border-radius: var(--radius-sm);
  margin-right: var(--sp-md);
  flex-shrink: 0;
}
.rem-content { flex: 1; min-width: 0; }
.rem-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
  display: block;
  line-height: 1.4;
}
.rem-type {
  font-size: 24rpx;
  color: var(--text2);
  margin-top: 6rpx;
  display: block;
}

/* ── 徽章（提醒状态） ── */
.badge {
  font-size: 20rpx;
  padding: 4rpx 16rpx;
  border-radius: var(--radius-full);
  font-weight: 600;
  margin-left: 12rpx;
  vertical-align: middle;
}
.badge-red    { background: rgba(212,83,74,0.15);  color: var(--red); }
.badge-orange { background: rgba(212,145,74,0.18); color: var(--amber); }
.badge-green  { background: rgba(74,140,92,0.15);  color: var(--green); }

/* ── 快捷入口 4列grid ── */
.grid4 {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: var(--sp-md) 0;
}
.quick-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  position: relative;
  padding: 8rpx 0;
}
.quick-item:active { opacity: 0.7; transform: scale(0.96); }
.quick-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: var(--radius-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.05);
  border: 1rpx solid rgba(255,255,255,0.8);
}
.quick-label {
  font-size: 22rpx;
  color: var(--text2);
  font-weight: 500;
}
