.home-scroll { padding-bottom: 180rpx; }

.upgrade-bar {
  display: flex; align-items: center; justify-content: space-between;
  background: rgba(74,140,92,0.1); border-radius: var(--radius);
  padding: 24rpx 32rpx; margin: var(--sp-lg);
  font-size: 26rpx; font-weight: 600; color: var(--green);
}
.upgrade-arrow { font-size: 32rpx; opacity: 0.5; }

.card-green {
  background: linear-gradient(135deg, var(--green) 0%, var(--green-dark) 100%);
  color: #fff;
}

.card-sm { padding: 32rpx; }

.sub-label { font-size: 22rpx; opacity: 0.7; display: block; }
.sub-plan { font-size: 36rpx; font-weight: 800; margin-top: 8rpx; display: block; }
.sub-meta {
  display: flex; justify-content: space-between; margin-top: 24rpx;
  font-size: 22rpx; opacity: 0.85;
}

.stats {
  display: flex; gap: var(--sp-md); padding: 0 var(--sp-lg); margin-bottom: var(--sp-lg);
}
.stat {
  flex: 1; border-radius: var(--radius); padding: 28rpx 20rpx;
  text-align: center;
}
.stat.bg-green { background: var(--green); }
.stat.bg-amber { background: var(--amber); }
.stat.bg-teal { background: var(--teal); }
.stat-num { font-size: 48rpx; font-weight: 800; color: #fff; display: block; }
.stat-label { font-size: 22rpx; color: rgba(255,255,255,0.8); margin-top: 8rpx; display: block; }

.section-title { font-size: 28rpx; font-weight: 700; color: var(--text); margin-bottom: var(--sp-md); display: block; }

.reminder {
  display: flex; align-items: center; padding: 20rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.reminder:last-child { border-bottom: none; }
.rem-icon { font-size: 48rpx; width: 72rpx; text-align: center; }
.rem-content { flex: 1; }
.rem-name { font-size: 28rpx; font-weight: 600; color: var(--text); display: block; }
.rem-type { font-size: 24rpx; color: var(--text2); margin-top: 6rpx; display: block; }

.grid4 {
  display: grid; grid-template-columns: repeat(4, 1fr); gap: 32rpx;
}
.quick-item {
  display: flex; flex-direction: column; align-items: center; gap: 12rpx;
  position: relative;
}
.quick-icon {
  width: 80rpx; height: 80rpx; border-radius: var(--radius-sm);
  display: flex; align-items: center; justify-content: center;
  font-size: 36rpx;
}
.quick-label { font-size: 22rpx; color: var(--text2); }

.loading-state { padding: 120rpx; text-align: center; }
.error-state { padding: 180rpx var(--sp-lg); text-align: center; }
.error-text { font-size: 28rpx; color: var(--text3); display: block; }
.error-retry {
  margin-top: 32rpx; padding: 20rpx 48rpx;
  background: var(--green); color: #fff;
  border-radius: 48rpx; font-size: 28rpx; display: inline-block;
}
