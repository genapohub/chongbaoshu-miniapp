<view class="home-scroll">
  <view wx:if="{{loading}}" class="loading-state">
    <loading-spinner />
  </view>

  <view wx:elif="{{error}}" class="error-state">
    <text class="error-text">数据加载失败，请检查网络</text>
    <view class="error-retry" bindtap="loadData">点击重试</view>
  </view>

  <view wx:else>
    <!-- 顶部 hero 区（绿色渐变 + 装饰圆环） -->
    <view class="hero home-hero">
      <view class="decor-ring hr1"></view>
      <view class="decor-ring hr2"></view>
      <view class="decor-ring hr3"></view>
      <view class="hero-inner">
        <text class="hero-title">{{showLoginGuide ? '欢迎来到宠宝树' : '宠宝树'}}</text>
        <text wx:if="{{showLoginGuide}}" class="hero-sub">宠物档案 · 繁育记录 · 健康提醒</text>
        <view wx:else class="hero-sub hero-plan" bindtap="goSubscribe">
          <text>当前方案 · {{subscriptionPlan}}</text>
          <text wx:if="{{subscriptionTier !== 'pro'}}" class="hero-upgrade">升级 ›</text>
        </view>
        <view wx:if="{{showLoginGuide}}" class="hero-login-btn" bindtap="goLogin">微信登录</view>
      </view>
    </view>

    <!-- 数据概览（白色浮起卡） -->
    <view class="stats">
      <view class="stat">
        <text class="stat-num stat-green">{{petCount}}</text>
        <text class="stat-label">宠物</text>
      </view>
      <view class="stat">
        <text class="stat-num stat-amber">{{breedingInProgressCount}}</text>
        <text class="stat-label">繁育中</text>
      </view>
      <view class="stat">
        <text class="stat-num stat-teal">{{reminderCount}}</text>
        <text class="stat-label">健康记录</text>
      </view>
    </view>

    <view class="card">
      <text class="section-title">⏰ 待办提醒</text>
      <view wx:if="{{reminders.length > 0}}">
        <view
          wx:for="{{reminders}}"
          wx:key="id"
          class="reminder"
          bindtap="onReminderTap"
          data-item="{{item}}"
        >
          <view class="rem-icon">{{item.iconEmoji}}</view>
          <view class="rem-content">
            <text class="rem-name">{{item.petName}}<text class="badge badge-red" wx:if="{{item.status === 'overdue'}}">已过期</text><text class="badge badge-orange" wx:elif="{{item.status === 'soon'}}">即将到期</text><text class="badge badge-green" wx:else>计划中</text></text>
            <text class="rem-type">{{item.typeText}}</text>
          </view>
        </view>
      </view>
      <empty-state wx:else type="no-record" text="暂无待办提醒" subText="宠物健康和繁育提醒会显示在这里" />
    </view>

    <view class="card">
      <text class="section-title">💼 生意管理</text>
      <view class="grid4">
        <view class="quick-item" bindtap="goBuyerLeads">
          <view class="quick-icon" style="background:#EDF4EF">👤</view>
          <text class="quick-label">意向客户</text>
        </view>
        <view class="quick-item" bindtap="goSales">
          <view class="quick-icon" style="background:#FFF3E0">💰</view>
          <text class="quick-label">销售记录</text>
        </view>
        <view class="quick-item" bindtap="goLedger">
          <view class="quick-icon" style="background:#FFF4E5">📒</view>
          <text class="quick-label">收支账本</text>
        </view>
        <view class="quick-item" bindtap="goLitters">
          <view class="quick-icon" style="background:#E8F5E9">🍼</view>
          <text class="quick-label">同窝管理</text>
        </view>
      </view>
    </view>

    <view class="card">
      <text class="section-title">⚡ 快捷入口</text>
      <view class="grid4">
        <view class="quick-item" bindtap="goAddPet">
          <view class="quick-icon" style="background:#EDF4EF">➕</view>
          <text class="quick-label">添加宠物</text>
        </view>
        <view class="quick-item" bindtap="goAddBreeding">
          <view class="quick-icon" style="background:#FFF4E5">🐕</view>
          <text class="quick-label">添加配种</text>
        </view>
        <view class="quick-item" bindtap="goAddHealth">
          <view class="quick-icon" style="background:#E8F5E9">💚</view>
          <text class="quick-label">健康记录</text>
        </view>
        <view class="quick-item" bindtap="goRemindSettings">
          <view class="quick-icon" style="background:#FFF3E0">🔔</view>
          <text class="quick-label">提醒设置</text>
        </view>
      </view>
    </view>

    <view class="card">
      <text class="section-title">🕐 最近动态</text>
      <view wx:if="{{recentActivities.length > 0}}">
        <view wx:for="{{recentActivities}}" wx:key="key" class="activity">
          <view class="activity-icon">
            <cbs-icon name="{{item.icon}}" size="28" color="{{item.iconColor}}" />
          </view>
          <text class="activity-text">{{item.text}}</text>
          <text class="activity-time">{{item.time}}</text>
        </view>
      </view>
      <empty-state wx:else type="no-record" text="暂无动态" subText="添加宠物、记录健康后会显示在这里" />
    </view>
  </view>
</view>
