<view class="container">
  <view class="card">
    <view class="card-header">
      <view class="card-icon"><icon name="syringe" size="36" color="#2D9CDB" /></view>
      <text class="card-title">疫苗提醒</text>
    </view>
    <view class="setting-item">
      <text class="setting-label">到期提醒</text>
      <switch
        checked="{{settings.remind_vaccine}}"
        color="#3370FF"
        bindchange="onSwitchChange"
        data-field="remind_vaccine"
      />
    </view>
    <view class="setting-item pro-locked" bindtap="showDaysPicker" data-type="vaccine">
      <text class="setting-label">提前提醒天数</text>
      <view class="setting-right">
        <text class="setting-value">{{settings.remind_vaccine_days}}天</text>
        <text class="setting-arrow"><icon name="chevron-right" size="28" color="#C0C4CC" /></text>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="card-header">
      <view class="card-icon"><icon name="bug" size="36" color="#2BA471" /></view>
      <text class="card-title">驱虫提醒</text>
    </view>
    <view class="setting-item">
      <text class="setting-label">到期提醒</text>
      <switch
        checked="{{settings.remind_deworm}}"
        color="#3370FF"
        bindchange="onSwitchChange"
        data-field="remind_deworm"
      />
    </view>
    <view class="setting-item pro-locked" bindtap="showDaysPicker" data-type="deworm">
      <text class="setting-label">提前提醒天数</text>
      <view class="setting-right">
        <text class="setting-value">{{settings.remind_deworm_days}}天</text>
        <text class="setting-arrow"><icon name="chevron-right" size="28" color="#C0C4CC" /></text>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="card-header">
      <view class="card-icon"><icon name="pregnant" size="36" color="#F54A45" /></view>
      <text class="card-title">配种提醒</text>
    </view>
    <view class="setting-item">
      <text class="setting-label">预产期提醒</text>
      <switch
        checked="{{settings.remind_due}}"
        color="#3370FF"
        bindchange="onSwitchChange"
        data-field="remind_due"
      />
    </view>
    <view class="setting-item pro-locked" bindtap="showDaysPicker" data-type="due">
      <text class="setting-label">提前提醒天数</text>
      <view class="setting-right">
        <text class="setting-value">{{settings.remind_due_days}}天</text>
        <text class="setting-arrow"><icon name="chevron-right" size="28" color="#C0C4CC" /></text>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="card-header">
      <view class="card-icon"><icon name="announcement" size="36" color="#646A73" /></view>
      <text class="card-title">通知方式</text>
    </view>
    <view class="setting-item">
      <text class="setting-label">站内通知</text>
      <switch
        checked="{{settings.notify_in_app}}"
        color="#3370FF"
        bindchange="onSwitchChange"
        data-field="notify_in_app"
      />
    </view>
    <view class="setting-item">
      <text class="setting-label">微信推送</text>
      <switch
        checked="{{settings.notify_wechat}}"
        color="#3370FF"
        bindchange="onSwitchChange"
        data-field="notify_wechat"
      />
    </view>
    <view class="setting-item">
      <text class="setting-label">短信通知<text class="coming-soon">即将上线</text></text>
      <switch
        checked="{{settings.notify_sms}}"
        color="#E8E8E8"
        bindchange="onSwitchChange"
        data-field="notify_sms"
        disabled
      />
    </view>
  </view>

  <view class="pro-banner">
    <view class="pro-icon"><icon name="diamond" size="36" color="#3370FF" /></view>
    <text class="pro-text">Pro专属：自定义提醒时间 + 多渠道通知（微信+短信）</text>
  </view>
</view>

<view wx:if="{{pickerTitle}}" class="picker-modal" bindtap="hideDaysPicker">
  <view class="picker-content" catchtap="stopPropagation">
    <view class="picker-header">
      <text class="picker-title">{{pickerTitle}}</text>
      <view class="picker-close" bindtap="hideDaysPicker"><icon name="close" size="28" color="#8F959E" /></view>
    </view>
    <scroll-view scroll-y class="picker-list">
      <view
        wx:for="{{pickerOptions}}"
        wx:key="*this"
        class="picker-item {{pickerCurrentValue === item ? 'selected' : ''}}"
        bindtap="selectDays"
        data-value="{{item}}"
      >
        <text class="picker-item-text">{{item}}天</text>
      </view>
    </scroll-view>
  </view>
</view>
