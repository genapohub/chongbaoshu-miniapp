<!-- 空状态组件 (飞书风格)
  Properties:
    icon {String} - 图标名称（飞书图标），默认根据 type 自动匹配
    text {String} - 提示文字
    type {String} - empty | error | network | no-pet | no-record
    actionText {String} - 操作按钮文案
-->
<view class="empty-state empty-{{type || 'empty'}}">
  <view class="empty-icon-wrap">
    <icon name="{{computedIcon}}" size="72" color="{{computedIconColor}}" />
  </view>
  <text class="empty-text">{{text || computedText}}</text>
  <text wx:if="{{subText}}" class="empty-sub-text">{{subText}}</text>
  <view wx:if="{{actionText}}" class="empty-action" bind:tap="onAction">
    <text class="empty-action-text">{{actionText}}</text>
  </view>
</view>
