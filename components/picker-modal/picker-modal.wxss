/* picker-modal — 飞书风格底部选择器 */

.picker-modal {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: none;
  align-items: flex-end;
  z-index: 1000;
  animation: fadeIn 0.2s ease;
}
.picker-modal.show { display: flex; }

.picker-content {
  width: 100%;
  background: #FFFFFF;
  border-radius: 24rpx 24rpx 0 0;
  max-height: 70vh;
  overflow: hidden;
  animation: slideUp 0.3s ease;
}

.picker-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 32rpx 24rpx;
  border-bottom: 1rpx solid #EDEDEF;
}

.picker-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #2D2A26;
}

.picker-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #F6F4F0;
}
.picker-close:active { background: #EDEDEF; }

.picker-list { max-height: 50vh; }

.picker-item {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #F6F4F0;
}
.picker-item:last-child { border-bottom: none; }
.picker-item.active { background: #E8F0FE; }

.picker-item-label {
  flex: 1;
  font-size: 30rpx;
  color: #2D2A26;
}
.picker-item.active .picker-item-label {
  color: #4A8C5C;
  font-weight: 500;
}

.picker-empty {
  padding: 80rpx 32rpx;
  text-align: center;
  color: #948F89;
  font-size: 28rpx;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to   { opacity: 1; }
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to   { transform: translateY(0); }
}
