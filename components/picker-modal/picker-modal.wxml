<view class="picker-modal {{show ? 'show' : ''}}" catchtap="onMaskTap">
  <view class="picker-content" catchtap="onContentTap">
    <view class="picker-header">
      <text class="picker-title">{{title}}</text>
      <view class="picker-close" catchtap="onClose">
        <icon name="close" size="36" color="#8F959E" />
      </view>
    </view>
    <scroll-view class="picker-list" scroll-y>
      <view
        class="picker-item {{item.value === selectedValue ? 'active' : ''}}"
        wx:for="{{items}}"
        wx:key="value"
        data-value="{{item.value}}"
        data-index="{{index}}"
        catchtap="onSelect"
      >
        <icon wx:if="{{item.icon}}" name="{{item.icon}}" size="40" color="{{item.value === selectedValue ? '#3370FF' : '#646A73'}}" />
        <text class="picker-item-label" style="{{item.icon ? 'margin-left:20rpx' : ''}}">{{item.label}}</text>
        <icon wx:if="{{item.value === selectedValue}}" name="check" size="32" color="#3370FF" />
      </view>
    </scroll-view>
    <view class="picker-empty" wx:if="{{!items || items.length === 0}}">
      <text>暂无选项</text>
    </view>
  </view>
</view>
