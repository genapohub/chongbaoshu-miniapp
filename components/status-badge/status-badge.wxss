/* status-badge 组件样式 */
.badge {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  font-size: 20rpx;
  font-weight: 600;
  white-space: nowrap;
}

.badge-green {
  background: #D1FAE5;
  color: #059669;
}

.badge-orange {
  background: #FEF3C7;
  color: #D97706;
}

.badge-purple {
  background: #EDE9FE;
  color: #7C3AED;
}

.badge-red {
  background: #FEE2E2;
  color: #DC2626;
}

.badge-gray {
  background: #F3F4F6;
  color: #6B7280;
}
