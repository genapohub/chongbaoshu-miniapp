.share-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 24rpx rgba(0,0,0,0.08);
}

.sc-header {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: var(--green);
}
.sc-kennel-logo { width: 56rpx; height: 56rpx; border-radius: 12rpx; border: 2rpx solid #FFF; }
.sc-kennel-name { color: #FFF; font-size: 28rpx; font-weight: 600; margin-left: 16rpx; }

.sc-photo-wrap { width: 100%; height: 480rpx; background: #F6F4F0; }
.sc-photo { width: 100%; height: 100%; }
.sc-photo-placeholder { display: flex; align-items: center; justify-content: center; height: 100%; }

.sc-info { padding: 24rpx; }
.sc-name-row { display: flex; align-items: baseline; gap: 16rpx; }
.sc-name { font-size: 40rpx; font-weight: 700; color: #1A1A1A; }
.sc-breed { font-size: 26rpx; color: #8F959E; }

.sc-meta-row { display: flex; align-items: center; margin-top: 12rpx; gap: 12rpx; }
.sc-meta { font-size: 26rpx; color: #666; }
.sc-meta-divider { color: #E5E5E5; }
.sc-price { font-size: 32rpx; font-weight: 700; color: #E34D59; }

.sc-tags { display: flex; gap: 12rpx; padding: 0 24rpx 24rpx; }
.sc-tag { font-size: 24rpx; padding: 8rpx 16rpx; border-radius: 8rpx; }
.sc-tag-vaccine { background: #E8F5E9; color: #2BA471; }
.sc-tag-deworm { background: #FFF3E0; color: #E67E22; }

.sc-pedigree { padding: 0 24rpx 24rpx; }
.sc-pedigree-title { font-size: 26rpx; font-weight: 600; color: #4A8C5C; margin-bottom: 12rpx; }
.sc-pedigree-row { display: flex; flex-direction: column; gap: 8rpx; }
.sc-parent { font-size: 24rpx; color: #666; }

.sc-footer { padding: 24rpx; text-align: center; border-top: 1rpx solid #F0F0F0; }
.sc-footer-text { font-size: 24rpx; color: #B0B0B0; }

.sc-actions { display: flex; padding: 24rpx; gap: 16rpx; }
.sc-btn { flex: 1; height: 80rpx; border-radius: 12rpx; font-size: 28rpx; display: flex; align-items: center; justify-content: center; }
.sc-btn-save { background: #F6F4F0; color: #4A8C5C; }
.sc-btn-share { background: #4A8C5C; color: #FFF; }
