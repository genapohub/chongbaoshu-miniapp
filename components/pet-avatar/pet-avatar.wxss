/* pet-avatar 组件样式 */
.pet-avatar {
  flex-shrink: 0;
  background: #F3F4F6;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

/* 尺寸变体 */
.size-sm {
  width: 64rpx;
  height: 64rpx;
}

.size-md {
  width: 104rpx;
  height: 104rpx;
}

.size-lg {
  width: 112rpx;
  height: 112rpx;
}

.avatar-img {
  width: 100%;
  height: 100%;
  display: block;
}

.avatar-placeholder {
  font-size: 48rpx;
}
