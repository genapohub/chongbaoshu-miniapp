<!-- 宠物头像组件
  Properties:
    src    {String} - 图片 URL，为空时显示 emoji placeholder
    icon   {String} - placeholder 时显示的 emoji（如 🐕）
    size   {String} - 尺寸：sm(64rpx) / md(104rpx, 默认) / lg(112rpx)
    radius {String} - 圆角值，默认 '16rpx'
-->
<view class="pet-avatar size-{{size || 'md'}}" style="border-radius: {{radius || '16rpx'}}">
  <image
    wx:if="{{src && !imgFailed}}"
    src="{{src}}"
    mode="aspectFill"
    class="avatar-img"
    lazy-load
    style="border-radius: {{radius || '16rpx'}}"
    binderror="onImgError"
  />
  <view wx:else class="avatar-placeholder">{{icon || '🐾'}}</view>
</view>
