<!-- 宠物头像组件 (飞书风格)
  Properties:
    src    {String} - 图片 URL
    icon   {String} - placeholder 图标名称
    size   {String} - 尺寸：sm(64rpx) / md(104rpx) / lg(112rpx)
    radius {String} - 圆角，默认 16rpx
-->
<view class="pet-avatar size-{{size || 'md'}}" style="border-radius: {{radius || '16rpx'}}">
  <image
    wx:if="{{src && !imgFailed}}"
    src="{{src}}"
    mode="aspectFill"
    class="avatar-img"
    style="border-radius: {{radius || '16rpx'}}"
    lazy-load
    binderror="onImgError"
  />
  <view wx:else class="avatar-placeholder">
    <icon name="{{icon || 'paw'}}" size="{{placeholderSize}}" color="#8F959E" />
  </view>
</view>
