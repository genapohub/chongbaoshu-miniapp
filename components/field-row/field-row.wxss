/* field-row 组件样式 */
.field {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F3F4F6;
}

.field:last-child {
  border-bottom: none;
}

.field-label {
  font-size: 26rpx;
  color: #9CA3AF;
}

.field-value {
  font-size: 26rpx;
  font-weight: 500;
  color: #111827;
}
