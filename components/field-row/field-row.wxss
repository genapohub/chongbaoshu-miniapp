/* field-row — 飞书风格信息字段行 */

.field {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #F6F4F0;
}
.field:last-child { border-bottom: none; }

.field-label {
  font-size: 28rpx;
  color: #948F89;
  flex-shrink: 0;
  margin-right: 24rpx;
}

.field-value {
  font-size: 28rpx;
  font-weight: 500;
  color: #2D2A26;
  text-align: right;
  word-break: break-all;
}
